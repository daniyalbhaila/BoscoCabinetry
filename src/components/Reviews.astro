---
import SectionWrapper from './SectionWrapper.astro';
import SectionHeader from './SectionHeader.astro';
import ContentGrid from './ContentGrid.astro';
import Star from './icons/Star.astro';
import { companyInfo } from '../content/shared.ts';
import Button from './ui/Button.astro';

interface Review {
	name: string;
	rating: number;
	description: string;
	project?: string;
	verified?: boolean;
}

// Sample strong Google reviews - these should be replaced with actual reviews
const reviews: Review[] = [
	{
		name: "Sarah Chen",
		rating: 5,
		description: "Absolutely blown away by the quality and attention to detail. Our kitchen transformation exceeded all expectations. The team was professional, on time, and the final result is stunning. Worth every penny!",
		project: "Kitchen Renovation",
		verified: true
	},
	{
		name: "Michael Rodriguez",
		rating: 5,
		description: "From design to installation, Bosco Cabinetry delivered premium quality at a reasonable price. Their showroom helped us visualize our dream closet perfectly. Highly recommend!",
		project: "Walk-in Closet",
		verified: true
	},
	{
		name: "Jennifer Park",
		rating: 5,
		description: "The entire process was seamless. Great communication, transparent pricing, and beautiful results. Our built-in media wall is the centerpiece of our living room now.",
		project: "Built-in Media Wall",
		verified: true
	},
	{
		name: "David Thompson",
		rating: 5,
		description: "20+ years of experience really shows. The craftsmanship is exceptional and the team handled our complex project with expertise. Would definitely work with them again.",
		project: "Full Home Renovation",
		verified: true
	}
];
---
<SectionWrapper theme="dark" fullHeight={true} id="reviews">
	<SectionHeader
		tag="Client Reviews"
		title="What Our Clients Say"
		description="Don't just take our word for it. Here's what our satisfied clients have to say about their Bosco experience."
		layout="center"
		theme="dark"
	/>

	<ContentGrid
		items={reviews}
		variant="reviews"
	/>

	<!-- Google Reviews CTA -->
	<div class="mt-16 text-center">
		<div class="inline-flex items-center gap-4 rounded-2xl border border-white/20 gradient-card-dark p-6 shadow-lg">
			<div class="flex items-center gap-2">
				<Star class="h-6 w-6 text-brand-accent" fill="currentColor" />
				<div>
					<p class="text-lg font-semibold text-white">{companyInfo.stats.googleRating} on Google</p>
					<p class="text-sm text-white/70">{companyInfo.stats.googleReviews}</p>
				</div>
			</div>
			<Button
				href={companyInfo.urls.googleReviews}
				target="_blank"
				rel="noopener noreferrer"
				variant="ghost"
				size="sm"
			>
				See More on Google
			</Button>
		</div>
	</div>
</SectionWrapper>