---
import SectionWrapper from './SectionWrapper.astro';
import SectionHeader from './SectionHeader.astro';
import Star from './icons/Star.astro';
import ChevronLeft from './icons/ChevronLeft.astro';
import ChevronRight from './icons/ChevronRight.astro';
import { companyInfo } from '../content/shared.ts';
import Button from './ui/Button.astro';
import { getThemeClasses, type Theme } from '../lib/themeUtils';

interface Review {
	name: string;
	rating: number;
	description: string;
	project?: string;
	verified?: boolean;
}

export interface Props {
	theme?: Theme;
	tag?: string;
	title?: string;
	description?: string;
	reviews?: Review[];
}

const {
	theme = 'dark',
	tag = 'Client Reviews',
	title = 'What Our Clients Say',
	description = "Don't just take our word for it. Here's what our satisfied clients have to say about their Bosco experience.",
	reviews = [
		{
			name: "Sarah Chen",
			rating: 5,
			description: "Absolutely blown away by the quality and attention to detail. Our kitchen transformation exceeded all expectations. The team was professional, on time, and the final result is stunning. Worth every penny!",
			project: "Kitchen Renovation",
			verified: true
		},
		{
			name: "Michael Rodriguez",
			rating: 5,
			description: "From design to installation, Bosco Cabinetry delivered premium quality at a reasonable price. Their showroom helped us visualize our dream closet perfectly. Highly recommend!",
			project: "Walk-in Closet",
			verified: true
		},
		{
			name: "Jennifer Park",
			rating: 5,
			description: "The entire process was seamless. Great communication, transparent pricing, and beautiful results. Our built-in media wall is the centerpiece of our living room now.",
			project: "Built-in Media Wall",
			verified: true
		},
		{
			name: "David Thompson",
			rating: 5,
			description: "20+ years of experience really shows. The craftsmanship is exceptional and the team handled our complex project with expertise. Would definitely work with them again.",
			project: "Full Home Renovation",
			verified: true
		},
		{
			name: "Lisa Williams",
			rating: 5,
			description: "The design consultation was thorough and the installation team was incredibly professional. Our new bathroom vanity is exactly what we envisioned. Great value for the quality received.",
			project: "Bathroom Vanity",
			verified: true
		},
		{
			name: "Robert Kim",
			rating: 5,
			description: "Outstanding service from start to finish. The team accommodated all our requests and delivered ahead of schedule. The pantry organization system has transformed our kitchen storage.",
			project: "Pantry Organization",
			verified: true
		}
	]
} = Astro.props;

// Get theme classes from centralized utilities
const classes = getThemeClasses(theme);
---
<SectionWrapper theme={theme} id="reviews" className={`reviews-section-${theme}`}>
	<SectionHeader
		tag={tag}
		title={title}
		description={description}
		layout="center"
		theme={theme}
	/>

	<!-- Reviews Carousel -->
	<div class="max-w-7xl mx-auto">
		<!-- Carousel with Side Navigation Layout -->
		<div class="hidden md:flex items-center gap-6">
			<!-- Left Navigation Button -->
			<button
				class={`carousel-prev flex-shrink-0 backdrop-blur-sm border rounded-full p-3 transition-all duration-200 ${classes.navButton}`}
				aria-label="Previous reviews"
			>
				<ChevronLeft class="h-6 w-6" />
			</button>

			<!-- Carousel Container -->
			<div class="flex-1 reviews-carousel overflow-hidden">
				<div class="reviews-track flex transition-transform duration-500 ease-in-out">
					{reviews.map((review, index) => (
						<div class="review-slide flex-none w-1/3 px-4">
							<div class={`${classes.reviewCard} rounded-2xl p-6 h-full`}>
								<!-- Rating Stars -->
								<div class="flex items-center gap-1 mb-4">
									{Array.from({ length: review.rating }, (_, i) => (
										<Star class="h-5 w-5 text-brand-accent" fill="currentColor" />
									))}
								</div>

								<!-- Review Text -->
								<blockquote class={`${classes.body} mb-6 italic`}>
									"{review.description}"
								</blockquote>

								<!-- Reviewer Info -->
								<div class="flex items-center justify-between">
									<div>
										<cite class={`${classes.heading} font-semibold not-italic`}>{review.name}</cite>
										{review.project && (
											<p class={`text-sm ${classes.muted}`}>{review.project}</p>
										)}
									</div>
									{review.verified && (
										<span class="text-xs text-brand-accent/70 bg-brand-accent/10 px-2 py-1 rounded">
											Verified
										</span>
									)}
								</div>
							</div>
						</div>
					))}
				</div>
			</div>

			<!-- Right Navigation Button -->
			<button
				class={`carousel-next flex-shrink-0 backdrop-blur-sm border rounded-full p-3 transition-all duration-200 ${classes.navButton}`}
				aria-label="Next reviews"
			>
				<ChevronRight class="h-6 w-6" />
			</button>
		</div>

		<!-- Mobile Layout (No Navigation Buttons - Swipe Only) -->
		<div class="md:hidden -mx-6">
			<div class="reviews-carousel overflow-hidden relative">
				<div class="reviews-track flex transition-transform duration-500 ease-in-out">
					{reviews.map((review, index) => (
						<div class="review-slide flex-none w-full">
							<div class={`${classes.reviewCard} rounded-2xl p-6 h-full mx-6`}>
								<!-- Rating Stars -->
								<div class="flex items-center gap-1 mb-4">
									{Array.from({ length: review.rating }, (_, i) => (
										<Star class="h-5 w-5 text-brand-accent" fill="currentColor" />
									))}
								</div>

								<!-- Review Text -->
								<blockquote class={`${classes.body} mb-6 italic`}>
									"{review.description}"
								</blockquote>

								<!-- Reviewer Info -->
								<div class="flex items-center justify-between">
									<div>
										<cite class={`${classes.heading} font-semibold not-italic`}>{review.name}</cite>
										{review.project && (
											<p class={`text-sm ${classes.muted}`}>{review.project}</p>
										)}
									</div>
									{review.verified && (
										<span class="text-xs text-brand-accent/70 bg-brand-accent/10 px-2 py-1 rounded">
											Verified
										</span>
									)}
								</div>
							</div>
						</div>
					))}
				</div>

				<!-- Swipe Indicator -->
				<div class="absolute bottom-4 right-10 pointer-events-none">
					<div class="flex items-center gap-1 text-white/50 text-xs">
						<span>Swipe</span>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
						</svg>
					</div>
				</div>
			</div>

			<!-- Dots Indicator -->
			<div class="flex justify-center mt-6 gap-2">
				{reviews.map((_, index) => (
					<button
						class="mobile-dot w-2 h-2 rounded-full transition-colors duration-200"
						data-slide={index}
						aria-label={`Go to review ${index + 1}`}
					></button>
				))}
			</div>
		</div>

	</div>

	<!-- Google Reviews CTA -->
	<div class="mt-16 text-center">
		<div class={`inline-flex items-center gap-4 rounded-2xl border ${classes.card} p-6 shadow-lg`}>
			<div class="flex items-center gap-2">
				<Star class="h-6 w-6 text-brand-accent" fill="currentColor" />
				<div>
					<p class={`text-lg font-semibold ${classes.heading}`}>{companyInfo.stats.googleRating} on Google</p>
					<p class={`text-sm ${classes.muted}`}>{companyInfo.stats.googleReviews}</p>
				</div>
			</div>
			<Button
				href={companyInfo.urls.googleReviews}
				target="_blank"
				rel="noopener noreferrer"
				variant="ghost"
				size="sm"
			>
				See More on Google
			</Button>
		</div>
	</div>
</SectionWrapper>

<script>
	class ReviewsCarousel {
		constructor() {
			this.currentSlide = 0;
			this.slidesPerView = window.innerWidth >= 768 ? 3 : 1;
			this.totalSlides = Math.ceil(document.querySelectorAll('.review-slide').length / this.slidesPerView);

			// Get active track based on screen size
			this.track = this.getActiveTrack();
			this.prevBtn = document.querySelector('.carousel-prev');
			this.nextBtn = document.querySelector('.carousel-next');

			this.init();
		}

		getActiveTrack() {
			// Return the visible track based on screen size
			const desktopTrack = document.querySelector('.hidden.md\\:flex .reviews-track');
			const mobileTrack = document.querySelector('.md\\:hidden .reviews-track');

			if (window.innerWidth >= 768) {
				return desktopTrack;
			} else {
				return mobileTrack;
			}
		}

		init() {
			this.updateCarousel();
			this.bindEvents();
			this.handleResize();
		}

		bindEvents() {
			this.prevBtn?.addEventListener('click', () => this.prevSlide());
			this.nextBtn?.addEventListener('click', () => this.nextSlide());

			// Touch/swipe support for both tracks
			this.addTouchSupport(document.querySelector('.hidden.md\\:flex .reviews-track'));
			this.addTouchSupport(document.querySelector('.md\\:hidden .reviews-track'));

			// Mobile dots navigation
			document.querySelectorAll('.mobile-dot').forEach((dot, index) => {
				dot.addEventListener('click', () => this.goToSlide(index));
			});

			// Keyboard support
			document.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowLeft') this.prevSlide();
				if (e.key === 'ArrowRight') this.nextSlide();
			});
		}

		addTouchSupport(track) {
			if (!track) return;

			let startX = 0;
			let endX = 0;

			track.addEventListener('touchstart', (e) => {
				startX = e.touches[0].clientX;
			});

			track.addEventListener('touchend', (e) => {
				endX = e.changedTouches[0].clientX;
				this.handleSwipe(startX, endX);
			});
		}

		handleResize() {
			window.addEventListener('resize', () => {
				const newSlidesPerView = window.innerWidth >= 768 ? 3 : 1;
				if (newSlidesPerView !== this.slidesPerView) {
					this.slidesPerView = newSlidesPerView;
					this.totalSlides = Math.ceil(document.querySelectorAll('.review-slide').length / this.slidesPerView);
					this.currentSlide = Math.min(this.currentSlide, this.totalSlides - 1);
					this.track = this.getActiveTrack();
					this.updateCarousel();
				}
			});
		}

		handleSwipe(startX, endX) {
			const threshold = 50;
			const diff = startX - endX;

			if (Math.abs(diff) > threshold) {
				if (diff > 0) {
					this.nextSlide();
				} else {
					this.prevSlide();
				}
			}
		}

		prevSlide() {
			this.currentSlide = this.currentSlide > 0 ? this.currentSlide - 1 : this.totalSlides - 1;
			this.updateCarousel();
		}

		nextSlide() {
			this.currentSlide = this.currentSlide < this.totalSlides - 1 ? this.currentSlide + 1 : 0;
			this.updateCarousel();
		}

		goToSlide(slideIndex) {
			this.currentSlide = slideIndex;
			this.updateCarousel();
		}

		updateCarousel() {
			// Update both tracks to keep them in sync
			const desktopTrack = document.querySelector('.hidden.md\\:flex .reviews-track');
			const mobileTrack = document.querySelector('.md\\:hidden .reviews-track');

			const translateX = -this.currentSlide * (100 / this.slidesPerView);

			if (desktopTrack) {
				desktopTrack.style.transform = `translateX(${translateX}%)`;
			}
			if (mobileTrack) {
				mobileTrack.style.transform = `translateX(${translateX}%)`;
			}

			// Update mobile dots
			this.updateDots();
		}

		updateDots() {
			const isLightTheme = document.querySelector('#reviews').classList.contains('reviews-section-light');
			const inactiveColor = isLightTheme ? 'bg-brand-darkGray/30' : 'bg-white/30';

			document.querySelectorAll('.mobile-dot').forEach((dot, index) => {
				if (index === this.currentSlide) {
					dot.className = 'mobile-dot w-2 h-2 rounded-full transition-colors duration-200 bg-brand-accent';
				} else {
					dot.className = `mobile-dot w-2 h-2 rounded-full transition-colors duration-200 ${inactiveColor}`;
				}
			});
		}
	}

	// Initialize carousel when DOM is loaded
	document.addEventListener('DOMContentLoaded', () => {
		new ReviewsCarousel();
	});
</script>