---
import SectionWrapper from './SectionWrapper.astro';
import SectionHeader from './SectionHeader.astro';
import AnimatedSection from './AnimatedSection.astro';
import Star from './icons/Star.astro';
import ChevronLeft from './icons/ChevronLeft.astro';
import ChevronRight from './icons/ChevronRight.astro';
import { companyInfo } from '../content/shared.ts';
import Button from './ui/Button.astro';
import { getThemeClasses, type Theme } from '../lib/themeUtils';

interface Review {
	name: string;
	rating: number;
	description: string;
	project?: string;
	verified?: boolean;
}

export interface Props {
	theme?: Theme;
	tag?: string;
	title?: string;
	description?: string;
	reviews?: Review[];
}

const {
	theme = 'dark',
	tag = 'Client Reviews',
	title = 'What Our Clients Say',
	description = "Don't just take our word for it. Here's what our satisfied clients have to say about their Bosco Cabinetry experience.",
	reviews = [
		{
			name: "Anthony O.",
			rating: 5,
			description: "Fantastic work, got some cabinets from the galaxy 2 set installed in my kitchen recently and they've been wonderful, big thanks to the team at Bosco. Was very affordable and the team were extremely helpful during my consultation and follow up. I would gladly have cabinets installed by them again should I ever move or decide to redecorate.",
			project: "Kitchen Cabinets",
			verified: true
		},
		{
			name: "Asif L.",
			rating: 5,
			description: "I recently hired BOSCO Cabinetry to design and install custom cabinets for my kitchen, and I couldn't be happier. The craftsmanship is top-notch, the materials feel premium, and every detail—from the hinges to the finish—was handled with care. The team was professional, punctual, and easy to communicate with throughout the whole process.",
			project: "Kitchen Cabinets",
			verified: true
		},
		{
			name: "Nida A.",
			rating: 5,
			description: "I came across bosco cabinetry through an ad and got to say a stroke of luck! I undertook the kitchen as my first reno project & decided to get a quotation. What sets the team apart is that they are truly willing to work with you to bring your vision to life. The team was a pleasure to work with, very thorough in the assessment & always made it a point to keep me updated about the progress.",
			project: "Kitchen Renovation",
			verified: true
		},
		{
			name: "Ireoluwa A.",
			rating: 5,
			description: "The team did a great job starting with extensive consultation to ensure the design captures what we truly want. The execution was done in line with design. Very happy with the work overall.",
			project: "Custom Cabinetry",
			verified: true
		},
		{
			name: "Zoha S.",
			rating: 5,
			description: "I couldn't be happier with my experience with Bosco Kitchens and Cabinetry! We were worried about a lack of communication from the team, which has been an issue with other companies in the past, but the associates were incredibly helpful and professional every step of the way. The craftsmanship and quality of their work were outstanding—everything turned out exactly as I envisioned, if not better.",
			project: "Kitchen Cabinets",
			verified: true
		},
		{
			name: "Nabeeha K.",
			rating: 5,
			description: "I had a fantastic experience with Bosco Cabinets! They were incredibly professional and friendly throughout the entire process. I got my bedroom closet done by them, and from the first consultation to the final touches, their team made sure everything was done perfectly and on time. The quality of their work truly stands out.",
			project: "Bedroom Closet",
			verified: true
		}
	]
} = Astro.props;

// Get theme classes from centralized utilities
const classes = getThemeClasses(theme);
---
<SectionWrapper theme={theme} id="reviews" className={`reviews-section-${theme}`}>
	<SectionHeader
		tag={tag}
		title={title}
		description={description}
		layout="center"
		theme={theme}
	/>

	<!-- Reviews Carousel -->
	<AnimatedSection className="max-w-7xl mx-auto">
		<!-- Carousel with Side Navigation Layout -->
		<div class="hidden md:flex items-center gap-6">
			<!-- Left Navigation Button -->
			<button
				class={`carousel-prev flex-shrink-0 backdrop-blur-sm border rounded-full p-3 transition-all duration-200 ${classes.navButton}`}
				aria-label="Previous reviews"
			>
				<ChevronLeft class="h-6 w-6" />
			</button>

			<!-- Carousel Container -->
			<div class="flex-1 reviews-carousel overflow-hidden">
				<div class="reviews-track flex transition-transform duration-500 ease-in-out">
					{reviews.map((review, index) => (
						<div class="review-slide flex-none w-1/3 px-4">
							<div class={`${classes.reviewCard} rounded-2xl p-6 h-full flex flex-col`}>
								<!-- Rating Stars -->
								<div class="flex items-center gap-1 mb-4">
									{Array.from({ length: review.rating }, (_, i) => (
										<Star class="h-5 w-5 text-brand-accent" fill="currentColor" />
									))}
								</div>

								<!-- Review Text -->
								<blockquote class={`${classes.body} mb-6 italic flex-grow`}>
									"{review.description}"
								</blockquote>

								<!-- Reviewer Info -->
								<div class="flex items-center justify-between mt-auto">
									<div>
										<cite class={`${classes.heading} font-semibold not-italic`}>{review.name}</cite>
										{review.project && (
											<p class={`text-sm ${classes.muted}`}>{review.project}</p>
										)}
									</div>
									{review.verified && (
										<span class="text-xs text-brand-accent/70 bg-brand-accent/10 px-2 py-1 rounded">
											Verified
										</span>
									)}
								</div>
							</div>
						</div>
					))}
				</div>
			</div>

			<!-- Right Navigation Button -->
			<button
				class={`carousel-next flex-shrink-0 backdrop-blur-sm border rounded-full p-3 transition-all duration-200 ${classes.navButton}`}
				aria-label="Next reviews"
			>
				<ChevronRight class="h-6 w-6" />
			</button>
		</div>

		<!-- Mobile Layout (No Navigation Buttons - Swipe Only) -->
		<div class="md:hidden -mx-6">
			<div class="reviews-carousel overflow-hidden relative">
				<div class="reviews-track flex transition-transform duration-500 ease-in-out">
					{reviews.map((review, index) => (
						<div class="review-slide flex-none w-full">
							<div class={`${classes.reviewCard} rounded-2xl p-6 h-full mx-6 flex flex-col`}>
								<!-- Rating Stars -->
								<div class="flex items-center gap-1 mb-4">
									{Array.from({ length: review.rating }, (_, i) => (
										<Star class="h-5 w-5 text-brand-accent" fill="currentColor" />
									))}
								</div>

								<!-- Review Text -->
								<blockquote class={`${classes.body} mb-6 italic flex-grow`}>
									"{review.description}"
								</blockquote>

								<!-- Reviewer Info -->
								<div class="flex items-center justify-between mt-auto">
									<div>
										<cite class={`${classes.heading} font-semibold not-italic`}>{review.name}</cite>
										{review.project && (
											<p class={`text-sm ${classes.muted}`}>{review.project}</p>
										)}
									</div>
									{review.verified && (
										<span class="text-xs text-brand-accent/70 bg-brand-accent/10 px-2 py-1 rounded">
											Verified
										</span>
									)}
								</div>
							</div>
						</div>
					))}
				</div>

				<!-- Swipe Indicator -->
				<div class="absolute bottom-4 right-10 pointer-events-none">
					<div class="flex items-center gap-1 text-white/50 text-xs">
						<span>Swipe</span>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
						</svg>
					</div>
				</div>
			</div>

			<!-- Dots Indicator -->
			<div class="flex justify-center mt-6 gap-2">
				{reviews.map((_, index) => (
					<button
						class="mobile-dot w-2 h-2 rounded-full transition-colors duration-200"
						data-slide={index}
						aria-label={`Go to review ${index + 1}`}
					></button>
				))}
			</div>
		</div>

	</AnimatedSection>

	<!-- Google Reviews CTA -->
	<AnimatedSection className="mt-16 text-center">
		<div class={`inline-flex items-center gap-4 rounded-2xl border ${classes.card} p-6 shadow-lg`}>
			<div class="flex items-center gap-2">
				<Star class="h-6 w-6 text-brand-accent" fill="currentColor" />
				<p class={`text-lg font-semibold ${classes.heading}`}>Read Our Google Reviews</p>
			</div>
			<Button
				href={companyInfo.urls.googleReviews}
				target="_blank"
				rel="noopener noreferrer"
				variant="ghost"
				size="sm"
			>
				View on Google
			</Button>
		</div>
	</AnimatedSection>
</SectionWrapper>

<script>
	class ReviewsCarousel {
		constructor() {
			this.currentSlide = 0;
			this.slidesPerView = window.innerWidth >= 768 ? 3 : 1;
			this.totalSlides = Math.ceil(document.querySelectorAll('.review-slide').length / this.slidesPerView);

			// Get active track based on screen size
			this.track = this.getActiveTrack();
			this.prevBtn = document.querySelector('.carousel-prev');
			this.nextBtn = document.querySelector('.carousel-next');

			this.init();
		}

		getActiveTrack() {
			// Return the visible track based on screen size
			const desktopTrack = document.querySelector('.hidden.md\\:flex .reviews-track');
			const mobileTrack = document.querySelector('.md\\:hidden .reviews-track');

			if (window.innerWidth >= 768) {
				return desktopTrack;
			} else {
				return mobileTrack;
			}
		}

		init() {
			this.updateCarousel();
			this.bindEvents();
			this.handleResize();
		}

		bindEvents() {
			this.prevBtn?.addEventListener('click', () => this.prevSlide());
			this.nextBtn?.addEventListener('click', () => this.nextSlide());

			// Touch/swipe support for both tracks
			this.addTouchSupport(document.querySelector('.hidden.md\\:flex .reviews-track'));
			this.addTouchSupport(document.querySelector('.md\\:hidden .reviews-track'));

			// Mobile dots navigation
			document.querySelectorAll('.mobile-dot').forEach((dot, index) => {
				dot.addEventListener('click', () => this.goToSlide(index));
			});

			// Keyboard support
			document.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowLeft') this.prevSlide();
				if (e.key === 'ArrowRight') this.nextSlide();
			});
		}

		addTouchSupport(track) {
			if (!track) return;

			let startX = 0;
			let endX = 0;

			track.addEventListener('touchstart', (e) => {
				startX = e.touches[0].clientX;
			});

			track.addEventListener('touchend', (e) => {
				endX = e.changedTouches[0].clientX;
				this.handleSwipe(startX, endX);
			});
		}

		handleResize() {
			window.addEventListener('resize', () => {
				const newSlidesPerView = window.innerWidth >= 768 ? 3 : 1;
				if (newSlidesPerView !== this.slidesPerView) {
					this.slidesPerView = newSlidesPerView;
					this.totalSlides = Math.ceil(document.querySelectorAll('.review-slide').length / this.slidesPerView);
					this.currentSlide = Math.min(this.currentSlide, this.totalSlides - 1);
					this.track = this.getActiveTrack();
					this.updateCarousel();
				}
			});
		}

		handleSwipe(startX, endX) {
			const threshold = 50;
			const diff = startX - endX;

			if (Math.abs(diff) > threshold) {
				if (diff > 0) {
					this.nextSlide();
				} else {
					this.prevSlide();
				}
			}
		}

		prevSlide() {
			this.currentSlide = this.currentSlide > 0 ? this.currentSlide - 1 : this.totalSlides - 1;
			this.updateCarousel();
		}

		nextSlide() {
			this.currentSlide = this.currentSlide < this.totalSlides - 1 ? this.currentSlide + 1 : 0;
			this.updateCarousel();
		}

		goToSlide(slideIndex) {
			this.currentSlide = slideIndex;
			this.updateCarousel();
		}

		updateCarousel() {
			// Update both tracks to keep them in sync
			const desktopTrack = document.querySelector('.hidden.md\\:flex .reviews-track');
			const mobileTrack = document.querySelector('.md\\:hidden .reviews-track');

			const translateX = -this.currentSlide * (100 / this.slidesPerView);

			if (desktopTrack) {
				desktopTrack.style.transform = `translateX(${translateX}%)`;
			}
			if (mobileTrack) {
				mobileTrack.style.transform = `translateX(${translateX}%)`;
			}

			// Update mobile dots
			this.updateDots();
		}

		updateDots() {
			const isLightTheme = document.querySelector('#reviews').classList.contains('reviews-section-light');
			const inactiveColor = isLightTheme ? 'bg-brand-darkGray/30' : 'bg-white/30';

			document.querySelectorAll('.mobile-dot').forEach((dot, index) => {
				if (index === this.currentSlide) {
					dot.className = 'mobile-dot w-2 h-2 rounded-full transition-colors duration-200 bg-brand-accent';
				} else {
					dot.className = `mobile-dot w-2 h-2 rounded-full transition-colors duration-200 ${inactiveColor}`;
				}
			});
		}
	}

	// Initialize carousel when DOM is loaded
	document.addEventListener('DOMContentLoaded', () => {
		new ReviewsCarousel();
	});
</script>