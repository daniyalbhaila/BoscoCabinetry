---
import SectionWrapper from './SectionWrapper.astro';
import SectionHeader from './SectionHeader.astro';
import AnimatedSection from './AnimatedSection.astro';
import Phone from './icons/Phone.astro';
import Mail from './icons/Mail.astro';
import MapPin from './icons/MapPin.astro';
import Clock from './icons/Clock.astro';
import { companyInfo, companyDescriptions } from '../content/shared.ts';
import Button from './ui/Button.astro';
import GoogleMap from './GoogleMap.astro';
import { ANIMATION_DELAYS } from '../lib/animationConstants';
---

<SectionWrapper theme="dark" id="contact">
	<SectionHeader
		tag="Contact Us"
		title="Ready to Transform Your Space?"
		description={companyDescriptions.contact}
		layout="center"
		theme="dark"
	/>

	<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start max-w-[1200px] mx-auto">
			<!-- Contact Form -->
			<AnimatedSection stagger={ANIMATION_DELAYS.NORMAL}>
				<div class="contact-form gradient-card-dark-strong backdrop-blur-sm border border-brand-primary/20 rounded-2xl p-8">
					<h3 class="text-xl font-semibold text-white mb-2">Get in Touch</h3>
					<p class="text-white/60 text-sm mb-6">Tell us about your project and we'll get back to you within 24 hours.</p>

				<form
					name="contact"
					method="POST"
					action="/thank-you"
					data-netlify="true"
					netlify-honeypot="bot-field"
					class="space-y-5"
				>
					<!-- Required hidden fields for Netlify Forms -->
					<input type="hidden" name="form-name" value="contact" />

					<!-- Honeypot field for spam protection -->
					<p class="hidden">
						<label>
							Don't fill this out if you're human:
							<input name="bot-field" tabindex="-1" autocomplete="off" />
						</label>
					</p>

					<div>
						<label for="name" class="form-label-dark">Name *</label>
						<input
							type="text"
							id="name"
							name="name"
							required
							class="form-input-dark"
							placeholder="Your name"
						>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div>
							<label for="email" class="form-label-dark">Email *</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								class="form-input-dark"
								placeholder="your@email.com"
							>
						</div>
						<div>
							<label for="phone" class="form-label-dark">Phone *</label>
							<input
								type="tel"
								id="phone"
								name="phone"
								required
								class="form-input-dark"
								placeholder={companyInfo.contact.phone.display}
							>
						</div>
					</div>
					<p class="text-xs text-white/50 -mt-2">We'll call to schedule your free consultation and answer any questions.</p>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div>
							<label for="projectType" class="form-label-dark">What are you interested in?</label>
							<select
								id="projectType"
								name="projectType"
								class="form-select-dark"
							>
								<option value="">Select a project type</option>
								<option value="kitchen">Kitchen Cabinets</option>
								<option value="closet">Closet Systems</option>
								<option value="bathroom">Bathroom Vanities</option>
								<option value="builtin">Built-in Units</option>
								<option value="full-home">Full Home Cabinetry</option>
								<option value="commercial">Commercial Project</option>
								<option value="not-sure">Not sure yet</option>
							</select>
						</div>
						<div>
							<label for="timeline" class="form-label-dark">When do you want to start?</label>
							<select
								id="timeline"
								name="timeline"
								class="form-select-dark"
							>
								<option value="">Select timeline</option>
								<option value="asap">ASAP</option>
								<option value="1-3months">1-3 months</option>
								<option value="3-6months">3-6 months</option>
								<option value="6-12months">6-12 months</option>
								<option value="12months+">12+ months</option>
								<option value="just-exploring">Just exploring</option>
							</select>
						</div>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div>
							<label for="city" class="form-label-dark">City / Area</label>
							<input
								type="text"
								id="city"
								name="city"
								class="form-input-dark"
								placeholder="e.g., Toronto, North York"
							>
						</div>
						<div>
							<label for="referralSource" class="form-label-dark">How did you hear about us?</label>
							<select
								id="referralSource"
								name="referralSource"
								class="form-select-dark"
							>
								<option value="">Select a source</option>
								<option value="google-search">Google Search</option>
								<option value="social-media">Social Media (Instagram/Facebook)</option>
								<option value="friend-referral">Friend or Family Referral</option>
								<option value="contractor-referral">Contractor/Designer Referral</option>
								<option value="previous-client">Previous Client</option>
								<option value="trade-show">Trade Show / Home Show</option>
								<option value="website">Found Your Website</option>
								<option value="driving-by">Drove Past Your Location</option>
								<option value="online-ad">Online Ad</option>
								<option value="review-site">Review Site (Google/Yelp/Houzz)</option>
								<option value="other">Other</option>
							</select>
						</div>
					</div>

					<div>
						<label for="message" class="form-label-dark">Tell us about your project</label>
						<textarea
							id="message"
							name="message"
							rows="3"
							class="form-textarea-dark"
							placeholder="Any details about style, budget, or specific requirements..."
						></textarea>
					</div>

					<Button
						type="submit"
						variant="primary"
						size="lg"
						class="w-full font-semibold"
					>
						Send Message
					</Button>

					<p class="text-xs text-white/40 text-center">We'll review your information and reach out to discuss your project in detail.</p>
				</form>
				</div>
			</AnimatedSection>

			<!-- Contact Info & Map -->
			<AnimatedSection stagger={ANIMATION_DELAYS.MEDIUM} className="space-y-8">
				<!-- Contact Details -->
				<div class="contact-info space-y-6">
					<div class="flex items-start gap-4">
						<div class="w-12 h-12 bg-brand-primary/20 rounded-full flex items-center justify-center flex-shrink-0">
							<Phone class="w-6 h-6 text-brand-primary" />
						</div>
						<div>
							<h4 class="text-lg font-semibold text-white mb-1">Call Us</h4>
							<a href={companyInfo.contact.phone.href} class="text-brand-primary hover:text-white transition-colors duration-200">
								{companyInfo.contact.phone.display}
							</a>
							<p class="text-sm text-white/60 mt-1">Free consultation available</p>
						</div>
					</div>

					<div class="flex items-start gap-4">
						<div class="w-12 h-12 bg-brand-primary/20 rounded-full flex items-center justify-center flex-shrink-0">
							<Mail class="w-6 h-6 text-brand-primary" />
						</div>
						<div>
							<h4 class="text-lg font-semibold text-white mb-1">Email Us</h4>
							<a href={companyInfo.contact.email.href} class="text-brand-primary hover:text-white transition-colors duration-200">
								{companyInfo.contact.email.address}
							</a>
							<p class="text-sm text-white/60 mt-1">Response {companyInfo.timelines.emailResponse}</p>
						</div>
					</div>

					<div class="flex items-start gap-4">
						<div class="w-12 h-12 bg-brand-primary/20 rounded-full flex items-center justify-center flex-shrink-0">
							<MapPin class="w-6 h-6 text-brand-primary" />
						</div>
						<div>
							<h4 class="text-lg font-semibold text-white mb-1">Visit Our Showroom</h4>
							<p class="text-white/80" set:html={companyInfo.location.address.display}>
							</p>
							<p class="text-sm text-white/60 mt-1">{companyInfo.location.showroom.size} showroom</p>
						</div>
					</div>

					<div class="flex items-start gap-4">
						<div class="w-12 h-12 bg-brand-primary/20 rounded-full flex items-center justify-center flex-shrink-0">
							<Clock class="w-6 h-6 text-brand-primary" />
						</div>
						<div>
							<h4 class="text-lg font-semibold text-white mb-1">Business Hours</h4>
							<div class="text-white/80 text-sm leading-relaxed">
								<p>{companyInfo.hours.display.weekdays}</p>
								<p>{companyInfo.hours.display.saturday}</p>
								<p>{companyInfo.hours.display.sunday}</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Interactive Google Map -->
				<div class="map-container">
					<GoogleMap
						lat={companyInfo.location.coordinates.lat}
						lng={companyInfo.location.coordinates.lng}
						zoom={companyInfo.location.coordinates.zoom}
						height="300px"
						businessName={companyInfo.name}
						address={companyInfo.location.address.display}
						className="border border-brand-primary/20"
					/>
				</div>
			</AnimatedSection>
	</div>
</SectionWrapper>

<style>
/* Contact Form Styling - Design System Compliant */
.contact-form {
	transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
}

.contact-form:hover {
	transform: translateY(-4px);
	box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
}

/* Form Input Styling */
input, select, textarea {
	transition: all 0.3s ease-in-out;
}

input:focus, select:focus, textarea:focus {
	background: rgba(255, 255, 255, 0.15);
	border-color: rgba(218, 210, 191, 0.5);
}

/* Touch target compliance */
input, select, textarea, button {
	min-height: 48px;
}

/* Contact Info Hover Effects */
.contact-info a {
	transition: color 0.3s ease-in-out;
}

/* Map Container Hover */
.map-container {
	transition: all 0.3s ease-in-out;
}

.map-container:hover {
	transform: translateY(-2px);
	box-shadow: 0 12px 24px rgba(218, 210, 191, 0.1);
}
</style>