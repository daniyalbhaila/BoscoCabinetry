---
import MapBackground from '../assets/map.png';
import { Image } from 'astro:assets';

interface Props {
	lat: number;
	lng: number;
	zoom?: number;
	height?: string;
	businessName?: string;
	address?: string;
	className?: string;
}

const {
	lat,
	lng,
	zoom = 15,
	height = "400px",
	businessName = "Business Location",
	address = "",
	className = ""
} = Astro.props;

// Generate Google Maps embed URL
const embedUrl = `https://www.google.com/maps/embed/v1/place?key=${import.meta.env.GOOGLE_MAPS_API_KEY || 'YOUR_API_KEY'}&q=${lat},${lng}&zoom=${zoom}`;

// Fallback: Direct Google Maps link
const directMapUrl = `https://maps.app.goo.gl/C6pw5ws9NRF8YitR8`;
---

<div class={`google-map-container ${className}`} style={`height: ${height}`}>
	{import.meta.env.GOOGLE_MAPS_API_KEY ? (
		<!-- Interactive Google Maps Embed -->
		<iframe
			src={embedUrl}
			width="100%"
			height="100%"
			style="border:0;"
			allowfullscreen=""
			loading="lazy"
			referrerpolicy="no-referrer-when-downgrade"
			title={`Map showing location of ${businessName}`}
			class="rounded-lg"
		></iframe>
	) : (
		<!-- Fallback: Clickable map screenshot that opens Google Maps -->
		<div class="map-fallback relative rounded-lg border border-brand-primary/20 h-full cursor-pointer transition-all duration-300 hover:border-brand-primary/40 overflow-hidden">
			<!-- Background Map Image -->
			<Image
				src={MapBackground}
				alt="Map showing location of B3 Interiors"
				class="w-full h-full object-cover"
				loading="lazy"
				decoding="async"
				sizes="100vw"
			/>

			<!-- Business info overlay (no gradient) -->
			<div class="absolute bottom-4 left-4 right-4 bg-white/95 rounded-lg p-4 shadow-lg backdrop-blur-sm border border-gray-200/50">
				<div class="flex items-center space-x-3">
					<!-- Black location pin -->
					<div class="w-10 h-10 bg-black rounded-full flex items-center justify-center flex-shrink-0">
						<svg class="w-5 h-5 text-white" fill="currentColor" stroke="none" viewBox="0 0 24 24">
							<path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
						</svg>
					</div>

					<!-- Business details -->
					<div class="flex-1 min-w-0">
						<h3 class="font-semibold text-gray-900 text-sm truncate">{businessName}</h3>
						{address && (
							<p class="text-gray-700 text-xs mt-1" set:html={address}></p>
						)}
					</div>

					<!-- Directions arrow -->
					<div class="flex-shrink-0">
						<div class="flex items-center text-gray-600 text-xs">
							<span class="hidden sm:inline mr-1">Directions</span>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
							</svg>
						</div>
					</div>
				</div>
			</div>
		</div>
	)}
</div>

{!import.meta.env.GOOGLE_MAPS_API_KEY && (
	<script define:vars={{ directMapUrl }}>
		document.addEventListener('DOMContentLoaded', function() {
			const mapFallback = document.querySelector('.map-fallback');
			if (mapFallback) {
				mapFallback.addEventListener('click', function() {
					window.open(directMapUrl, '_blank');
				});
			}
		});
	</script>
)}

<style>
.google-map-container {
	border-radius: 0.5rem;
	overflow: hidden;
	transition: all 0.3s ease-in-out;
}

.google-map-container:hover {
	transform: translateY(-2px);
	box-shadow: 0 12px 24px rgba(218, 210, 191, 0.15);
}

.map-fallback {
	transition: all 0.3s ease-in-out;
}

.map-fallback:hover {
	transform: translateY(-2px);
	box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
}

/* Removed hover effect since overlay is always visible now */

.map-fallback:active {
	transform: translateY(0);
}
</style>
