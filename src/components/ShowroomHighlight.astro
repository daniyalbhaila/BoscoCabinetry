---
// Showroom Highlight with 360° Virtual Tour
import Palette from './icons/Palette.astro';
import House from './icons/House.astro';
import Users from './icons/Users.astro';
import MapPin from './icons/MapPin.astro';
import Button from './ui/Button.astro';
import { Image } from 'astro:assets';
import showroomImage from '../assets/showroom.jpg';
---
<section id="showroom" class="relative isolate bg-brand-charcoal min-h-screen flex items-center">
	<div class="mx-auto max-w-7xl px-6 py-20 md:py-28">
		<!-- Header -->
		<div class="mx-auto max-w-4xl text-center mb-12">
			<p class="text-[11px] uppercase tracking-[0.2em] text-brand-primary/60 mb-4">[Virtual Showroom]</p>
			<h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl md:text-5xl mb-6">
				Explore Our 5,500 sq ft North York Showroom
			</h2>
			<p class="text-lg text-white/80">
				Walk through our space virtually, then come see it in person. Experience 100+ finishes and complete kitchen displays.
			</p>
		</div>

		<!-- Virtual Tour Container -->
		<div class="mx-auto max-w-6xl">
			<div class="relative overflow-hidden rounded-2xl border border-brand-darkGray/40 gradient-card-dark-strong shadow-xl">
				<div class="aspect-video w-full bg-white/10 relative overflow-hidden">
					<!-- Kuula 360° Tour Embed with Lazy Loading -->
					<div id="kuula-embed" class="h-full w-full rounded-2xl" role="application" aria-label="360° Virtual Showroom Tour">
						<!-- Lazy loading placeholder with background image -->
						<div id="kuula-placeholder" class="h-full w-full rounded-2xl flex items-center justify-center cursor-pointer group relative overflow-hidden">
							<!-- Background Image -->
							<div class="absolute inset-0">
								<Image
									src={showroomImage}
									alt="Bosco Cabinetry Showroom Interior"
									class="w-full h-full object-cover"
									widths={[400, 800, 1200]}
									sizes="(max-width: 768px) 400px, (max-width: 1200px) 800px, 1200px"
									loading="lazy"
								/>
								<!-- Dark overlay for text readability -->
								<div class="absolute inset-0 bg-black/50 group-hover:bg-black/40 transition-colors duration-300"></div>
							</div>

							<!-- Content overlay -->
							<div class="relative z-10 text-center">
								<div class="mb-4 opacity-90 group-hover:opacity-100 transition-opacity duration-300">
									<svg class="w-16 h-16 mx-auto text-white drop-shadow-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
									</svg>
								</div>
								<h3 class="text-xl font-semibold text-white mb-3 drop-shadow-lg">Load Virtual Showroom</h3>
								<p class="text-sm text-white/90 mb-6 leading-relaxed drop-shadow-md max-w-xs mx-auto">Click to explore our 5,500 sq ft showroom in 360°</p>
								<div class="inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-medium bg-brand-primary text-brand-charcoal shadow-lg hover:bg-brand-primary/90 hover:shadow-xl transition-all duration-200 transform hover:scale-105">
									<span class="whitespace-nowrap">Start Virtual Tour</span>
								</div>
							</div>
						</div>
						<!-- Actual iframe (loaded on intersection/click) -->
						<iframe
							id="kuula-iframe"
							data-src="https://kuula.co/share/collection/71zCg?logo=-1&info=0&fs=1&vr=1&zoom=1&autop=10&thumbs=2"
							title="Bosco Cabinetry 5,500 sq ft North York Showroom Virtual Tour - Interactive 360° Experience"
							width="100%"
							height="640"
							frameborder="0"
							allowfullscreen
							class="h-full w-full rounded-2xl focus:outline-none focus:ring-2 focus:ring-brand-primary hidden"
							tabindex="0"
							aria-label="Navigate the virtual showroom using arrow keys or mouse to explore our cabinet displays and finishes"
						>
							<p>Your browser does not support iframes. Please visit our showroom at our North York location to see our displays in person.</p>
						</iframe>
					</div>
				</div>
			</div>
		</div>

		<!-- Features Grid -->
		<div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-3">
			<div class="text-center">
				<div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-primary/10">
					<Palette class="h-6 w-6 text-brand-primary" />
				</div>
				<h3 class="mb-2 text-lg font-semibold text-white">100+ Finishes</h3>
				<p class="text-sm text-white/75">Explore our extensive collection of cabinet finishes and hardware options.</p>
			</div>
			<div class="text-center">
				<div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-primary/10">
					<House class="h-6 w-6 text-brand-primary" />
				</div>
				<h3 class="mb-2 text-lg font-semibold text-white">Complete Displays</h3>
				<p class="text-sm text-white/75">See full kitchen setups and built-in solutions in our showroom displays.</p>
			</div>
			<div class="text-center">
				<div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-primary/10">
					<Users class="h-6 w-6 text-brand-primary" />
				</div>
				<h3 class="mb-2 text-lg font-semibold text-white">Expert Consultation</h3>
				<p class="text-sm text-white/75">Meet with our design experts to plan your perfect custom solution.</p>
			</div>
		</div>

		<!-- Bottom CTA -->
		<div class="mt-16 text-center">
			<div class="mb-6">
				<p class="text-white/80 mb-6">Ready to see our showroom in person?</p>
				<Button href="#book-showroom" variant="primary" size="lg" class="mr-4">
					Book Your Showroom Tour
				</Button>
				<a href="#directions" class="inline-flex items-center gap-2 text-brand-primary hover:text-brand-primary/80 font-medium">
					<MapPin class="h-4 w-4" />
					Get Directions
				</a>
			</div>
		</div>
	</div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
	const kuulaPlaceholder = document.getElementById('kuula-placeholder');
	const kuulaIframe = document.getElementById('kuula-iframe');
	let kuulaLoaded = false;

	// Check if device is mobile
	function isMobile() {
		return window.innerWidth <= 768 || /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
	}

	// Get the virtual tour URL
	function getVirtualTourUrl() {
		return kuulaIframe ? kuulaIframe.getAttribute('data-src') : 'https://kuula.co/share/collection/71zCg?logo=-1&info=0&fs=1&vr=1&zoom=1&autop=10&thumbs=2';
	}

	function loadKuula() {
		if (!kuulaIframe || !kuulaPlaceholder) return;

		// On mobile: open in new tab instead of loading iframe
		if (isMobile()) {
			const tourUrl = getVirtualTourUrl();
			window.open(tourUrl, '_blank', 'noopener,noreferrer');
			return;
		}

		// On desktop: load iframe (YouTube-style behavior)
		if (kuulaLoaded) return;

		kuulaLoaded = true;
		const dataSrc = kuulaIframe.getAttribute('data-src');

		if (dataSrc) {
			kuulaIframe.src = dataSrc;
		}

		// Hide placeholder and show iframe
		kuulaPlaceholder.style.display = 'none';
		kuulaIframe.classList.remove('hidden');
		kuulaIframe.focus();
	}

	// Click to load (YouTube-style - only on click, no auto-load)
	if (kuulaPlaceholder) {
		kuulaPlaceholder.addEventListener('click', loadKuula);

		// Keyboard accessibility
		kuulaPlaceholder.addEventListener('keydown', function(e) {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				loadKuula();
			}
		});

		// Make placeholder focusable
		kuulaPlaceholder.setAttribute('tabindex', '0');
		kuulaPlaceholder.setAttribute('role', 'button');
		kuulaPlaceholder.setAttribute('aria-label', 'Load virtual showroom tour');

		// Update button text for mobile
		if (isMobile()) {
			const buttonElement = kuulaPlaceholder.querySelector('.inline-flex');
			if (buttonElement) {
				buttonElement.innerHTML = `
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
					</svg>
					Open Virtual Tour
				`;
			}
		}
	}

	// Remove auto-loading behavior - YouTube-style means click-only
	// No IntersectionObserver for auto-loading
});
</script>

<style>
/* Simple mobile adjustments */
@media (max-width: 768px) {
	#kuula-placeholder h3 {
		font-size: 1rem;
		margin-bottom: 0.5rem;
	}

	#kuula-placeholder p {
		font-size: 0.875rem;
		margin-bottom: 1rem;
		padding: 0 1rem;
	}

	#kuula-placeholder svg {
		width: 3rem;
		height: 3rem;
		margin-bottom: 0.75rem;
	}

	#kuula-placeholder .inline-flex {
		padding: 0.5rem 1rem;
		font-size: 0.875rem;
	}
}
</style>