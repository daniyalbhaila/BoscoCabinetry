---
// Featured Project with side-by-side layout
import { Image } from 'astro:assets';
import featuredProjectPoster from '../assets/hero-poster.png';
import Button from './ui/Button.astro';
import { getThemeClasses, type Theme } from '../lib/themeUtils';

export interface Props {
	theme?: Theme;
}

const { theme = 'dark' } = Astro.props;

// Get theme classes from centralized utilities
const classes = getThemeClasses(theme);
---
<section id="featured-project" class={`relative isolate ${classes.bg} min-h-screen flex items-center`}>
	<div class="mx-auto max-w-7xl px-6 py-20 md:py-28">
		<!-- Header -->
		<div class="mx-auto max-w-4xl text-center mb-16">
			<p class={`text-[11px] uppercase tracking-[0.2em] ${classes.small} mb-4`}>[Featured Project]</p>
			<h2 class={`text-3xl font-semibold tracking-tight ${classes.heading} sm:text-4xl md:text-5xl`}>
				Recent Renovation: Toronto Full Home Remodel
			</h2>
		</div>

		<!-- Side-by-Side Content -->
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
			<!-- Video Container -->
			<div class="order-2 lg:order-1">
				<div class="relative overflow-hidden rounded-2xl border border-brand-darkGray/40 gradient-card-light-subtle">
					<div class="aspect-video w-full" role="region" aria-label="Featured Project Video">
						<!-- YouTube Lazy Loading Facade -->
						<div id="youtube-facade" class="relative h-full w-full cursor-pointer group">
							<!-- Thumbnail -->
							<Image
								src={featuredProjectPoster}
								alt="Toronto Full Home Remodel Project Video Thumbnail"
								class="h-full w-full object-cover rounded-2xl"
								width={featuredProjectPoster.width}
								height={featuredProjectPoster.height}
								loading="lazy"
							/>
							<!-- Play Button Overlay -->
							<div class="absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/40 transition-colors rounded-2xl">
								<div class="bg-red-600 hover:bg-red-700 transition-colors rounded-full p-4 shadow-2xl">
									<svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
										<path d="M8 5v14l11-7z"/>
									</svg>
								</div>
							</div>
							<!-- Video Title -->
							<div class="absolute bottom-4 left-4 right-4">
								<p class="text-white font-medium text-sm bg-black/60 px-3 py-2 rounded backdrop-blur-sm">
									Toronto Full Home Remodel - Bosco Cabinetry
								</p>
							</div>
						</div>
						<!-- Actual iframe (hidden initially) -->
						<iframe
							id="youtube-iframe"
							width="100%"
							height="100%"
							data-src="https://www.youtube.com/embed/emMMuda6j1k?autoplay=1"
							title="Toronto Full Home Remodel Project Video - Complete Kitchen and Home Renovation by Bosco Cabinetry"
							frameborder="0"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							allowfullscreen
							class="h-full w-full rounded-2xl focus:outline-none focus:ring-2 focus:ring-white/50 hidden"
							tabindex="0"
							aria-label="Watch our complete home renovation project featuring custom kitchen cabinets, closets, and built-ins"
						>
							<p>Your browser does not support video embeds. You can <a href="https://www.youtube.com/watch?v=emMMuda6j1k" class="text-white underline hover:text-brand-accent">watch the video on YouTube</a> instead.</p>
						</iframe>
					</div>
				</div>
			</div>

			<!-- Project Description -->
			<div class="order-1 lg:order-2">
				<div class="space-y-6">
					<!-- Preview Text (Always Visible) -->
					<p class={`text-lg ${classes.body} leading-relaxed`}>
						This stunning Toronto home renovation showcases 2,100+ sq ft of expertly crafted custom kitchen cabinets and built-in storage solutions. Our team delivered a complete kitchen remodel featuring premium quartz countertops, custom cabinetry with undermount lighting, and a show-stopping double waterfall island that serves as the centerpiece of this modern family home.
					</p>

					<!-- Expandable Content -->
					<div id="expandable-content" class="hidden space-y-6">
						<p class={`text-lg ${classes.body} leading-relaxed`}>
							This full home renovation included custom built-in closets for every bedroom, creating seamless storage solutions that maximize space and functionality. Our custom millwork extends throughout the main living areas, including a bespoke feature wall with integrated electric fireplace and entertainment center, complemented by natural red oak hardwood flooring throughout.
						</p>

						<p class={`text-lg ${classes.body} leading-relaxed`}>
							From the versatile basement apartment kitchen renovation to sophisticated bathroom vanities and built-in storage throughout multiple levels, this project demonstrates our expertise in residential cabinetry and custom home renovations. Every detail reflects Bosco Cabinetry's commitment to quality craftsmanship and functional design that transforms houses into dream homes.
						</p>
					</div>

					<!-- Read More Button -->
					<button
						class="read-more-btn inline-flex items-center text-brand-accent hover:text-white transition-colors duration-200 font-medium"
						data-target="expandable-content"
					>
						<span class="read-more-text">Read More</span>
						<svg class="read-more-icon ml-1 w-4 h-4 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
						</svg>
					</button>

					<!-- CTA Button -->
					<div class="pt-4">
						<Button href="#portfolio" variant="primary" size="lg">
							View More Projects
							<svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</Button>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	document.addEventListener('DOMContentLoaded', function() {
		// Reusable read more functionality
		document.querySelectorAll('.read-more-btn').forEach(button => {
			button.addEventListener('click', function() {
				const targetId = this.getAttribute('data-target');
				const content = document.getElementById(targetId);
				const text = this.querySelector('.read-more-text');
				const icon = this.querySelector('.read-more-icon');

				if (content && content.classList.contains('hidden')) {
					// Show content
					content.classList.remove('hidden');
					text.textContent = 'Read Less';
					icon.classList.add('rotate-180');
				} else if (content) {
					// Hide content
					content.classList.add('hidden');
					text.textContent = 'Read More';
					icon.classList.remove('rotate-180');
				}
			});
		});

		// YouTube lazy loading facade
		const youtubeFacade = document.getElementById('youtube-facade');
		const youtubeIframe = document.getElementById('youtube-iframe');

		if (youtubeFacade && youtubeIframe) {
			youtubeFacade.addEventListener('click', function() {
				// Set the iframe src to start loading YouTube
				const dataSrc = youtubeIframe.getAttribute('data-src');
				if (dataSrc) {
					youtubeIframe.src = dataSrc;
				}

				// Hide facade and show iframe
				youtubeFacade.style.display = 'none';
				youtubeIframe.classList.remove('hidden');
				youtubeIframe.focus();
			});

			// Keyboard accessibility
			youtubeFacade.addEventListener('keydown', function(e) {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					youtubeFacade.click();
				}
			});

			// Make facade focusable
			youtubeFacade.setAttribute('tabindex', '0');
			youtubeFacade.setAttribute('role', 'button');
			youtubeFacade.setAttribute('aria-label', 'Load and play video: Toronto Full Home Remodel');
		}
	});
</script>
