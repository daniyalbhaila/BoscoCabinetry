---
import SectionWrapper from './SectionWrapper.astro';
import SectionHeader from './SectionHeader.astro';
import ChevronDown from './icons/ChevronDown.astro';
import { companyInfo } from '../content/shared.ts';
import Button from './ui/Button.astro';
import type { Theme } from '../lib/themeUtils';

interface FAQ {
	question: string;
	answer: string;
}

export interface Props {
	theme?: Theme;
	tag?: string;
	title?: string;
	description?: string;
	items?: FAQ[];
}

const {
	theme = 'light',
	tag = 'FAQ',
	title = 'Frequently Asked Questions',
	description = 'Get answers to common questions about our custom cabinetry process, pricing, and services.',
	items = [
		{
			question: 'How long does a typical kitchen renovation take?',
			answer: 'Stock cabinets take 2 weeks. Custom cabinetry, it takes 8-12 weeks depending on project complexity and customization requirements.'
		},
		{
			question: 'What is included in your free consultation?',
			answer: 'Our complimentary consultation (in-home or at our showroom) includes professional space assessment, free measurements, style and finish recommendations through a mood board, and a detailed quote with transparent pricing. We also discuss your timeline, budget, and any special requirements during this visit.'
		},
		{
			question: 'Do you offer financing options?',
			answer: 'Yes, we provide flexible financing solutions to make your dream kitchen or closet more accessible. We work with FinanceIt to offer competitive rates and payment plans that fit your budget. Contact us to discuss available options.'
		},
		{
			question: 'What warranty do you provide on your work?',
			answer: 'We stand behind our craftsmanship with a 3-year limited warranty on materials, and 1-year warranty on hardware and workmanship. We provide ongoing support for any issues that may arise.'
		},
		{
			question: 'Can you work with my existing layout?',
			answer: 'Absolutely! We specialize in maximizing your current space, whether you want to keep the existing layout or make modifications. Our designers will assess your space and recommend the best approach to achieve your goals within your budget.'
		},
		{
			question: 'What makes Bosco Cabinetry different from other companies?',
			answer: 'Our combination of affordable luxury, proven track record of 100+ completed projects, 5,500 sq ft showroom, and full-service approach sets us apart. We handle everything from design to installation and offer over 100 finish options at competitive prices.'
		},
		{
			question: 'How much do your custom cabinets cost?',
			answer: 'Pricing varies based on size, materials, finishes, and complexity. Kitchen cabinet projects typically start around $8,000 and can range up to $50,000+ for luxury installations. We provide detailed, transparent quotes with no hidden fees during your free consultation.'
		}
	]
} = Astro.props;

const faqs = items;
const isDark = theme === 'dark';
---

<SectionWrapper theme={theme} id="faq">
	<SectionHeader
		tag={tag}
		title={title}
		description={description}
		layout="center"
		theme={theme}
	/>

	<!-- FAQ Accordion -->
	<div class="max-w-4xl mx-auto">
			<div class="space-y-4">
				{faqs.map((faq, index) => (
					<div class={`faq-item rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-lg ${isDark ? 'gradient-card-dark border border-brand-primary/20 hover:border-brand-primary/40' : 'gradient-card-light border border-brand-accent/30 hover:border-brand-primary/30'}`}>
						<button
							class={`faq-question w-full px-6 py-6 text-left flex items-center justify-between gap-4 transition-colors duration-200 ${isDark ? 'hover:bg-white/5' : 'hover:bg-brand-primary/5'}`}
							aria-expanded="false"
							data-faq-index={index}
						>
							<h3 class={`text-lg font-semibold leading-tight flex-1 ${isDark ? 'text-white' : 'text-brand-charcoal'}`}>
								{faq.question}
							</h3>
							<div class="faq-icon w-6 h-6 text-brand-primary flex-shrink-0 transition-transform duration-200">
								<ChevronDown class="w-6 h-6" />
							</div>
						</button>

						<div class="faq-answer overflow-hidden transition-all duration-300 ease-in-out" style="max-height: 0px;">
							<div class="px-6 pb-6 pt-2">
								<p class={`text-base leading-relaxed ${isDark ? 'text-white/70' : 'text-brand-darkGray/80'}`}>
									{faq.answer}
								</p>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>

	</div>

	<!-- CTA -->
	<div class="mt-16 text-center">
		<div class="inline-flex flex-col sm:flex-row gap-4">
			<Button href="/#contact" variant="primary" size="lg">
				Get Your Free Consultation
			</Button>
			<Button href={companyInfo.contact.phone.href} variant="outline" size="lg">
				Call {companyInfo.contact.phone.display}
			</Button>
		</div>
	</div>
</SectionWrapper>

<style>
/* FAQ Accordion Animations - Design System Compliant */
.faq-item {
	transition: all 0.3s ease-in-out;
}

.faq-question:hover {
	background: rgba(218, 210, 191, 0.08);
}

.faq-icon {
	transition: transform 0.3s ease-in-out;
}

.faq-item.active .faq-icon {
	transform: rotate(180deg);
}

.faq-answer {
	transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out;
	opacity: 0;
}

.faq-item.active .faq-answer {
	opacity: 1;
}

/* Touch target compliance - minimum 44px height */
.faq-question {
	min-height: 48px;
}
</style>

<script>
// FAQ Accordion Functionality
document.addEventListener('DOMContentLoaded', function() {
	const faqQuestions = document.querySelectorAll('.faq-question');

	faqQuestions.forEach(question => {
		question.addEventListener('click', function() {
			const faqItem = this.closest('.faq-item');
			const faqAnswer = faqItem.querySelector('.faq-answer');
			const isActive = faqItem.classList.contains('active');

			// Close all other FAQ items
			document.querySelectorAll('.faq-item.active').forEach(item => {
				if (item !== faqItem) {
					item.classList.remove('active');
					const answer = item.querySelector('.faq-answer');
					const question = item.querySelector('.faq-question');
					answer.style.maxHeight = '0px';
					question.setAttribute('aria-expanded', 'false');
				}
			});

			// Toggle current FAQ item
			if (isActive) {
				faqItem.classList.remove('active');
				faqAnswer.style.maxHeight = '0px';
				this.setAttribute('aria-expanded', 'false');
			} else {
				faqItem.classList.add('active');
				faqAnswer.style.maxHeight = faqAnswer.scrollHeight + 'px';
				this.setAttribute('aria-expanded', 'true');
			}
		});
	});
});
</script>
