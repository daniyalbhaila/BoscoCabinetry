---
import SectionWrapper from './SectionWrapper.astro';
import SectionHeader from './SectionHeader.astro';
import ContentGrid from './ContentGrid.astro';
import AnimatedSection from './AnimatedSection.astro';
import Sparkles from './icons/Sparkles.astro';
import Trophy from './icons/Trophy.astro';
import Building from './icons/Building.astro';
import Wrench from './icons/Wrench.astro';
import Button from './ui/Button.astro';
import { companyInfo } from '../content/shared.ts';

interface DifferentiatorItem {
	title: string;
	description: string;
	iconComponent: any;
}

const differentiators: DifferentiatorItem[] = [
	{
		title: 'Custom at Production Scale',
		description: 'Most custom shops can\'t scale. Most production shops can\'t customize. We do both—with direct manufacturer pricing that makes sense.',
		iconComponent: Sparkles
	},
	{
		title: 'Complete Interior Solutions',
		description: 'Everything from one source: custom cabinetry, matching interior doors, wall paneling, countertops, and smart accessories.',
		iconComponent: Wrench
	},
	{
		title: '100+ Completed Projects',
		description: 'Proven expertise delivering full-home installations with builder-backed reliability across Toronto and the GTA.',
		iconComponent: Trophy
	},
	{
		title: '5,500 sq ft Showroom',
		description: 'Explore 100+ finishes in person. See, touch, and compare all our products—from cabinets to doors to countertops.',
		iconComponent: Building
	}
];
---
<SectionWrapper theme="light" fullHeight={true} id="why-bosco">
	<SectionHeader
		tag="Why Choose Bosco Cabinetry"
		title="What Makes Us Different"
		description="With 100+ completed projects, we've mastered the unique combination of custom quality and production-scale reliability—offering complete interior solutions from one trusted source."
		layout="center"
		theme="light"
	/>

	<ContentGrid
		items={differentiators}
		variant="features"
	/>

	<!-- Bottom CTA -->
	<AnimatedSection className="mt-16 text-center">
		<Button href={companyInfo.urls.bookConsultation} variant="primary" size="lg">
			Experience the Bosco Cabinetry Difference
		</Button>
	</AnimatedSection>
</SectionWrapper>