---
import SectionWrapper from './SectionWrapper.astro';
import SectionHeader from './SectionHeader.astro';
import ContentGrid from './ContentGrid.astro';
import AnimatedSection from './AnimatedSection.astro';
import Sparkles from './icons/Sparkles.astro';
import Trophy from './icons/Trophy.astro';
import Building from './icons/Building.astro';
import Wrench from './icons/Wrench.astro';
import Button from './ui/Button.astro';
import { companyInfo } from '../content/shared.ts';

interface DifferentiatorItem {
	title: string;
	description: string;
	iconComponent: any;
}

const differentiators: DifferentiatorItem[] = [
	{
		title: 'Fully Custom, Made for You',
		description: 'Every project is built to your exact specifications. Your sizes, your finishes, your design — not modified from a catalog.',
		iconComponent: Sparkles
	},
	{
		title: '100+ Completed Projects',
		description: 'Proven expertise in interior design and installation across Toronto.',
		iconComponent: Trophy
	},
	{
		title: '5,500 sq ft Showroom',
		description: 'Explore our North York showroom featuring 100+ finishes and complete room displays.',
		iconComponent: Building
	},
	{
		title: 'Full-Service Experience',
		description: 'From initial design consultation to final installation — we handle every step of your project.',
		iconComponent: Wrench
	}
];
---
<SectionWrapper theme="light" fullHeight={true} id="why-bosco">
	<SectionHeader
		tag="WHY CHOOSE B3 INTERIORS"
		title="What Makes Us Different"
		description="With 100+ completed projects, we deliver fully custom cabinetry and interiors — from stone slabs and wall paneling to interior doors and more — factory-direct, globally sourced, and made to your specifications."
		layout="center"
		theme="light"
	/>

	<ContentGrid
		items={differentiators}
		variant="features"
	/>

	<!-- Bottom CTA -->
	<AnimatedSection className="mt-16 text-center">
		<Button href={companyInfo.urls.bookConsultation} variant="primary" size="lg">
			Experience the B3 Interiors Difference
		</Button>
	</AnimatedSection>
</SectionWrapper>
