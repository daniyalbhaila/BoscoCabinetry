---
import SectionWrapper from './SectionWrapper.astro';
import SectionHeader from './SectionHeader.astro';
import Users from './icons/Users.astro';
import Ruler from './icons/Ruler.astro';
import Hammer from './icons/Hammer.astro';
import CheckCircle from './icons/CheckCircle.astro';
import Button from './ui/Button.astro';

const processSteps = [
  {
    step: '01',
    title: 'Free Consultation',
    description: 'We visit your home to discuss your vision, measure your space, and understand your budget and timeline preferences.',
    icon: Users,
    features: [
      'In-home consultation within 48 hours',
      'Professional space assessment',
      'Style and finish recommendations',
      'Budget and timeline discussion'
    ]
  },
  {
    step: '02',
    title: 'Design & Quote',
    description: 'Our team creates detailed 3D designs and provides a comprehensive quote with no hidden fees or surprises.',
    icon: Ruler,
    features: [
      '3D renderings of your project',
      'Detailed material specifications',
      'Transparent, itemized pricing',
      'Unlimited design revisions'
    ]
  },
  {
    step: '03',
    title: 'Manufacturing',
    description: 'Once approved, we craft your custom cabinetry in our North York facility using premium materials and precision techniques.',
    icon: Hammer,
    features: [
      '3-4 week production timeline',
      'European hardware and finishes',
      'Quality control inspections',
      'Regular progress updates'
    ]
  },
  {
    step: '04',
    title: 'Installation',
    description: 'Our certified installers complete your project with meticulous attention to detail and thorough cleanup.',
    icon: CheckCircle,
    features: [
      'Professional installation team',
      '2-year warranty on workmanship',
      'Complete site cleanup',
      'Final walkthrough and inspection'
    ]
  }
];
---

<SectionWrapper theme="dark" id="process">
	<SectionHeader
		tag="Our Process"
		title="From Concept to Completion in 4 Simple Steps"
		description="Our proven process ensures every project is delivered on time, on budget, and exceeds your expectations."
		layout="center"
		theme="dark"
	/>

	<!-- Process Steps - Split Layout -->
	<div class="max-w-[1200px] mx-auto">
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
			<!-- Left Side - Visual/Illustration -->
			<div class="process-visual">
				<div class="relative">
					<!-- Placeholder for illustration/image - can be replaced with actual image -->
					<div class="process-illustration relative w-full max-w-lg mx-auto aspect-square gradient-card-dark border border-white/20 rounded-2xl p-12 flex items-center justify-center backdrop-blur-sm">
						<!-- Central design showing process flow -->
						<div class="relative w-full h-full">
							<!-- Background elements -->
							<div class="absolute inset-0 gradient-step-circle rounded-xl opacity-20"></div>

							<!-- Process flow visualization -->
							<div class="relative z-10 h-full flex flex-col items-center justify-center space-y-8">
								<div class="flex items-center justify-center w-20 h-20 gradient-brand-primary rounded-full">
									<Users class="w-10 h-10 text-brand-charcoal" />
								</div>
								<div class="flex items-center space-x-4">
									<div class="w-3 h-3 bg-brand-primary rounded-full animate-pulse"></div>
									<div class="w-8 h-px bg-brand-primary/50"></div>
									<div class="w-3 h-3 bg-brand-primary/70 rounded-full animate-pulse" style="animation-delay: 0.5s"></div>
									<div class="w-8 h-px bg-brand-primary/50"></div>
									<div class="w-3 h-3 bg-brand-primary/50 rounded-full animate-pulse" style="animation-delay: 1s"></div>
								</div>
								<div class="flex items-center justify-center w-16 h-16 gradient-brand-primary rounded-full">
									<CheckCircle class="w-8 h-8 text-brand-charcoal" />
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Right Side - Process Steps List -->
			<div class="process-steps">
				<div class="space-y-8">
					{processSteps.map((step, index) => {
						const Icon = step.icon;
						return (
							<div class="process-step group">
								<div class="flex items-start gap-4">
									<!-- Step Number -->
									<div class="flex-shrink-0 flex items-center justify-center w-8 h-8 gradient-brand-primary rounded-full">
										<span class="text-sm font-bold text-brand-charcoal">{step.step}</span>
									</div>

									<!-- Step Content -->
									<div class="flex-1">
										<h3 class="text-xl font-semibold text-white mb-2 group-hover:text-brand-accent transition-colors duration-200">
											{step.title}
										</h3>
										<p class="text-white/80 text-sm leading-relaxed">
											{step.description}
										</p>
									</div>
								</div>
							</div>
						);
					})}
				</div>
			</div>
		</div>
	</div>

	<!-- CTA -->
	<div class="mt-16 text-center">
		<div class="inline-flex flex-col sm:flex-row gap-4">
			<Button href="#contact" variant="primary" size="lg">
				Start Your Project Today
			</Button>
			<Button href="#portfolio" variant="outline" size="lg">
				View Our Work
			</Button>
		</div>
	</div>
</SectionWrapper>

<style>
/* Process Split Layout - Design System Compliant */
.process-illustration {
	transition: all 0.3s ease-in-out;
}

.process-illustration:hover {
	transform: scale(1.02);
	border-color: rgba(218, 210, 191, 0.4);
}

.process-step {
	transition: all 0.3s ease-in-out;
	border-radius: 12px;
	padding: 16px;
	margin: -16px;
}

.process-step:hover {
	background: rgba(218, 210, 191, 0.05);
	backdrop-filter: blur(8px);
}


/* Mobile Responsive */
@media (max-width: 1024px) {
	.process-illustration {
		max-width: 400px;
		margin-bottom: 2rem;
	}
}

@media (max-width: 768px) {
	.process-illustration {
		max-width: 320px;
		padding: 2rem;
	}

	.process-steps {
		margin-top: 2rem;
	}
}
</style>