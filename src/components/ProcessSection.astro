---
import SectionWrapper from './SectionWrapper.astro';
import SectionHeader from './SectionHeader.astro';
import Users from './icons/Users.astro';
import Ruler from './icons/Ruler.astro';
import Hammer from './icons/Hammer.astro';
import CheckCircle from './icons/CheckCircle.astro';
import Button from './ui/Button.astro';
import ProcessImage from '../assets/Process.jpg';
import { Image } from 'astro:assets';
import { CARD_IMAGE_DIMENSIONS } from '../lib/imageConfig';
import type { Theme } from '../lib/themeUtils';

interface ProcessStep {
	step: string;
	title: string;
	description: string;
	icon?: any;
	features: string[];
}

export interface Props {
	theme?: Theme;
	tag?: string;
	title?: string;
	description?: string;
	steps?: ProcessStep[];
}

const {
	theme = 'dark',
	tag = 'Our Process',
	title = 'From Concept to Completion in 4 Simple Steps',
	description = 'Our proven process ensures every project is delivered on time, on budget, and exceeds your expectations.',
	steps = [
		{
			step: '01',
			title: 'Free Consultation',
			description: 'We visit your home or you can come to our showroom to discuss your vision, measure your space, and understand your budget and timeline preferences.',
			icon: Users,
			features: [
				'Complimentary in-home or showroom consultation',
				'Professional space assessment',
				'Style and finish recommendations',
				'Budget and timeline discussion'
			]
		},
		{
			step: '02',
			title: 'Design Commitment & 3D Rendering',
			description: 'Once you commit to your project, our team creates detailed 3D designs and provides comprehensive project specifications with no hidden fees or surprises.',
			icon: Ruler,
			features: [
				'Detailed 3D renderings of your project',
				'Complete material specifications',
				'Transparent, itemized pricing',
				'Unlimited design revisions'
			]
		},
		{
			step: '03',
			title: 'Manufacturing',
			description: 'Once approved, we manage the production of your custom cabinetry using premium materials and precision techniques.',
			icon: Hammer,
			features: [
				'Premium materials and finishes',
				'European hardware options',
				'Quality control inspections',
				'Regular progress updates'
			]
		},
		{
			step: '04',
			title: 'Installation',
			description: 'Our certified installers complete your project with meticulous attention to detail and thorough cleanup.',
			icon: CheckCircle,
			features: [
				'Professional installation team',
				'3-year limited warranty',
				'Complete site cleanup',
				'Final walkthrough and inspection'
			]
		}
	]
} = Astro.props;

const processSteps = steps;
const isDark = theme === 'dark';
---

<SectionWrapper theme={theme} id="process">
	<SectionHeader
		tag={tag}
		title={title}
		description={description}
		layout="center"
		theme={theme}
	/>

	<!-- Process Steps - Split Layout -->
	<div class="max-w-[1200px] mx-auto">
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
			<!-- Left Side - Process Image -->
			<div class="process-visual">
				<div class="relative">
					<div class={`process-image relative w-full max-w-lg mx-auto aspect-[3/2] rounded-2xl overflow-hidden border ${isDark ? 'border-white/20' : 'border-brand-accent/30'}`}>
						<Image
							src={ProcessImage}
							alt="Bosco Cabinetry showroom and manufacturing process"
							class="h-full w-full object-cover"
							width={CARD_IMAGE_DIMENSIONS.width}
							height={CARD_IMAGE_DIMENSIONS.height}
							sizes={CARD_IMAGE_DIMENSIONS.sizes}
							format="webp"
							quality={80}
							loading="lazy"
							decoding="async"
						/>
						<!-- Overlay with process indicators -->
						<div class="absolute inset-0 bg-gradient-to-t from-brand-charcoal/80 via-transparent to-transparent"></div>
						<div class="absolute bottom-6 left-6 right-6">
							<div class="flex items-center justify-between">
								<div class="flex items-center space-x-2">
									<div class="w-3 h-3 bg-brand-primary rounded-full animate-pulse"></div>
									<div class="w-8 h-px bg-brand-primary/50"></div>
									<div class="w-3 h-3 bg-brand-primary/70 rounded-full animate-pulse" style="animation-delay: 0.5s"></div>
									<div class="w-8 h-px bg-brand-primary/50"></div>
									<div class="w-3 h-3 bg-brand-primary/50 rounded-full animate-pulse" style="animation-delay: 1s"></div>
								</div>
							</div>
							<p class={`text-sm mt-3 ${isDark ? 'text-white/80' : 'text-white/90'}`}>Quality craftsmanship and attention to detail</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Right Side - Process Steps List -->
			<div class="process-steps">
				<div class="space-y-8">
					{processSteps.map((step, index) => {
						const Icon = step.icon;
						return (
							<div class="process-step group">
								<div class="flex items-start gap-4">
									<!-- Step Number -->
									<div class="flex-shrink-0 flex items-center justify-center w-8 h-8 gradient-brand-primary rounded-full">
										<span class="text-sm font-bold text-brand-charcoal">{step.step}</span>
									</div>

									<!-- Step Content -->
									<div class="flex-1">
										<h3 class={`text-xl font-semibold mb-2 group-hover:text-brand-accent transition-colors duration-200 ${isDark ? 'text-white' : 'text-brand-charcoal'}`}>
											{step.title}
										</h3>
										<p class={`text-sm leading-relaxed ${isDark ? 'text-white/80' : 'text-brand-darkGray'}`}>
											{step.description}
										</p>
									</div>
								</div>
							</div>
						);
					})}
				</div>
			</div>
		</div>
	</div>

	<!-- CTA -->
	<div class="mt-16 text-center">
		<div class="inline-flex flex-col sm:flex-row gap-4">
			<Button href="#contact" variant="primary" size="lg">
				Start Your Project Today
			</Button>
			<Button href="#portfolio" variant="outline" size="lg">
				View Our Work
			</Button>
		</div>
	</div>
</SectionWrapper>

<style>
/* Process Split Layout - Design System Compliant */
.process-image {
	transition: all 0.3s ease-in-out;
}

.process-image:hover {
	transform: scale(1.02);
	border-color: rgba(218, 210, 191, 0.4);
}

.process-step {
	transition: all 0.3s ease-in-out;
	border-radius: 12px;
	padding: 16px;
	margin: -16px;
}

.process-step:hover {
	background: rgba(218, 210, 191, 0.05);
	backdrop-filter: blur(8px);
}
</style>
