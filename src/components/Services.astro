---
import SectionWrapper from './SectionWrapper.astro';
import SectionHeader from './SectionHeader.astro';
import ContentGrid from './ContentGrid.astro';
import KitchenImage from '../assets/kitchen.jpg';
import ShowroomImage from '../assets/showroom.jpg';

interface ServiceItem {
	key: string;
	title: string;
	description: string;
	cta?: string;
	href?: string;
	emoji?: string;
	variant?: 'image' | 'text';
	image?: any;
}

const services: ServiceItem[] = [
	{
		key: 'kitchens',
		title: 'Custom Kitchen Cabinets',
		description: 'Modern kitchens designed for your home and budget. European hardware, premium finishes, professional installation.',
		emoji: '🍽️',
		href: '#get-quote',
		cta: 'Get a Kitchen Quote',
		variant: 'image',
		image: KitchenImage
	},
	{
		key: 'closets',
		title: 'Walk‑In & Reach‑In Closets',
		description: 'Maximize storage with smart closet systems, lighting, and accessories tailored to your space.',
		emoji: '🧥',
		href: '#get-quote',
		cta: 'Design My Closet',
		variant: 'image',
		image: ShowroomImage
	},
	{
		key: 'wall-units',
		title: 'Built‑Ins & Media Walls',
		description: 'Seamless wall units, entertainment centers, and home offices that elevate your living space.',
		emoji: '🧩',
		href: '#get-quote',
		cta: 'Plan My Built‑In',
		variant: 'image',
		image: KitchenImage
	},
	{
		key: 'paneling',
		title: 'Full Home Cabinetry',
		description: 'Fluted, ribbed, and acoustic panels for statement walls and cohesive interiors.',
		emoji: '🎛️',
		href: '#get-quote',
		cta: 'Explore Paneling',
		variant: 'image',
		image: ShowroomImage
	}
];
---

<SectionWrapper theme="light" id="services">
	<SectionHeader
		tag="Services"
		title="How We Help You Reimagine Your Home"
		description="We design, build, and install custom cabinetry across kitchens, closets, built‑ins, and more—delivering a cohesive, modern look with reliable timelines and transparent pricing."
		layout="split"
		theme="light"
	/>

	<ContentGrid
		items={services}
		variant="services"
	/>
</SectionWrapper>

 