---
import SectionWrapper from './SectionWrapper.astro';
import SectionHeader from './SectionHeader.astro';
import ContentGrid from './ContentGrid.astro';
import AnimatedSection from './AnimatedSection.astro';
import KitchenImage from '../assets/kitchen.jpg';
import ClosetImage from '../assets/Closet.jpg';
import MediaWallImage from '../assets/MediaWall.jpg';
import FullHomeImage from '../assets/FullHome.jpg';
import { companyInfo } from '../content/shared.ts';

interface ServiceItem {
	key: string;
	title: string;
	description: string;
	cta?: string;
	href?: string;
	emoji?: string;
	variant?: 'image' | 'text';
	image?: any;
	transitionName?: string;
}

// PRIMARY: Core cabinetry expertise (with images)
const primaryServices: ServiceItem[] = [
	{
		key: 'kitchens',
		title: 'Custom Kitchen Cabinets',
		description: 'Modern kitchens designed for your home and budget. European hardware, premium finishes, professional installation.',
		emoji: '🍽️',
		href: '/services/kitchen-cabinets',
		cta: 'Get a Kitchen Quote',
		variant: 'image',
		image: KitchenImage,
		transitionName: 'service-hero-kitchen-cabinets'
	},
	{
		key: 'closets',
		title: 'Walk‑In & Reach‑In Closets',
		description: 'Maximize storage with smart closet systems, lighting, and accessories tailored to your space.',
		emoji: '🧥',
		href: '/services/custom-closets',
		cta: 'Design My Closet',
		variant: 'image',
		image: ClosetImage,
		transitionName: 'service-hero-custom-closets'
	},
	{
		key: 'wall-units',
		title: 'Built‑Ins & Media Walls',
		description: 'Seamless wall units, entertainment centers, and home offices that elevate your living space.',
		emoji: '🧩',
		href: '/services/built-ins',
		cta: 'Plan My Built‑In',
		variant: 'image',
		image: MediaWallImage,
		transitionName: 'service-hero-built-ins'
	},
	{
		key: 'bathroom',
		title: 'Bathroom Vanities',
		description: 'Custom bathroom cabinetry with premium finishes and smart storage solutions.',
		emoji: '🚿',
		href: '/services/kitchen-cabinets',
		cta: 'Explore Vanities',
		variant: 'image',
		image: FullHomeImage,
		transitionName: 'service-hero-bathroom'
	}
];

// COMPLEMENTARY: Complete your project from one source
const complementaryProducts: ServiceItem[] = [
	{
		key: 'doors',
		title: 'Interior Doors',
		description: 'Matching doors in the same finish as your cabinetry—standard, frameless, or hidden pantry doors.',
		href: '/services#doors',
		cta: 'Learn More',
		variant: 'text'
	},
	{
		key: 'paneling',
		title: 'Wall Paneling',
		description: 'Custom wall panels in matching finishes for accent walls and cohesive design throughout your space.',
		href: '/services#paneling',
		cta: 'See Options',
		variant: 'text'
	},
	{
		key: 'countertops',
		title: 'Countertops',
		description: 'Premium quartz and sintered stone countertops. Coordinated design and installation with your cabinetry.',
		href: '/services#countertops',
		cta: 'Explore Materials',
		variant: 'text'
	},
	{
		key: 'accessories',
		title: 'Smart Accessories',
		description: 'Integrated LED lighting, smart storage solutions, and modern hardware to elevate your cabinetry.',
		href: '/services#accessories',
		cta: 'View Accessories',
		variant: 'text'
	}
];
---

<SectionWrapper theme="light" id="services">
	<SectionHeader
		tag="Our Core Expertise"
		title="Custom Cabinetry for Every Room"
		description="Expert design, manufacturing, and installation for kitchens, closets, built-ins, and bathrooms. Over 100+ finishes with builder-backed reliability."
		layout="split"
		theme="light"
	/>

	<!-- Primary Services Grid (Cabinetry with images) -->
	<ContentGrid
		items={primaryServices}
		variant="services"
	/>

	<!-- Complementary Products Section -->
	<AnimatedSection className="mt-20">
		<div class="text-center mb-12">
			<p class="text-[11px] uppercase tracking-[0.2em] text-brand-bronze mb-4">Complete Your Project</p>
			<h3 class="text-3xl font-bold text-brand-charcoal mb-4">Everything from One Source</h3>
			<p class="text-lg text-brand-darkGray max-w-3xl mx-auto">
				Why coordinate 5 different vendors? We also provide interior doors, wall paneling, countertops, and smart accessories—all designed to match your cabinetry perfectly.
			</p>
		</div>

		<ContentGrid
			items={complementaryProducts}
			variant="features"
		/>

		<!-- Value Proposition Callout -->
		<div class="mt-12 p-8 rounded-2xl border border-brand-accent/30 gradient-card-light max-w-4xl mx-auto text-center">
			<h4 class="text-xl font-bold text-brand-charcoal mb-3">Single Consultation. Unified Design. One Timeline.</h4>
			<p class="text-brand-darkGray mb-4">
				Get everything coordinated in one project—no juggling multiple contractors, delivery schedules, or hoping finishes match. Just beautiful, cohesive results.
			</p>
			<p class="text-sm text-brand-darkGray/75 italic">
				Order just cabinets or bundle everything. Your choice, our capability.
			</p>
		</div>
	</AnimatedSection>
</SectionWrapper>


