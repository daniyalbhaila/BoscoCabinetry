---
import SectionWrapper from './SectionWrapper.astro';
import SectionHeader from './SectionHeader.astro';
import ContentGrid from './ContentGrid.astro';
import KitchenImage from '../assets/kitchen.jpg';
import ClosetImage from '../assets/Closet.jpg';
import MediaWallImage from '../assets/MediaWall.jpg';
import FullHomeImage from '../assets/FullHome.jpg';

interface ServiceItem {
	key: string;
	title: string;
	description: string;
	cta?: string;
	href?: string;
	emoji?: string;
	variant?: 'image' | 'text';
	image?: any;
	transitionName?: string;
}

const services: ServiceItem[] = [
	{
		key: 'kitchens',
		title: 'Kitchen Renovation',
		description: 'Complete kitchen renovations with custom cabinetry, stone slabs, premium finishes, and expert installation — tailored to your lifestyle.',
		emoji: '🍽️',
		href: '/services/kitchen-cabinets',
		cta: 'Get a Kitchen Quote',
		variant: 'image',
		image: KitchenImage,
		transitionName: 'service-hero-kitchen-cabinets'
	},
	{
		key: 'closets',
		title: 'Walk‑In & Reach‑In Closets',
		description: 'Maximize storage with smart closet systems, lighting, and accessories tailored to your space.',
		emoji: '🧥',
		href: '/services/custom-closets',
		cta: 'Design My Closet',
		variant: 'image',
		image: ClosetImage,
		transitionName: 'service-hero-custom-closets'
	},
	{
		key: 'wall-units',
		title: 'Built‑Ins & Media Walls',
		description: 'Seamless wall units, entertainment centers, and home offices that elevate your living space.',
		emoji: '🧩',
		href: '/services/built-ins',
		cta: 'Plan My Built‑In',
		variant: 'image',
		image: MediaWallImage,
		transitionName: 'service-hero-built-ins'
	},
	{
		key: 'paneling',
		title: 'Whole-Home Interiors',
		description: 'Complete interior solutions for your entire home — custom cabinetry, stone slabs, wall paneling, interior doors, and more — designed to create one cohesive look throughout.',
		emoji: '🎛️',
		href: '/services/full-home-cabinetry',
		cta: 'Explore Packages',
		variant: 'image',
		image: FullHomeImage,
		transitionName: 'service-hero-full-home-cabinetry'
	}
];
---

<SectionWrapper theme="light" id="services">
	<SectionHeader
		tag="Services"
		title="How We Help You Reimagine Your Home"
		description="We design, build, and install complete cabinetry and renovation solutions — including stone slabs, wall paneling, and interior doors — across kitchens, bathrooms, closets, and more. A cohesive, modern look with reliable timelines and transparent pricing."
		layout="split"
		theme="light"
	/>

	<ContentGrid
		items={services}
		variant="services"
	/>
</SectionWrapper>

 
