---
import { Image } from 'astro:assets';
import Button from './ui/Button.astro';
import AnimatedSection from './AnimatedSection.astro';
import SustainabilityImage from '../assets/sustainability.webp';
import { ANIMATION_DELAYS } from '../lib/animationConstants';

interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'dark' } = Astro.props;
---

<section class="relative py-20 md:py-28 bg-brand-forest" id="sustainability-cta">
  <div class="container mx-auto px-6 max-w-7xl">
    <AnimatedSection stagger={ANIMATION_DELAYS.EXTRA_SLOW}>
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <!-- Image -->
        <div class="order-2 md:order-1">
          <div class="rounded-2xl overflow-hidden">
            <Image
              src={SustainabilityImage}
              alt="Sustainable eco-friendly kitchen cabinetry"
              class="w-full h-auto object-cover"
              loading="lazy"
              format="webp"
              quality={80}
            />
          </div>
        </div>

        <!-- Content -->
        <AnimatedSection stagger={ANIMATION_DELAYS.MEDIUM} className="order-1 md:order-2">
          <p class="text-[11px] uppercase tracking-[0.2em] text-brand-accent/80 mb-4">
            [Environmental Commitment]
          </p>
          <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl mb-6">
            Beautiful Design. Healthier Homes.
          </h2>
          <p class="text-base text-white/90 leading-relaxed mb-8">
            Discover our eco-friendly cabinetry solutions with zero-added formaldehyde, air-purifying technology, and sustainable materials. Protect your family's health while caring for the planet.
          </p>

          <AnimatedSection stagger={ANIMATION_DELAYS.QUICK} className="space-y-3 mb-8 text-white/80 leading-relaxed">
          <li class="flex items-start gap-3">
            <span class="text-brand-accent mt-1 font-bold">✓</span>
            <span><strong class="text-white">EPA & CARB Certified:</strong> Zero-added formaldehyde materials</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-accent mt-1 font-bold">✓</span>
            <span><strong class="text-white">Air-Purifying Technology:</strong> Bamboo boards that clean your indoor air 24/7</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-accent mt-1 font-bold">✓</span>
            <span><strong class="text-white">Sustainable Options:</strong> Available across all product lines</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-accent mt-1 font-bold">✓</span>
            <span><strong class="text-white">Competitive Pricing:</strong> No premium for eco-conscious choices</span>
          </li>
          </AnimatedSection>

          <div class="flex flex-wrap gap-4">
            <Button variant="primary" size="lg" href="/sustainability">
              Explore Sustainable Options
            </Button>
            <Button variant="ghost" size="lg" href="/#contact">
              Request a Quote
            </Button>
          </div>
        </AnimatedSection>
      </div>
    </AnimatedSection>
  </div>
</section>
