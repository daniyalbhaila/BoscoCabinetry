---
import AnimatedSection from './AnimatedSection.astro';
import { getThemeClasses, type Theme } from '../lib/themeUtils';
import { ANIMATION_DELAYS } from '../lib/animationConstants';

export interface Props {
  tag?: string;
  title: string;
  description?: string;
  layout?: 'center' | 'split';
  theme?: Theme;
  className?: string;
}

const {
  tag,
  title,
  description,
  layout = 'center',
  theme = 'light',
  className = ''
} = Astro.props;

// Get theme classes from centralized utilities
const classes = getThemeClasses(theme);

// Theme-specific classes for SectionHeader
const themeClasses = {
  tag: classes.tag,
  title: classes.heading,
  description: theme === 'dark' ? 'text-white/80' : classes.body
};

// Layout variants from actual homepage
const layoutClasses = layout === 'center'
  ? 'mx-auto max-w-3xl text-center mb-16'
  : 'mb-10 grid grid-cols-1 items-end gap-8 md:mb-14 md:grid-cols-12';

const wrapperClasses = `${layoutClasses} ${className}`.trim();
---

{layout === 'center' ? (
  <!-- Centered Layout (WhyBosco, Reviews pattern) -->
  <AnimatedSection stagger={ANIMATION_DELAYS.NORMAL} className={wrapperClasses}>
    {tag && (
      <p class={`text-[11px] uppercase tracking-[0.2em] ${themeClasses.tag} mb-4`}>
        [{tag}]
      </p>
    )}
    <h2 class={`text-3xl font-semibold tracking-tight ${themeClasses.title} sm:text-4xl md:text-5xl mb-6`}>
      {title}
    </h2>
    {description && (
      <p class={`text-base leading-relaxed ${themeClasses.description}`}>
        {description}
      </p>
    )}
  </AnimatedSection>
) : (
  <!-- Split Layout (Services pattern) -->
  <AnimatedSection stagger={ANIMATION_DELAYS.NORMAL} className={wrapperClasses}>
    <div class="md:col-span-7">
      {tag && (
        <p class={`text-[11px] uppercase tracking-[0.2em] ${themeClasses.tag}`}>
          [{tag}]
        </p>
      )}
      <h2 class={`mt-2 text-3xl font-semibold tracking-tight ${themeClasses.title} sm:text-4xl md:text-5xl`}>
        {title}
      </h2>
    </div>
    {description && (
      <p class={`md:col-span-5 ${themeClasses.description} md:pb-2`}>
        {description}
      </p>
    )}
  </AnimatedSection>
)}