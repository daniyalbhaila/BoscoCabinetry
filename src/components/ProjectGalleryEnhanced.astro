---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getThemeClasses, type Theme } from '../lib/themeUtils';

export interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

export interface Props {
  images: GalleryImage[];
  title: string;
  theme?: Theme;
}

const { images, title, theme = 'light' } = Astro.props;
const classes = getThemeClasses(theme);
---

<section class={`${classes.bg} py-12`} id="project-gallery">
  <div class="mx-auto max-w-7xl px-6">
    <h2 class={`text-3xl font-semibold ${classes.heading} mb-8`}>Project Gallery</h2>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {images.map((image, index) => (
        <button
          type="button"
          class="gallery-item group relative overflow-hidden rounded-lg cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand-primary aspect-[4/3]"
          data-index={index}
          aria-label={`View image ${index + 1}: ${image.alt}`}
        >
          <Image
            src={image.src}
            alt={image.alt}
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
            width={600}
            height={450}
            format="webp"
            quality={80}
            loading={index < 6 ? "eager" : "lazy"}
            decoding="async"
          />

          <!-- Hover Overlay -->
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
            <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/>
            </svg>
          </div>

          {image.caption && (
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <p class="text-white text-sm">{image.caption}</p>
            </div>
          )}
        </button>
      ))}
    </div>
  </div>
</section>

<!-- Lightbox Modal -->
<div
  id="lightbox"
  class="fixed inset-0 z-[14000] hidden bg-black/95 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Image gallery lightbox"
  aria-hidden="true"
>
  <!-- Top Controls -->
  <div
    class="absolute left-0 right-0 top-0 z-[14010] flex items-start justify-between gap-3 px-4 pb-4 pt-[calc(env(safe-area-inset-top,0px)+1rem)] sm:px-6 sm:pb-6 sm:pt-[calc(env(safe-area-inset-top,0px)+1.5rem)]"
    data-lightbox-ui
  >
    <div class="pointer-events-none select-none">
      <span
        id="lightbox-counter"
        class="inline-flex min-w-[88px] items-center justify-center rounded-full bg-black/70 px-3 py-1 text-sm font-medium text-white shadow-lg backdrop-blur"
      ></span>
    </div>
    <button
      id="lightbox-close"
      type="button"
      class="flex h-12 w-12 items-center justify-center rounded-full bg-black/80 text-white shadow-lg transition-colors hover:bg-brand-accent focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-black/50 sm:h-14 sm:w-14"
      aria-label="Close gallery"
      data-lightbox-control
    >
      <svg class="h-6 w-6 sm:h-7 sm:w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
      <span class="sr-only">Close gallery</span>
    </button>
  </div>

  <!-- Previous Button -->
  <button
    id="lightbox-prev"
    type="button"
    class="absolute left-4 top-1/2 z-[14005] -translate-y-1/2 text-white hover:text-brand-accent transition-colors p-2 focus:outline-none focus:ring-2 focus:ring-white rounded-lg disabled:opacity-30 disabled:cursor-not-allowed"
    aria-label="Previous image"
    data-lightbox-control
  >
    <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
  </button>

  <!-- Next Button -->
  <button
    id="lightbox-next"
    type="button"
    class="absolute right-4 top-1/2 z-[14005] -translate-y-1/2 text-white hover:text-brand-accent transition-colors p-2 focus:outline-none focus:ring-2 focus:ring-white rounded-lg disabled:opacity-30 disabled:cursor-not-allowed"
    aria-label="Next image"
    data-lightbox-control
  >
    <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
  </button>

  <!-- Image Container -->
  <div class="flex h-full w-full items-center justify-center p-4 md:p-8">
    <div class="image-container relative flex items-center justify-center" data-lightbox-content>
      <img
        id="lightbox-image"
        src=""
        alt=""
        class="max-w-full max-h-[85vh] w-auto h-auto object-contain rounded-lg mx-auto"
      />
    </div>
  </div>
</div>

<style>
  /* Prevent body scroll when lightbox is open */
  body.lightbox-open {
    overflow: hidden;
  }
</style>

<script is:inline define:vars={{ images, title }}>
  const initProjectLightbox = () => {
    const galleryItems = Array.from(document.querySelectorAll('.gallery-item'));
    const lightbox = document.getElementById('lightbox');

    if (!galleryItems.length || !lightbox || lightbox.dataset.initialized === 'true') {
      return;
    }

    const lightboxImage = document.getElementById('lightbox-image');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const imageContainer = lightbox.querySelector('[data-lightbox-content]');

    const totalImages = Array.isArray(images) ? images.length : 0;
    if (!lightboxImage || !lightboxCounter || totalImages === 0) {
      return;
    }

    lightbox.dataset.initialized = 'true';

    const imageData = (Array.isArray(images) ? images : []).map((img) => {
      const metadata = img && typeof img === 'object' ? img.src ?? {} : {};
      const deriveSrc = typeof metadata === 'string' ? metadata : metadata?.src ?? '';
      const srcSet = typeof metadata === 'string' ? '' : metadata?.srcset ?? '';

      return {
        alt: (img && img.alt) || title,
        src: deriveSrc,
        srcset: srcSet,
      };
    });

    let currentIndex = 0;
    let lastActiveTrigger = null;
    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    let touchEndY = 0;

    const prefersReducedMotion =
      typeof window !== 'undefined' &&
      typeof window.matchMedia === 'function' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const getFocusableElements = () => {
      const focusableSelectors = [
        'button',
        '[href]',
        'input',
        'select',
        'textarea',
        '[tabindex]:not([tabindex="-1"])',
      ];

      return Array.from(lightbox.querySelectorAll(focusableSelectors.join(','))).filter((element) => {
        if (!(element instanceof HTMLElement)) return false;
        if (element.hasAttribute('disabled')) return false;
        if (element.getAttribute('aria-hidden') === 'true') return false;
        const rect = element.getBoundingClientRect();
        return rect.width > 0 && rect.height > 0;
      });
    };

    const setButtonState = () => {
      const isSingleImage = totalImages <= 1;
      if (prevBtn) {
        prevBtn.disabled = isSingleImage || currentIndex === 0;
        prevBtn.classList.toggle('hidden', isSingleImage);
      }
      if (nextBtn) {
        nextBtn.disabled = isSingleImage || currentIndex === totalImages - 1;
        nextBtn.classList.toggle('hidden', isSingleImage);
      }
    };

    const updateImage = () => {
      const current = imageData[currentIndex];
      if (!current) return;

      if (current.srcset) {
        lightboxImage.srcset = current.srcset;
      } else {
        lightboxImage.removeAttribute('srcset');
      }

      if (lightboxImage.getAttribute('src') !== current.src) {
        lightboxImage.src = current.src;
      }

      lightboxImage.alt = current.alt || title;
      lightboxImage.dataset.index = String(currentIndex);

      lightboxCounter.textContent = `${currentIndex + 1} / ${totalImages}`;
      setButtonState();
    };

    const openLightbox = (index, trigger) => {
      currentIndex = index;
      lastActiveTrigger = trigger;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.classList.add('lightbox-open');

      updateImage();
      if (closeBtn) {
        closeBtn.focus({ preventScroll: true });
      }
    };

    const closeLightbox = () => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('lightbox-open');

      if (lastActiveTrigger) {
        lastActiveTrigger.focus({ preventScroll: true });
        lastActiveTrigger = null;
      }
    };

    const showNext = () => {
      if (currentIndex < totalImages - 1) {
        currentIndex += 1;
        updateImage();
      }
    };

    const showPrev = () => {
      if (currentIndex > 0) {
        currentIndex -= 1;
        updateImage();
      }
    };

    const onKeydown = (event) => {
      if (!lightbox.classList.contains('flex')) return;

      switch (event.key) {
        case 'Escape':
          event.preventDefault();
          closeLightbox();
          break;
        case 'ArrowLeft':
          event.preventDefault();
          showPrev();
          break;
        case 'ArrowRight':
          event.preventDefault();
          showNext();
          break;
        case 'Tab': {
          const focusable = getFocusableElements();
          if (!focusable.length) break;

          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          const active = document.activeElement;

          if (event.shiftKey && active === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && active === last) {
            event.preventDefault();
            first.focus();
          }
          break;
        }
      }
    };

    const handleBackgroundClick = (event) => {
      const target = event.target;

      if (target === lightbox) {
        closeLightbox();
        return;
      }

      const elementTarget =
        target instanceof Element
          ? target
          : target instanceof Node
            ? target.parentElement
            : null;

      const clickedControl = elementTarget?.closest('[data-lightbox-control]') ?? null;
      const clickedContent =
        elementTarget && imageContainer instanceof Element
          ? imageContainer.contains(elementTarget)
          : false;

      if (!clickedControl && !clickedContent) {
        closeLightbox();
      }
    };

    const handleTouchStart = (event) => {
      if (!lightbox.classList.contains('flex') || event.touches.length !== 1) return;
      touchStartX = event.touches[0].clientX;
      touchStartY = event.touches[0].clientY;
      touchEndX = touchStartX;
      touchEndY = touchStartY;
    };

    const handleTouchMove = (event) => {
      if (!lightbox.classList.contains('flex') || event.touches.length !== 1) return;
      touchEndX = event.touches[0].clientX;
      touchEndY = event.touches[0].clientY;
    };

    const handleTouchEnd = () => {
      const deltaX = touchEndX - touchStartX;
      const deltaY = Math.abs(touchEndY - touchStartY);
      const minDistance = 48;

      if (Math.abs(deltaX) >= minDistance && deltaY < 80) {
        if (deltaX > 0) {
          showPrev();
        } else {
          showNext();
        }
      }

      touchStartX = 0;
      touchStartY = 0;
      touchEndX = 0;
      touchEndY = 0;
    };

    galleryItems.forEach((item, index) => {
      item.addEventListener('click', () => openLightbox(index, item));
    });

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (prevBtn) prevBtn.addEventListener('click', showPrev);
    if (nextBtn) nextBtn.addEventListener('click', showNext);
    lightbox.addEventListener('click', handleBackgroundClick);
    document.addEventListener('keydown', onKeydown);

    if (!prefersReducedMotion && totalImages > 1) {
      const touchTarget = imageContainer || lightbox;
      touchTarget.addEventListener('touchstart', handleTouchStart, { passive: true });
      touchTarget.addEventListener('touchmove', handleTouchMove, { passive: true });
      touchTarget.addEventListener('touchend', handleTouchEnd);
    }

    setButtonState();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectLightbox, { once: true });
  } else {
    initProjectLightbox();
  }

  document.addEventListener('astro:page-load', initProjectLightbox);
</script>
