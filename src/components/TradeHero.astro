---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import Button from './ui/Button.astro';

export interface Props {
	title: string;
	subtitle: string;
	stats: Array<{
		value: string;
		label: string;
	}>;
	ctaButtons: Array<{
		text: string;
		href: string;
		variant: 'primary' | 'ghost' | 'secondary';
	}>;
	backgroundImage?: ImageMetadata | string;
}

const {
	title,
	subtitle,
	stats,
	ctaButtons,
	backgroundImage
} = Astro.props;
---

<section class="relative isolate min-h-[85vh] overflow-hidden">
	{/* Background Image */}
	<div class="absolute inset-0 -z-10">
		{backgroundImage ? (
			typeof backgroundImage === 'string' ? (
				<img
					src={backgroundImage}
					alt="Manufacturing facility"
					class="h-full w-full object-cover"
					loading="eager"
					fetchpriority="high"
				/>
			) : (
				<Image
					src={backgroundImage}
					alt="Manufacturing facility"
					class="h-full w-full object-cover"
					width={backgroundImage.width}
					height={backgroundImage.height}
					loading="eager"
					fetchpriority="high"
				/>
			)
		) : (
			<div class="h-full w-full bg-brand-charcoal"></div>
		)}

		{/* Dark overlay for text readability */}
		<div class="absolute inset-0 bg-gradient-to-br from-brand-charcoal/90 via-brand-darkGray/80 to-black/85"></div>
		{/* Additional text readability gradient */}
		<div class="absolute inset-y-0 left-0 w-full bg-gradient-to-r from-brand-charcoal/95 via-brand-charcoal/60 to-transparent"></div>
	</div>

	<div class="relative mx-auto flex min-h-[85vh] max-w-7xl flex-col justify-center px-6 py-24 md:py-28">
		{/* Main Content */}
		<div class="w-full max-w-3xl">
			{/* H1 Title */}
			<h1 class="max-w-3xl text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl md:text-5xl">
				{title}
			</h1>

			{/* Subtitle/Description */}
			<p class="mt-5 max-w-prose text-sm text-white/85 md:text-base">
				{subtitle}
			</p>

			{/* Stats Grid */}
			<div class="mt-8 grid grid-cols-2 gap-x-8 gap-y-6 lg:grid-cols-4">
				{stats.map((stat) => (
					<div class="text-left">
						<div class="text-lg font-semibold text-brand-primary md:text-xl">
							{stat.value}
						</div>
						<div class="mt-1 text-xs text-white/70 md:text-sm">
							{stat.label}
						</div>
					</div>
				))}
			</div>

			{/* CTA Buttons */}
			<div class="mt-8 flex flex-wrap gap-3">
				{ctaButtons.map((button) => (
					<Button
						variant={button.variant}
						href={button.href}
						size="lg"
					>
						{button.text}
					</Button>
				))}
			</div>
		</div>
	</div>
</section>
