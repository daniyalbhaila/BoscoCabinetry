---
// Design Inspiration / Lead Magnet section
import Check from './icons/Check.astro';
import BookOpen from './icons/BookOpen.astro';
---
<section id="design-inspiration" class="relative isolate bg-white min-h-screen flex items-center">
	<div class="mx-auto max-w-7xl px-6 py-20 md:py-28">
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
			<!-- Left Content -->
			<div>
				<p class="text-[11px] uppercase tracking-[0.2em] text-brand-primary/60 mb-4">[Free Design Guide]</p>
				<h2 class="text-3xl font-semibold tracking-tight text-brand-charcoal sm:text-4xl md:text-5xl mb-6">
					Get Inspired with Our Free Design Catalog
				</h2>
				<p class="text-lg text-brand-darkGray/80 mb-8">
					Download our comprehensive design guide featuring the latest kitchen and closet trends, finish options, and real project transformations to spark your creativity.
				</p>

				<!-- Benefits List -->
				<div class="space-y-4 mb-8">
					<div class="flex items-start gap-3">
						<div class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-primary/10 text-brand-primary flex-shrink-0 mt-0.5">
							<Check class="h-3 w-3" />
						</div>
						<p class="text-brand-darkGray/80">100+ kitchen and closet design inspirations</p>
					</div>
					<div class="flex items-start gap-3">
						<div class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-primary/10 text-brand-primary flex-shrink-0 mt-0.5">
							<Check class="h-3 w-3" />
						</div>
						<p class="text-brand-darkGray/80">Complete finish and hardware catalog</p>
					</div>
					<div class="flex items-start gap-3">
						<div class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-primary/10 text-brand-primary flex-shrink-0 mt-0.5">
							<Check class="h-3 w-3" />
						</div>
						<p class="text-brand-darkGray/80">Before & after project transformations</p>
					</div>
					<div class="flex items-start gap-3">
						<div class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-primary/10 text-brand-primary flex-shrink-0 mt-0.5">
							<Check class="h-3 w-3" />
						</div>
						<p class="text-brand-darkGray/80">Design tips from our expert team</p>
					</div>
				</div>
			</div>

			<!-- Right Form -->
			<div class="lg:pl-8">
				<div class="rounded-2xl border border-brand-accent/30 bg-gradient-to-b from-brand-accent/5 to-white p-8 shadow-lg">
					<div class="mb-6 text-center">
						<div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-xl bg-brand-primary/10">
							<BookOpen class="h-8 w-8 text-brand-primary" />
						</div>
						<h3 class="text-xl font-semibold text-brand-charcoal mb-2">
							Download Your Free Catalog
						</h3>
						<p class="text-sm text-brand-darkGray/75">
							Get instant access to our complete design inspiration guide.
						</p>
					</div>

					<!-- Form -->
					<form class="space-y-4" action="#" method="POST">
						<div>
							<label for="firstName" class="block text-sm font-medium text-brand-charcoal mb-2">
								First Name *
							</label>
							<input
								type="text"
								id="firstName"
								name="firstName"
								required
								class="w-full rounded-lg border border-brand-accent/40 bg-white px-4 py-3 text-brand-charcoal placeholder-brand-darkGray/50 focus:border-brand-primary focus:outline-none focus:ring-2 focus:ring-brand-primary/20"
								placeholder="Enter your first name"
							>
						</div>
						<div>
							<label for="email" class="block text-sm font-medium text-brand-charcoal mb-2">
								Email Address *
							</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								class="w-full rounded-lg border border-brand-accent/40 bg-white px-4 py-3 text-brand-charcoal placeholder-brand-darkGray/50 focus:border-brand-primary focus:outline-none focus:ring-2 focus:ring-brand-primary/20"
								placeholder="Enter your email"
							>
						</div>
						<div>
							<label for="projectType" class="block text-sm font-medium text-brand-charcoal mb-2">
								Project Interest (Optional)
							</label>
							<select
								id="projectType"
								name="projectType"
								class="w-full rounded-lg border border-brand-accent/40 bg-white px-4 py-3 text-brand-charcoal focus:border-brand-primary focus:outline-none focus:ring-2 focus:ring-brand-primary/20"
							>
								<option value="">Select project type</option>
								<option value="kitchen">Kitchen Cabinets</option>
								<option value="closet">Closet Systems</option>
								<option value="builtin">Built-ins & Media Walls</option>
								<option value="paneling">Decorative Paneling</option>
								<option value="multiple">Multiple Projects</option>
							</select>
						</div>
						<button
							type="submit"
							class="btn btn-primary w-full"
						>
							Download Free Catalog
						</button>
					</form>

					<p class="mt-4 text-xs text-center text-brand-darkGray/60">
						We respect your privacy. Unsubscribe at any time.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>