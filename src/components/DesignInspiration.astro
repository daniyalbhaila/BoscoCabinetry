---
// Design Inspiration / Lead Magnet section
import Check from './icons/Check.astro';
import BookOpen from './icons/BookOpen.astro';
import Button from './ui/Button.astro';
import AnimatedSection from './AnimatedSection.astro';
import { getThemeClasses, type Theme } from '../lib/themeUtils';
import { ANIMATION_DELAYS } from '../lib/animationConstants';

export interface Props {
	theme?: Theme;
}

const { theme = 'light' } = Astro.props;

// Get theme classes from centralized utilities
const classes = getThemeClasses(theme);
---
<section id="design-inspiration" class={`relative isolate ${classes.bg} min-h-screen flex items-center`}>
	<div class="mx-auto max-w-7xl px-6 py-20 md:py-28">
		<AnimatedSection stagger={ANIMATION_DELAYS.EXTRA_SLOW}>
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
				<!-- Left Content -->
				<AnimatedSection stagger={ANIMATION_DELAYS.NORMAL}>
					<p class={`text-[11px] uppercase tracking-[0.2em] ${classes.tag} mb-4`}>[Free Design Guide]</p>
					<h2 class={`text-3xl font-semibold tracking-tight ${classes.heading} sm:text-4xl md:text-5xl mb-6`}>
						Get Inspired with Our Free Design Catalog
					</h2>
					<p class={`text-lg ${classes.body} mb-8`}>
						Download our comprehensive design guide featuring the latest kitchen and closet trends and finish options.
					</p>

					<!-- Benefits List -->
					<AnimatedSection stagger={ANIMATION_DELAYS.QUICK} className="space-y-4 mb-8">
						<div class="flex items-start gap-3">
							<div class={`flex h-6 w-6 items-center justify-center rounded-full bg-brand-primary/10 ${classes.icon} flex-shrink-0 mt-0.5`}>
								<Check class="h-3 w-3" />
							</div>
							<p class={classes.body}>100+ kitchen and closet design inspirations</p>
						</div>
						<div class="flex items-start gap-3">
							<div class={`flex h-6 w-6 items-center justify-center rounded-full bg-brand-primary/10 ${classes.icon} flex-shrink-0 mt-0.5`}>
								<Check class="h-3 w-3" />
							</div>
							<p class={classes.body}>Complete finish and hardware catalog</p>
						</div>
					</AnimatedSection>
				</AnimatedSection>

				<!-- Right Form -->
				<div class="lg:pl-8">
					<div class={`rounded-2xl ${classes.card} p-8 shadow-lg`}>
					<div class="mb-6 text-center">
						<div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-xl bg-brand-primary/10">
							<BookOpen class={`h-8 w-8 ${classes.icon}`} />
						</div>
						<h3 class={`text-xl font-semibold ${classes.heading} mb-2`}>
							Download Your Free Catalog
						</h3>
						<p class={`text-sm ${classes.muted}`}>
							Get instant access to our complete design inspiration guide.
						</p>
					</div>

					<!-- Form -->
					<form
						name="design-catalog"
						method="POST"
						action="/thank-you"
						data-netlify="true"
						netlify-honeypot="bot-field"
						class="space-y-4"
					>
						<!-- Required hidden fields for Netlify Forms -->
						<input type="hidden" name="form-name" value="design-catalog" />

						<!-- Honeypot field for spam protection -->
						<p class="hidden">
							<label>
								Don't fill this out if you're human:
								<input name="bot-field" tabindex="-1" autocomplete="off" />
							</label>
						</p>

						<div>
							<label for="firstName" class="form-label-light">
								First Name *
							</label>
							<input
								type="text"
								id="firstName"
								name="firstName"
								required
								class="form-input-light"
								placeholder="Enter your first name"
							>
						</div>
						<div>
							<label for="email" class="form-label-light">
								Email Address *
							</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								class="form-input-light"
								placeholder="Enter your email"
							>
						</div>
						<div>
							<label for="projectType" class="form-label-light">
								Project Interest (Optional)
							</label>
							<select
								id="projectType"
								name="projectType"
								class="form-select-light"
							>
								<option value="">Select project type</option>
								<option value="kitchen">Kitchen Cabinets</option>
								<option value="closet">Closet Systems</option>
								<option value="builtin">Built-ins & Media Walls</option>
								<option value="full-home">Full Home Cabinetry</option>
								<option value="multiple">Multiple Projects</option>
								<option value="other">Other</option>
							</select>
						</div>
						<Button
							type="submit"
							variant="primary"
							size="lg"
							class="w-full"
						>
							Download Free Catalog
						</Button>
					</form>

					<p class="mt-4 text-xs text-center text-brand-darkGray/60">
						We respect your privacy. Unsubscribe at any time.
					</p>
				</div>
			</div>
		</div>
		</AnimatedSection>
	</div>
</section>
