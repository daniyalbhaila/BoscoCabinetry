---
import Button from './ui/Button.astro';
import { Image } from 'astro:assets';
import AnimatedSection from './AnimatedSection.astro';
// Portfolio Images - Diverse showcase of completed projects
import DanLeckieKitchen from '../assets/Portfolio/Kitchen_DanLekcie/IMG_9932.JPG';
import RobinaFullHome from '../assets/Portfolio/FullHome_Robina/1(a).jpg';
import GrandHighlandBathroom from '../assets/Portfolio/Bathroom_GrandHighland/IMG_0093.JPG';
import ThoroldMediaWall from '../assets/Portfolio/MediaWall_Thorold/IMG_0154.jpg';
import RobinaKitchen from '../assets/Portfolio/FullHome_Robina/20.jpg';
import BurningOakKitchen from '../assets/Portfolio/Kitchen_BurningOak/IMG_6738.jpg';
import { CARD_IMAGE_DIMENSIONS } from '../lib/imageConfig';
import { getThemeClasses, type Theme } from '../lib/themeUtils';
import { ANIMATION_DELAYS } from '../lib/animationConstants';

export interface Props {
	theme?: Theme;
}

const { theme = 'light' } = Astro.props;

// Get theme classes from centralized utilities
const classes = getThemeClasses(theme);
---
<section id="gallery" class={`${classes.bgAlt} py-20`}>
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-12 px-6">
    <!-- Section Header -->
    <AnimatedSection stagger={ANIMATION_DELAYS.NORMAL} className="max-w-2xl text-center">
      <p class={`mb-4 text-[11px] uppercase tracking-[0.2em] ${classes.tag}`}>[Our Work]</p>
      <h2 class={`text-3xl font-semibold ${classes.heading} sm:text-4xl md:text-5xl`}>
        Recent Projects
      </h2>
      <p class={`mt-4 text-base ${classes.muted}`}>
        Transforming homes across the Greater Toronto Area with custom cabinetry, closets, and built-ins. Each project showcases our commitment to quality craftsmanship and attention to detail.
      </p>

      <Button href="/portfolio" variant="primary" class="mt-6">View All Projects</Button>
    </AnimatedSection>

    <!-- Mosaic Gallery Grid -->
    <AnimatedSection
      stagger={ANIMATION_DELAYS.NORMAL}
      className="grid w-full auto-rows-[220px] gap-4 md:auto-rows-[300px] md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1fr)]"
    >
      {[
        {
          title: 'Dan Leckie Kitchen Renovation',
          description: 'Modern downtown Toronto kitchen with custom cabinetry and premium finishes',
          image: DanLeckieKitchen,
          layout: 'md:col-start-1 md:col-end-2 md:row-start-1 md:row-end-3'
        },
        {
          title: 'Robina Full Home Renovation',
          description: 'Complete home cabinetry transformation with coordinated design',
          image: RobinaFullHome,
          layout: 'md:col-start-2 md:col-end-4 md:row-start-1 md:row-end-2'
        },
        {
          title: 'Grand Highland Bathroom',
          description: 'Custom bathroom vanity with integrated storage solutions',
          image: GrandHighlandBathroom,
          layout: 'md:col-start-2 md:col-end-3 md:row-start-2 md:row-end-3'
        },
        {
          title: 'Robina Kitchen Detail',
          description: 'Luxury kitchen with custom island and premium cabinetry',
          image: RobinaKitchen,
          layout: 'md:col-start-1 md:col-end-2 md:row-start-3 md:row-end-4'
        },
        {
          title: 'Burning Oak Kitchen',
          description: 'Contemporary kitchen design with sleek cabinetry and modern finishes',
          image: BurningOakKitchen,
          layout: 'md:col-start-2 md:col-end-3 md:row-start-3 md:row-end-4'
        },
        {
          title: 'Thorold Media Wall',
          description: 'Custom entertainment unit with integrated media storage',
          image: ThoroldMediaWall,
          layout: 'md:col-start-3 md:col-end-4 md:row-start-2 md:row-end-4'
        }
      ].map((card) => (
        <article class={`group surface-card ${card.layout}`}>
          <div class="surface-card-media">
            <Image
              src={card.image}
              alt={card.title}
              class="h-full w-full object-cover"
              width={CARD_IMAGE_DIMENSIONS.width}
              height={CARD_IMAGE_DIMENSIONS.height}
              sizes={CARD_IMAGE_DIMENSIONS.sizes}
              format="webp"
              quality={80}
              loading="lazy"
              decoding="async"
            />
            <div class="surface-card-overlay"></div>
          </div>

          <div class="relative z-10 flex h-full flex-col justify-end gap-3 p-6 text-white">
            <h3 class="hidden text-xl font-semibold">{card.title}</h3>
            <p class="hidden text-sm text-white/85">{card.description}</p>
          </div>
        </article>
      ))}
    </AnimatedSection>
  </div>
</section>
