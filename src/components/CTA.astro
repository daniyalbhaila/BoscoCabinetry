---
// Call-to-Action section
import MapPin from './icons/MapPin.astro';
import MessageCircle from './icons/MessageCircle.astro';
import Building from './icons/Building.astro';
import Phone from './icons/Phone.astro';
import Clock from './icons/Clock.astro';
---
<section id="cta" class="relative isolate bg-brand-charcoal min-h-screen flex items-center">
	<div class="mx-auto max-w-7xl px-6 py-20 md:py-28">
		<!-- Main CTA -->
		<div class="mx-auto max-w-4xl text-center mb-16">
			<h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl md:text-5xl mb-6">
				Ready to Transform Your Space?
			</h2>
			<p class="text-lg text-white/70 mb-10">
				Take the first step towards your dream kitchen, closet, or built-in solution. Visit our showroom or get a personalized quote today.
			</p>

			<!-- Primary CTAs -->
			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
				<a href="#book-showroom" class="btn btn-primary px-8 py-4 text-lg inline-flex items-center gap-2">
					<MapPin class="h-5 w-5" />
					Book Showroom Visit
				</a>
				<a href="#get-quote" class="btn btn-ghost px-8 py-4 text-lg inline-flex items-center gap-2">
					<MessageCircle class="h-5 w-5" />
					Request Quote
				</a>
			</div>
		</div>

		<!-- Contact Information Grid -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			<!-- Showroom Info -->
			<div class="text-center">
				<div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-xl bg-white/10">
					<Building class="h-8 w-8 text-white" />
				</div>
				<h3 class="text-lg font-semibold text-white mb-2">Visit Our Showroom</h3>
				<div class="space-y-1 text-white/70">
					<p>5,500 sq ft North York Location</p>
					<p class="text-sm">123 Industrial Pkwy North</p>
					<p class="text-sm">North York, ON M3J 2L5</p>
				</div>
			</div>

			<!-- Phone -->
			<div class="text-center">
				<div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-xl bg-white/10">
					<Phone class="h-8 w-8 text-white" />
				</div>
				<h3 class="text-lg font-semibold text-white mb-2">Call Us Today</h3>
				<div class="space-y-1 text-white/70">
					<p class="text-lg font-medium text-brand-accent">
						<a href="tel:+14165551234" class="hover:text-white transition-colors">
							(416) 555-1234
						</a>
					</p>
					<p class="text-sm">Free consultations available</p>
				</div>
			</div>

			<!-- Hours -->
			<div class="text-center">
				<div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-xl bg-white/10">
					<Clock class="h-8 w-8 text-white" />
				</div>
				<h3 class="text-lg font-semibold text-white mb-2">Showroom Hours</h3>
				<div class="space-y-1 text-white/70 text-sm">
					<p>Monday - Friday: 9 AM - 6 PM</p>
					<p>Saturday: 10 AM - 5 PM</p>
					<p>Sunday: 12 PM - 4 PM</p>
				</div>
			</div>
		</div>
	</div>
</section>