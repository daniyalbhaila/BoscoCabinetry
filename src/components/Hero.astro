---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import heroPoster from '../assets/hero-poster.png';
import { companyInfo, companyDescriptions } from '../content/shared.ts';
import Button from './ui/Button.astro';

export interface Props {
	titleHighlight?: string;
	titleRest?: string;
	kicker?: string;
	description?: string;
	videoSrc?: string;
  backgroundImage?: ImageMetadata | string;
	theme?: 'dark' | 'light';
	size?: 'full' | 'medium' | 'compact';
	ctaButtons?: Array<{
		text: string;
		href: string;
		variant: 'primary' | 'ghost' | 'secondary';
	}>;
}
const {
	titleHighlight = 'Beautiful',
	titleRest = 'Custom Kitchens, Cabinets & Renovations in the GTA',
	kicker = companyInfo.tagline,
	description = companyDescriptions.hero,
	videoSrc = '/media/hero.mp4',
	backgroundImage,
	theme = 'dark',
	size = 'full',
	ctaButtons = [
		{ text: 'Book Showroom Consultation', href: '#book-consult', variant: 'primary' },
		{ text: 'Get a Free Quote', href: '#get-quote', variant: 'ghost' }
	]
} = Astro.props as Props;

// Size variants
const sizeClasses = {
	full: 'min-h-screen',
	medium: 'min-h-[70vh]',
	compact: 'min-h-[50vh]'
};

// Theme variants
const textClasses = {
	dark: 'text-white',
	light: 'text-brand-dark-charcoal'
};

const overlayClasses = {
	dark: 'gradient-hero-dark',
	light: 'gradient-hero-light'
};

const fadeClasses = {
	dark: 'gradient-hero-fade-dark',
	light: 'gradient-hero-fade-light'
};
---
<section class={`relative isolate ${sizeClasses[size]} overflow-hidden`}>
	{/* Background with optimized poster and video */}
	<div class="absolute inset-0 -z-10">
		{/* Background Image */}
		{backgroundImage ? (
			typeof backgroundImage === 'string' ? (
				<img
					src={backgroundImage}
					alt="Page background"
					class="h-full w-full object-cover"
					loading="eager"
					fetchpriority="high"
				/>
			) : (
				<Image
					src={backgroundImage}
					alt="Page background"
					class="h-full w-full object-cover"
					width={backgroundImage.width}
					height={backgroundImage.height}
					loading="eager"
					fetchpriority="high"
				/>
			)
		) : (
			<Image
				src={heroPoster}
				alt="Bosco Cabinetry kitchen showcase"
				class="h-full w-full object-cover"
				width={1672}
				height={940}
				format="webp"
				quality={75}
				loading="eager"
				fetchpriority="high"
			/>
		)}

		{/* Video overlay (only if provided and size is full) */}
		{videoSrc && size === 'full' && (
			<video
				class="absolute inset-0 h-full w-full object-cover"
				width="1920"
				height="1080"
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
				loading="lazy"
			>
				<source src={videoSrc} type="video/mp4" />
			</video>
		)}

		{/* Theme-based overlay */}
		<div class={`pointer-events-none absolute inset-0 ${overlayClasses[theme]}`}></div>
		{/* Text readability gradient */}
		<div class={`pointer-events-none absolute inset-y-0 left-0 w-[min(80%,100vw)] sm:w-2/3 md:w-1/2 lg:w-[45%] ${fadeClasses[theme]}`}></div>
	</div>

	<div class={`relative mx-auto flex ${sizeClasses[size]} max-w-7xl items-center px-6`}>
		<div class="w-full max-w-xl py-24 md:py-28">
			{/* Kicker/Badge */}
			{kicker && (
				<p class={`mb-5 inline-flex items-center gap-2 rounded-full ${theme === 'dark' ? 'bg-white/10 text-white/90' : 'bg-brand-dark-charcoal/10 text-brand-dark-charcoal/90'} px-3.5 py-1.5 text-xs backdrop-blur`}>
					{kicker}
				</p>
			)}

			{/* Title */}
			<h1 class={`max-w-xl text-3xl font-light leading-tight tracking-tight sm:text-4xl md:text-5xl ${textClasses[theme]}`}>
				{titleHighlight && <span class="italic mr-2">{titleHighlight}</span>}
				<span class="font-semibold">{titleRest}</span>
			</h1>

			{/* Description */}
			{description && (
				<p class={`mt-5 max-w-prose text-sm md:text-base ${theme === 'dark' ? 'text-white/85' : 'text-brand-dark-charcoal/85'}`}>
					{description}
				</p>
			)}

			{/* CTA Buttons */}
			<div class="mt-7 flex flex-wrap gap-3">
				{ctaButtons.map((button) => (
					<Button
						variant={button.variant}
						href={button.href}
						size="lg"
					>
						{button.text}
					</Button>
				))}
			</div>
		</div>
	</div>
</section> 
