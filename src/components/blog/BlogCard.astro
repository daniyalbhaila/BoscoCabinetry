---
// Blog Article Card Component
// Used on the resources listing page

interface Props {
  title: string;
  description: string;
  category: string;
  publishDate: string;
  slug: string;
  featured?: boolean;
}

const { title, description, category, publishDate, slug, featured = false } = Astro.props;

const publishDateFormatted = new Date(publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<article class="group relative card-hover-elevate">
  <a
    href={`/resources/${slug}`}
    class="block rounded-2xl border border-brand-accent/40 gradient-card-light p-6 transition-all duration-300 hover:shadow-xl hover:border-brand-accent backdrop-blur-sm"
  >
    <!-- Featured Badge -->
    {featured && (
      <div class="mb-3">
        <span class="inline-flex items-center rounded-full bg-brand-primary/20 px-3 py-1 text-xs font-semibold text-brand-charcoal border border-brand-primary/20">
          Featured
        </span>
      </div>
    )}

    <!-- Category & Date -->
    <div class="flex items-center gap-3 mb-4 text-sm">
      <span class="inline-flex items-center rounded-full bg-brand-primary/15 px-3 py-1 font-semibold text-brand-charcoal border border-brand-primary/20">
        {category.charAt(0).toUpperCase() + category.slice(1)}
      </span>
      <span class="text-brand-darkGray font-medium">{publishDateFormatted}</span>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold text-brand-charcoal mb-3 group-hover:text-brand-primary transition-colors">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-brand-darkGray leading-relaxed mb-4 line-clamp-3">
      {description}
    </p>

    <!-- Read More Link -->
    <div class="flex items-center text-brand-primary font-bold group-hover:gap-2 transition-all">
      <span>Read Article</span>
      <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </div>
  </a>
</article>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
