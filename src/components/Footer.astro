---
import { companyInfo } from '../content/shared.ts';
import Facebook from './icons/Facebook.astro';
import Instagram from './icons/Instagram.astro';
import Linkedin from './icons/Linkedin.astro';
import Tiktok from './icons/Tiktok.astro';
import LogoSvg from '../assets/Logo-Light.svg?raw';
---
<footer class="relative isolate bg-brand-slate border-t border-white/10">
	<div class="mx-auto max-w-7xl px-6 py-16">
		<!-- Main Footer Content -->
		<div class="grid grid-cols-1 lg:grid-cols-5 gap-12 mb-12">
			<!-- Logo and Social Media Column -->
			<div class="lg:col-span-1">
				<a href="/" class="inline-block mb-6" aria-label="B3 Interiors Home">
					<div class="logo-svg w-[160px] h-[53px]" set:html={LogoSvg} />
				</a>
				<p class="text-white/70 text-sm mb-6">Luxury custom cabinetry and interiors for Toronto homes.</p>
				<div class="flex gap-3">
					<a
						href={companyInfo.social.facebook}
						target="_blank"
						rel="noopener noreferrer"
						class="w-10 h-10 rounded-full bg-white/10 hover:bg-brand-primary flex items-center justify-center transition-colors duration-200"
						aria-label="Follow us on Facebook"
					>
						<Facebook class="w-5 h-5 text-white" />
					</a>
					<a
						href={companyInfo.social.instagram}
						target="_blank"
						rel="noopener noreferrer"
						class="w-10 h-10 rounded-full bg-white/10 hover:bg-brand-primary flex items-center justify-center transition-colors duration-200"
						aria-label="Follow us on Instagram"
					>
						<Instagram class="w-5 h-5 text-white" />
					</a>
					<a
						href={companyInfo.social.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class="w-10 h-10 rounded-full bg-white/10 hover:bg-brand-primary flex items-center justify-center transition-colors duration-200"
						aria-label="Follow us on LinkedIn"
					>
						<Linkedin class="w-5 h-5 text-white" />
					</a>
					<a
						href={companyInfo.social.tiktok}
						target="_blank"
						rel="noopener noreferrer"
						class="w-10 h-10 rounded-full bg-white/10 hover:bg-brand-primary flex items-center justify-center transition-colors duration-200"
						aria-label="Follow us on TikTok"
					>
						<Tiktok class="w-5 h-5 text-white" />
					</a>
				</div>
			</div>

			<!-- Navigation Columns (4 columns on right) -->
			<div class="lg:col-span-4 grid grid-cols-2 md:grid-cols-4 gap-8">
				<div>
					<h4 class="text-white font-semibold mb-4">Services</h4>
					<div class="space-y-2 text-sm">
						<a href="/services/kitchen-cabinets" class="block text-white/70 hover:text-brand-primary transition-colors">Kitchen Renovation</a>
						<a href="/services/custom-closets" class="block text-white/70 hover:text-brand-primary transition-colors">Custom Closets</a>
						<a href="/services/built-ins" class="block text-white/70 hover:text-brand-primary transition-colors">Built-Ins</a>
						<a href="/services/full-home-cabinetry" class="block text-white/70 hover:text-brand-primary transition-colors">Whole-Home Interiors</a>
						<a href="/portfolio" class="block text-white/70 hover:text-brand-primary transition-colors">Project Gallery</a>
					</div>
				</div>
				<div>
					<h4 class="text-white font-semibold mb-4">Company</h4>
					<div class="space-y-2 text-sm">
						<a href="/about" class="block text-white/70 hover:text-brand-primary transition-colors">About Us</a>
						<a href="/sustainability" class="block text-white/70 hover:text-brand-primary transition-colors">Sustainability</a>
						<a href="/trade" class="block text-white/70 hover:text-brand-primary transition-colors">Trade Program</a>
						<a href="/blog" class="block text-white/70 hover:text-brand-primary transition-colors">B3 Blog</a>
						<a href="/#contact" class="block text-white/70 hover:text-brand-primary transition-colors">Contact</a>
					</div>
				</div>
				<div>
					<h4 class="text-white font-semibold mb-4">Discover</h4>
					<div class="space-y-2 text-sm">
						<a href="/services" class="block text-white/70 hover:text-brand-primary transition-colors">Services Overview</a>
						<a href="/#process" class="block text-white/70 hover:text-brand-primary transition-colors">Our Process</a>
						<a href="/#service-area" class="block text-white/70 hover:text-brand-primary transition-colors">Service Areas</a>
						<a href="/#faq" class="block text-white/70 hover:text-brand-primary transition-colors">FAQ</a>
						<a href={companyInfo.urls.googleReviews} target="_blank" rel="noopener noreferrer" class="block text-white/70 hover:text-brand-primary transition-colors">Customer Reviews</a>
					</div>
				</div>
				<div>
					<h4 class="text-white font-semibold mb-4">Get Started</h4>
				<div class="space-y-2 text-sm">
					<a href="/#contact" class="block text-white/70 hover:text-brand-primary transition-colors">Start a Project</a>
					<a href={companyInfo.urls.bookConsultation} class="block text-white/70 hover:text-brand-primary transition-colors" target="_blank" rel="noopener noreferrer">Book a Consultation</a>
					<a href={companyInfo.contact.phone.href} class="block text-white/70 hover:text-brand-primary transition-colors">Call {companyInfo.contact.phone.display}</a>
					<a href={companyInfo.contact.email.href} class="block text-white/70 hover:text-brand-primary transition-colors">{companyInfo.contact.email.address}</a>
				</div>
			</div>
		</div>
		</div>

		<!-- Bottom Brand Line -->
		<div class="pt-8 border-t border-white/10 text-center">
			<p class="text-white/60 text-sm">
				© 2025 B3 Interiors. Premium custom cabinetry for Toronto homes.
			</p>
		</div>
	</div>
</footer>
