---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutTrustHeader from '../components/AboutTrustHeader.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContentGrid from '../components/ContentGrid.astro';
import ExpandableContent from '../components/ExpandableContent.astro';
import ServiceAreaSection from '../components/ServiceAreaSection.astro';
import ShowroomHighlight from '../components/ShowroomHighlight.astro';
import Reviews from '../components/Reviews.astro';
import ContactUs from '../components/ContactUs.astro';
import { Image } from 'astro:assets';
import ShowroomImage from '../assets/showroom.jpg';

import { companyInfo, companyDescriptions, holikePartnership, sustainability } from '../content/shared.ts';
import { seoMetadata } from '../content/seo-metadata.ts';
import { organizationSchema, generateFAQSchema } from '../content/structured-data.ts';

// Import icons for "What Makes Us Different" section
import Sparkles from '../components/icons/Sparkles.astro';
import Building from '../components/icons/Building.astro';
import Check from '../components/icons/Check.astro';
import Trophy from '../components/icons/Trophy.astro';

// What Makes Us Different - 4 Pillars
const differentiators = [
  {
    title: 'Custom at Production Scale',
    description: 'Fully custom cabinetry with production-scale reliability. Direct manufacturer pricing without inflated custom shop markups.',
    iconComponent: Sparkles
  },
  {
    title: 'Complete Interior Solutions',
    description: 'Everything from one source: cabinetry, doors, paneling, countertops, and accessories. No more coordinating 5 different vendors.',
    iconComponent: Check
  },
  {
    title: '5,500 sq ft Showroom',
    description: 'See, touch, and compare 100+ finishes. Explore all our products in person with in-house designer consultations.',
    iconComponent: Building
  },
  {
    title: 'Sustainable Innovation',
    description: 'First to bring bamboo board and zero-VOC powder spray finishing to the Canadian market. CARB and EPA certified materials.',
    iconComponent: Trophy
  }
];

// FAQ data for schema generation
const aboutFAQs = [
  {
    question: "Does Bosco Cabinetry use sustainable materials?",
    answer: "Yes, we offer sustainable options across all our product lines. Our eco-friendly cabinets feature zero-added formaldehyde (NAF) materials certified by EPA, CARB, and Japanese F4 Star standards. We also offer sustainable bamboo boards with nano-clean air technology that purifies indoor air 24/7."
  },
  {
    question: "Where is Bosco Cabinetry located?",
    answer: `Our 5,500 sq ft showroom is located at ${companyInfo.location.address.full}. We serve Toronto, North York, Vaughan, Markham, Richmond Hill, Mississauga, Scarborough, Etobicoke, and the Greater Toronto Area.`
  },
  {
    question: "Who founded Bosco Cabinetry?",
    answer: "Bosco Cabinetry was founded by Toronto custom-home builders who've completed 100+ projects. We saw homeowners struggling to find affordable luxury kitchen cabinets and closet systems, so we created Bosco Cabinetry to bring builder-backed expertise and accessible prices to Toronto."
  }
];

// Generate FAQ schema
const faqStructuredData = generateFAQSchema(aboutFAQs);
---

<BaseLayout
  title={seoMetadata.about.title}
  description={seoMetadata.about.description}
  keywords={seoMetadata.about.keywords}
  ogImage={seoMetadata.about.ogImage}
>
  <!-- Header stays transparent on dark background -->
  <script slot="head">
    // This runs in <head> before body is parsed
    document.documentElement.classList.add('about-page');
  </script>
  <!-- Structured Data for SEO -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqStructuredData)} />

  <!-- Trust Header (No Hero) -->
  <AboutTrustHeader />

  <!-- Origin Story Section (Light theme) -->
  <SectionWrapper theme="light" id="origin-story">
    <div class="grid md:grid-cols-12 gap-12 items-center">
      <!-- Text Content -->
      <div class="md:col-span-7">
        <h2 class="text-3xl md:text-4xl font-bold text-brand-charcoal mb-6">
          We Built Custom Homes for Years.<br>
          Then We Saw Our Clients Struggling.
        </h2>

        <ExpandableContent contentId="origin-story">
          <!-- Preview Content (Always Visible) -->
          <div slot="preview">
            <p class="text-lg text-brand-darkGray mb-4">
              Every homeowner in Toronto faced the same impossible choices:
            </p>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start gap-3 text-brand-darkGray">
                <span class="text-brand-primary mt-1">→</span>
                <span>Overpriced luxury brands that broke budgets</span>
              </li>
              <li class="flex items-start gap-3 text-brand-darkGray">
                <span class="text-brand-primary mt-1">→</span>
                <span>Big-box cabinets that looked and felt cheap</span>
              </li>
              <li class="flex items-start gap-3 text-brand-darkGray">
                <span class="text-brand-primary mt-1">→</span>
                <span>Coordinating 5 different vendors—cabinets, doors, countertops, tile, hardware—with mismatched timelines and inflated middleman pricing</span>
              </li>
            </ul>
            <p class="text-lg text-brand-darkGray mb-4">
              We started Bosco Cabinetry focused on custom cabinetry with builder-backed expertise and direct manufacturer pricing.
            </p>
            <p class="text-lg text-brand-darkGray">
              Then our clients started asking: "Can you source the doors too? What about countertops?" We realized we could solve the ENTIRE coordination problem—not just part of it. Today, we provide complete interior solutions while maintaining our core expertise in custom cabinetry.
            </p>
          </div>

          <!-- Full Content (Hidden - SEO Optimized) -->
          <div slot="full">
            <h3 class="text-2xl font-bold text-brand-charcoal mb-4">
              From Renovation Contractors & Home Builders to Cabinetry Specialists
            </h3>
            <p class="text-brand-darkGray mb-4">
              After years as renovation contractors building custom homes across Toronto, North York, Vaughan, and the Greater Toronto Area (GTA), we saw a recurring problem: homeowners couldn't find affordable luxury cabinetry with quality cabinet hardware and interior design expertise that met their home improvement vision.
            </p>
            <p class="text-brand-darkGray mb-4">
              Traditional luxury kitchen cabinet brands in Toronto charged premium prices with little transparency. Big-box retailers offered cheap cabinets that compromised quality and lacked premium features like soft-close hinges and drawer organizers. Mid-range cabinet suppliers provided limited customization options.
            </p>
            <p class="text-brand-darkGray mb-4">
              We knew there was a better way. With our background as renovation contractors and custom home construction experts, we understood what Toronto homeowners truly needed: designer-quality kitchen cabinets with premium hardware, custom closet systems with soft-close drawer organizers, and built-in entertainment centers at fair, transparent prices.
            </p>
            <p class="text-brand-darkGray">
              Today, Bosco Cabinetry serves Toronto, North York, Scarborough, Etobicoke, Vaughan, Richmond Hill, Markham, and Mississauga from our 5,500 square foot showroom in North York. As the exclusive Canadian distributor of Holike—one of the world's largest cabinetry manufacturers—we bring Toronto homeowners globally-proven quality with local, personalized service.
            </p>
          </div>
        </ExpandableContent>
      </div>

      <!-- Image Content -->
      <div class="md:col-span-5">
        <div class="group card-hover-elevate">
          <div class="rounded-2xl border border-brand-accent/30 overflow-hidden shadow-xl">
            <Image
              src={ShowroomImage}
              alt="Bosco Cabinetry Toronto showroom design consultation"
              class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              format="webp"
              quality={80}
            />
          </div>
        </div>
      </div>
    </div>
  </SectionWrapper>

  <!-- What Makes Us Different (Dark theme) -->
  <SectionWrapper theme="dark" id="differentiators">
    <SectionHeader
      tag="Why Choose Bosco Cabinetry"
      title="What Makes Bosco Cabinetry Different"
      description="Four pillars that set us apart from other Toronto cabinet makers."
      layout="center"
      theme="dark"
    />
    <ContentGrid
      items={differentiators}
      variant="features"
      theme="dark"
    />
  </SectionWrapper>

  <!-- Holike Partnership Section (Light theme) -->
  <SectionWrapper theme="light" id="holike-partnership">
    <SectionHeader
      tag="Global Partnership"
      title="Powered by Global Excellence"
      description="Our partnership with Holike—an ISO-certified manufacturer with 22+ years of experience—lets us deliver custom quality with production-scale reliability, without the inflated pricing typical of custom shops."
      layout="center"
      theme="light"
    />

    <ExpandableContent contentId="holike-partnership">
      <!-- Preview Content (Always Visible) -->
      <div slot="preview">

        <!-- Stats Grid -->
        <div class="grid md:grid-cols-3 gap-8 mb-8">
          <div class="group card-hover-elevate">
            <div class="text-center p-6 rounded-2xl border border-brand-accent/30 gradient-card-light transition-all duration-300">
              <div class="text-3xl font-bold text-brand-primary mb-2">{holikePartnership.stats.showrooms}</div>
              <div class="text-brand-darkGray">Showrooms Globally</div>
            </div>
          </div>
          <div class="group card-hover-elevate">
            <div class="text-center p-6 rounded-2xl border border-brand-accent/30 gradient-card-light transition-all duration-300">
              <div class="text-3xl font-bold text-brand-primary mb-2">German</div>
              <div class="text-brand-darkGray">HOMAG Technology</div>
            </div>
          </div>
          <div class="group card-hover-elevate">
            <div class="text-center p-6 rounded-2xl border border-brand-accent/30 gradient-card-light transition-all duration-300">
              <div class="text-3xl font-bold text-brand-primary mb-2">{holikePartnership.stats.manufacturing}</div>
              <div class="text-brand-darkGray">Factory Space</div>
            </div>
          </div>
        </div>

        <div class="max-w-3xl mx-auto">
          <h3 class="text-xl font-semibold text-brand-charcoal mb-6 text-center">What this means for you</h3>
          <div class="grid md:grid-cols-2 gap-6">
            {holikePartnership.benefits.homeowners.map(benefit => (
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-primary/10 flex items-center justify-center mt-0.5">
                  <svg class="w-4 h-4 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
                <span class="text-brand-darkGray">{benefit}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Full Content (Hidden - SEO Optimized) -->
      <div slot="full">
        <h3 class="text-2xl font-bold text-brand-charcoal mb-4">
          Why We Partner with Holike for Toronto Cabinetry
        </h3>
        <p class="text-brand-darkGray mb-4">
          Holike Creative Home is a publicly-traded cabinetry manufacturer established in {holikePartnership.established}, with over 20 years of experience in custom kitchen cabinets, wardrobes, closet systems, and interior doors.
        </p>

        <h4 class="text-xl font-bold text-brand-charcoal mb-3">Global Manufacturing Excellence:</h4>
        <ul class="space-y-2 mb-6 text-brand-darkGray">
          <li>• {holikePartnership.stats.facilities} totaling {holikePartnership.stats.manufacturing}</li>
          <li>• {holikePartnership.stats.employees} employees</li>
          <li>• 90% German HOMAG production equipment</li>
          <li>• Production capacity: {holikePartnership.stats.production.kitchens} kitchen sets/day, {holikePartnership.stats.production.wardrobes} wardrobes/day</li>
          <li>• {holikePartnership.stats.showrooms} brand showrooms established globally</li>
          <li>• Primary markets: {holikePartnership.stats.markets.join(', ')}</li>
        </ul>

        <h4 class="text-xl font-bold text-brand-charcoal mb-3">Quality Certifications:</h4>
        <ul class="space-y-2 mb-6 text-brand-darkGray">
          {holikePartnership.certifications.map(cert => (
            <li>• {cert} certified</li>
          ))}
          <li>• 5-year warranty on all products</li>
        </ul>

        <p class="text-brand-darkGray mb-4">
          By partnering with Holike, Bosco Cabinetry brings Toronto homeowners access to world-class custom cabinetry manufacturing at accessible prices—without sacrificing quality, sustainability, or design flexibility.
        </p>
        <p class="text-brand-darkGray">
          Whether you're renovating a kitchen in downtown Toronto, designing a custom closet system in North York, or building a new home in Vaughan, you benefit from global manufacturing scale with local, personalized service.
        </p>

        <div class="mt-8 p-6 rounded-2xl border border-brand-accent/30 gradient-card-light">
          <p class="text-brand-charcoal font-medium">
            <strong>Builders & Designers:</strong> Interested in partnering with us as the exclusive Holike distributor?
            <a href="/trade" class="text-brand-primary hover:underline ml-2">Learn about trade partnership →</a>
          </p>
        </div>
      </div>
    </ExpandableContent>
  </SectionWrapper>

  <!-- Sustainability Section (Dark theme) -->
  <SectionWrapper theme="dark" id="sustainability">
    <SectionHeader
      tag="Eco-Friendly"
      title="Our Commitment to Sustainable Cabinetry"
      description="Beautiful design can be eco-friendly. From materials to craftsmanship, we create stylish custom kitchen cabinets that are kind to the environment and your Toronto home."
      layout="center"
      theme="dark"
    />

    <ExpandableContent contentId="sustainability">
      <!-- Preview Content (Always Visible) -->
      <div slot="preview">
        <div class="grid md:grid-cols-2 gap-12 mb-8">
          <!-- NAF Materials -->
          <div>
            <h3 class="text-2xl font-bold text-white mb-4">{sustainability.naf.title}</h3>
            <p class="text-gray-300 mb-4">
              {sustainability.naf.description}
            </p>
            <div class="flex flex-wrap gap-3">
              {sustainability.naf.certifications.map(cert => (
                <span class="px-4 py-2 bg-brand-primary/20 text-brand-accent rounded-full text-sm font-medium">
                  {cert}
                </span>
              ))}
            </div>
          </div>

          <!-- Bamboo Technology -->
          <div>
            <h3 class="text-2xl font-bold text-white mb-4">{sustainability.bamboo.title}</h3>
            <p class="text-gray-300 mb-4">
              {sustainability.bamboo.description}
            </p>
            <ul class="space-y-2 text-gray-300">
              {sustainability.bamboo.benefits.slice(0, 3).map(benefit => (
                <li class="flex items-start gap-2">
                  <span class="text-brand-accent mt-1">•</span>
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Full Content (Hidden - SEO Optimized) -->
      <div slot="full">
        <h3 class="text-2xl font-bold text-white mb-4">Sustainable Kitchen Cabinets for Toronto Homes</h3>

        <h4 class="text-xl font-bold text-white mb-3">Why Zero-Added Formaldehyde (NAF) Matters</h4>
        <p class="text-gray-300 mb-4">
          Traditional kitchen cabinets and closet systems use adhesives containing formaldehyde—a harmful chemical that emits VOCs (volatile organic compounds) into your Toronto home's indoor air for years after installation.
        </p>
        <p class="text-gray-300 mb-4">
          Bosco Cabinetry prioritizes materials that protect both your health and the environment. We offer sustainable options across all our product lines, featuring special adhesives that contain no added formaldehyde (NAF) for healthier indoor air quality.
        </p>
        <p class="text-gray-300 mb-6">
          Our NAF materials meet strict safety standards set by: U.S. Environmental Protection Agency (EPA), California Air Resources Board (CARB), and Japanese F4 Star certification. This ensures your Toronto home, whether in North York, Scarborough, or Vaughan, stays free from harmful emissions.
        </p>

        <h4 class="text-xl font-bold text-white mb-3">Bamboo Board Technology: Sustainable + Air-Purifying</h4>
        <p class="text-gray-300 mb-4">
          While materials like MDF, plywood, and particle board are part of our offerings for affordable custom cabinetry, our bamboo boards are a real game-changer for eco-conscious Toronto homeowners.
        </p>
        <div class="rounded-2xl border border-white/20 gradient-card-dark p-6 mb-6">
          <p class="text-white font-medium mb-3">Why Bamboo?</p>
          <ul class="space-y-2 text-gray-300">
            {sustainability.bamboo.benefits.map(benefit => (
              <li class="flex items-start gap-2">
                <span class="text-brand-accent">•</span>
                <span>{benefit}</span>
              </li>
            ))}
          </ul>
        </div>

        <h4 class="text-xl font-bold text-white mb-3">{sustainability.nanoClean.title}</h4>
        <p class="text-gray-300 mb-4">
          {sustainability.nanoClean.description}
        </p>
        <ul class="space-y-2 text-gray-300 mb-6">
          {sustainability.nanoClean.features.map(feature => (
            <li class="flex items-start gap-2">
              <span class="text-brand-accent">✓</span>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
        <p class="text-gray-300 mb-6">
          {sustainability.nanoClean.howItWorks}
        </p>

        <h4 class="text-xl font-bold text-white mb-3">{sustainability.sourcing.title}</h4>
        <p class="text-gray-300 mb-4">
          {sustainability.sourcing.description}
        </p>
        <p class="text-gray-300">
          {sustainability.sourcing.commitment}
        </p>
        <p class="text-gray-300 mt-4">
          By choosing Bosco Cabinetry for your custom kitchen cabinets, closet systems, or built-in units, you are not just investing in beautiful, high-quality furniture—you are also helping to build a more sustainable future for both your Toronto family and the planet.
        </p>

        <!-- Certification Badges -->
        <div class="mt-8 flex flex-wrap gap-4 justify-center">
          {holikePartnership.certifications.map(cert => (
            <div class="group card-hover-elevate">
              <div class="px-6 py-3 rounded-xl border border-white/20 gradient-card-dark text-center transition-all duration-300">
                <span class="text-white font-medium">{cert}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </ExpandableContent>
  </SectionWrapper>

  <!-- Showroom Section (Light theme) -->
  <ShowroomHighlight theme="light" />

  <!-- Service Areas Section (Dark theme) -->
  <SectionWrapper theme="dark" id="service-areas">
    <ServiceAreaSection
      theme="dark"
      title="Serving Toronto & the GTA"
      description="Bosco Cabinetry proudly serves homeowners, builders, and designers across the Greater Toronto Area with custom kitchen cabinets, closet systems, bathroom vanities, and built-in cabinetry."
      cities={companyInfo.serviceAreas}
      showCTA={true}
      expandableContent={companyDescriptions.serviceAreaExpanded}
      expandableContentId="about-service-areas"
    />
  </SectionWrapper>

  <!-- Social Proof / Reviews (Light theme) -->
  <Reviews theme="light" />

  <!-- Contact Section (Dark theme) -->
  <ContactUs />
</BaseLayout>
