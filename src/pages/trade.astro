---
import BaseLayout from '../layouts/BaseLayout.astro';
import TradeHero from '../components/TradeHero.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContentGrid from '../components/ContentGrid.astro';
import TradeAccountBenefits from '../components/TradeAccountBenefits.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import ProcessSection from '../components/ProcessSection.astro';
import FAQSection from '../components/FAQSection.astro';
import DesignInspiration from '../components/DesignInspiration.astro';
import ContactUs from '../components/ContactUs.astro';
import ExpandableContent from '../components/ExpandableContent.astro';
import ServiceAreaSection from '../components/ServiceAreaSection.astro';
import Button from '../components/ui/Button.astro';
import Check from '../components/icons/Check.astro';
import Factory from '../components/icons/Factory.astro';
import Award from '../components/icons/Award.astro';
import Globe from '../components/icons/Globe.astro';
import TrendingUp from '../components/icons/TrendingUp.astro';
import DollarSign from '../components/icons/DollarSign.astro';
import Clock from '../components/icons/Clock.astro';
import Palette from '../components/icons/Palette.astro';
import ShieldCheck from '../components/icons/ShieldCheck.astro';
import TradeAdvantages from '../components/TradeAdvantages.astro';
import { tradePageContent } from '../content/pages/trade.ts';
import { seoMetadata } from '../content/seo-metadata.ts';
import showroomImage from '../assets/showroom.jpg';
import kitchenImage from '../assets/kitchen.jpg';

// Icon mapping for manufacturing features
const iconMap: Record<string, any> = {
	factory: Factory,
	certificate: Award,
	globe: Globe,
	trending: TrendingUp
};

// Icon mapping for trade advantages
const advantageIconMap: Record<string, any> = {
	'dollar-sign': DollarSign,
	'clock': Clock,
	'palette': Palette,
	'shield-check': ShieldCheck
};

// Transform trade advantages with icon components
const tradeAdvantages = tradePageContent.tradeAdvantages.advantages.map(advantage => ({
	title: advantage.title,
	description: advantage.description,
	icon: advantageIconMap[advantage.icon]
}));
---

<BaseLayout
	title={seoMetadata.trade.title}
	description={seoMetadata.trade.description}
	keywords={seoMetadata.trade.keywords}
	ogImage={seoMetadata.trade.ogImage}
>
	<!-- Hero Section -->
	<TradeHero
		title={tradePageContent.hero.title}
		subtitle={tradePageContent.hero.subtitle}
		stats={tradePageContent.hero.stats}
		ctaButtons={tradePageContent.hero.ctaButtons}
		backgroundImage={showroomImage}
	/>

	<!-- Manufacturing Credibility Section -->
	<SectionWrapper theme="light" id="manufacturing">
		<SectionHeader
			tag={tradePageContent.manufacturing.tag}
			title={tradePageContent.manufacturing.title}
			description={tradePageContent.manufacturing.description}
			layout="center"
			theme="light"
		/>
		<ContentGrid
			items={tradePageContent.manufacturing.features.map(feature => ({
				title: feature.title,
				description: feature.points.join(' • '),
				iconComponent: iconMap[feature.icon]
			}))}
			variant="features"
		/>
	</SectionWrapper>

	<!-- Trade Advantages Section -->
	<TradeAdvantages
		tag={tradePageContent.tradeAdvantages.tag}
		title={tradePageContent.tradeAdvantages.title}
		description={tradePageContent.tradeAdvantages.description}
		advantages={tradeAdvantages}
	/>

	<!-- Trade Account Benefits Section -->
	<SectionWrapper theme="light" id="trade-account">
		<TradeAccountBenefits
			tag={tradePageContent.accountBenefits.tag}
			title={tradePageContent.accountBenefits.title}
			benefits={tradePageContent.accountBenefits.benefits}
			ctaCard={tradePageContent.accountBenefits.ctaCard}
			theme="light"
		/>
	</SectionWrapper>

	<!-- Product Collections Showcase -->
	<SectionWrapper theme="dark" id="collections">
		<SectionHeader
			tag={tradePageContent.productShowcase.tag}
			title={tradePageContent.productShowcase.title}
			description={tradePageContent.productShowcase.description}
			layout="center"
			theme="dark"
		/>
		<ProductShowcase collections={tradePageContent.productShowcase.collections} theme="dark" />

		<!-- Catalog Download CTA -->
		<div class="mt-12 text-center">
			<Button variant="primary" size="lg" href="#catalog">
				{tradePageContent.productShowcase.catalogCta}
			</Button>
		</div>
	</SectionWrapper>

	<!-- Service Area Section with Progressive Disclosure -->
	<SectionWrapper theme="light" id="service-area">
		<ServiceAreaSection
			theme="light"
			tag={tradePageContent.serviceArea.tag}
			title={tradePageContent.serviceArea.title}
			description={tradePageContent.serviceArea.description}
			cities={tradePageContent.serviceArea.cities}
			showCTA={true}
			highlights={tradePageContent.serviceArea.serviceHighlights}
			expandableContent={tradePageContent.serviceArea.expandedContent}
			expandableContentId="trade-service-area"
			expandablePreviewText="Learn more about our comprehensive trade coverage across the GTA..."
		/>
	</SectionWrapper>

	<!-- Process Section -->
	<ProcessSection
		theme="light"
		tag={tradePageContent.process.tag}
		title={tradePageContent.process.title}
		description={tradePageContent.process.description}
		steps={tradePageContent.process.steps}
	/>

	<!-- FAQ Section -->
	<FAQSection
		theme="dark"
		tag={tradePageContent.faqs.tag}
		title={tradePageContent.faqs.title}
		description={tradePageContent.faqs.description}
		items={tradePageContent.faqs.questions}
	/>

	<!-- Trade Catalog Download (Lead Magnet) -->
	<SectionWrapper theme="light" id="catalog">
		<div class="mx-auto max-w-7xl">
			<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
				<!-- Left Content -->
				<div>
					<p class="mb-4 text-[11px] uppercase tracking-[0.2em] text-brand-primary">[{tradePageContent.catalogDownload.tag}]</p>
					<h2 class="mb-6 text-3xl font-semibold tracking-tight text-brand-charcoal sm:text-4xl md:text-5xl">
						{tradePageContent.catalogDownload.title}
					</h2>
					<p class="mb-8 text-lg text-brand-darkGray">
						{tradePageContent.catalogDownload.description}
					</p>

					<!-- Benefits List -->
					<div class="space-y-4">
						{tradePageContent.catalogDownload.benefits.map((benefit) => (
							<div class="flex items-start gap-3">
								<div class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-brand-primary/10">
									<svg class="h-3 w-3 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
									</svg>
								</div>
								<p class="text-brand-darkGray">{benefit}</p>
							</div>
						))}
					</div>
				</div>

				<!-- Right Form -->
				<div class="lg:pl-8">
					<div class="gradient-card-light rounded-2xl border border-brand-accent/40 p-8 shadow-lg">
						<div class="mb-6 text-center">
							<div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-xl bg-brand-primary/10">
								<svg class="h-8 w-8 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
								</svg>
							</div>
							<h3 class="mb-2 text-xl font-semibold text-brand-charcoal">
								Download Trade Catalog
							</h3>
							<p class="text-sm text-brand-darkGray">
								Get instant access to our complete product catalog.
							</p>
						</div>

						<!-- Form -->
						<form
							name={tradePageContent.catalogDownload.formName}
							method="POST"
							action="/thank-you"
							data-netlify="true"
							netlify-honeypot="bot-field"
							class="space-y-4"
						>
							<!-- Required hidden fields for Netlify Forms -->
							<input type="hidden" name="form-name" value={tradePageContent.catalogDownload.formName} />

							<!-- Honeypot field for spam protection -->
							<p class="hidden">
								<label>
									Don't fill this out if you're human:
									<input name="bot-field" tabindex="-1" autocomplete="off" />
								</label>
							</p>

							<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
								<div>
									<label for="firstName" class="form-label-light">
										First Name *
									</label>
									<input
										type="text"
										id="firstName"
										name="firstName"
										required
										class="form-input-light"
										placeholder="John"
									/>
								</div>
								<div>
									<label for="lastName" class="form-label-light">
										Last Name *
									</label>
									<input
										type="text"
										id="lastName"
										name="lastName"
										required
										class="form-input-light"
										placeholder="Smith"
									/>
								</div>
							</div>

							<div>
								<label for="company" class="form-label-light">
									Company Name *
								</label>
								<input
									type="text"
									id="company"
									name="company"
									required
									class="form-input-light"
									placeholder="Your Company"
								/>
							</div>

							<div>
								<label for="email" class="form-label-light">
									Email Address *
								</label>
								<input
									type="email"
									id="email"
									name="email"
									required
									class="form-input-light"
									placeholder="john@company.com"
								/>
							</div>

							<div>
								<label for="phone" class="form-label-light">
									Phone
								</label>
								<input
									type="tel"
									id="phone"
									name="phone"
									class="form-input-light"
									placeholder="(416) 555-1234"
								/>
							</div>

							<div>
								<label for="businessType" class="form-label-light">
									Business Type *
								</label>
								<select
									id="businessType"
									name="businessType"
									required
									class="form-select-light"
								>
									<option value="">Select business type</option>
									<option value="contractor">General Contractor</option>
									<option value="builder">Builder/Developer</option>
									<option value="designer">Interior Designer</option>
									<option value="architect">Architect</option>
									<option value="other">Other</option>
								</select>
							</div>

							<div>
								<label for="projectVolume" class="form-label-light">
									Annual Project Volume
								</label>
								<select
									id="projectVolume"
									name="projectVolume"
									class="form-select-light"
								>
									<option value="">Select volume</option>
									<option value="1-5">1-5 projects/year</option>
									<option value="6-10">6-10 projects/year</option>
									<option value="11-20">11-20 projects/year</option>
									<option value="20+">20+ projects/year</option>
								</select>
							</div>

							<Button
								type="submit"
								variant="primary"
								size="lg"
								class="w-full"
							>
								Download Catalog
							</Button>
						</form>

						<p class="mt-4 text-center text-xs text-brand-darkGray">
							We respect your privacy. Unsubscribe at any time.
						</p>
					</div>
				</div>
			</div>
		</div>
	</SectionWrapper>

	<!-- Final CTA Section -->
	<SectionWrapper theme="dark" id="final-cta">
		<div class="mx-auto max-w-5xl text-center">
			<h2 class="mb-6 text-3xl font-semibold text-white md:text-4xl">
				{tradePageContent.finalCta.title}
			</h2>
			<p class="mb-12 text-lg text-white/80">
				{tradePageContent.finalCta.description}
			</p>

			<div class="grid grid-cols-1 gap-8 md:grid-cols-2">
				<!-- Primary CTA Card -->
				<div class="rounded-2xl border border-brand-primary/30 gradient-card-dark backdrop-blur-sm p-8">
					<h3 class="mb-4 text-xl font-semibold text-white">
						{tradePageContent.finalCta.primaryAction.title}
					</h3>
					<ul class="mb-6 space-y-3 text-left">
						{tradePageContent.finalCta.primaryAction.points.map((point) => (
							<li class="flex items-start gap-3">
								<span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-accent"></span>
								<span class="text-white/80">{point}</span>
							</li>
						))}
					</ul>
					<Button
						variant="primary"
						size="lg"
						href={tradePageContent.finalCta.primaryAction.button.href}
						class="w-full"
					>
						{tradePageContent.finalCta.primaryAction.button.text}
					</Button>
				</div>

				<!-- Secondary CTA Card -->
				<div class="rounded-2xl border border-brand-primary/30 gradient-card-dark backdrop-blur-sm p-8">
					<h3 class="mb-4 text-xl font-semibold text-white">
						{tradePageContent.finalCta.secondaryAction.title}
					</h3>
					<ul class="mb-6 space-y-3 text-left">
						{tradePageContent.finalCta.secondaryAction.points.map((point) => (
							<li class="flex items-start gap-3">
								<span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-accent"></span>
								<span class="text-white/80">{point}</span>
							</li>
						))}
					</ul>
					<Button
						variant="outline"
						size="lg"
						href={tradePageContent.finalCta.secondaryAction.button.href}
						class="w-full"
					>
						{tradePageContent.finalCta.secondaryAction.button.text}
					</Button>
				</div>
			</div>
		</div>
	</SectionWrapper>

	<!-- Contact Section -->
	<ContactUs />
</BaseLayout>
