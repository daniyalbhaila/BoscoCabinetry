---
import BaseLayout from '../layouts/BaseLayout.astro';
import TradeHero from '../components/TradeHero.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContentGrid from '../components/ContentGrid.astro';
import TradeAccountBenefits from '../components/TradeAccountBenefits.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import ProcessSection from '../components/ProcessSection.astro';
import FAQSection from '../components/FAQSection.astro';
import DesignInspiration from '../components/DesignInspiration.astro';
import ContactUs from '../components/ContactUs.astro';
import ExpandableContent from '../components/ExpandableContent.astro';
import ServiceAreaSection from '../components/ServiceAreaSection.astro';
import Button from '../components/ui/Button.astro';
import Check from '../components/icons/Check.astro';
import Factory from '../components/icons/Factory.astro';
import Award from '../components/icons/Award.astro';
import Globe from '../components/icons/Globe.astro';
import TrendingUp from '../components/icons/TrendingUp.astro';
import DollarSign from '../components/icons/DollarSign.astro';
import Clock from '../components/icons/Clock.astro';
import Palette from '../components/icons/Palette.astro';
import ShieldCheck from '../components/icons/ShieldCheck.astro';
import Wind from '../components/icons/Wind.astro';
import Leaf from '../components/icons/Leaf.astro';
import TradeAdvantages from '../components/TradeAdvantages.astro';
import { tradePageContent } from '../content/pages/trade.ts';
import { seoMetadata } from '../content/seo-metadata.ts';
import showroomImage from '../assets/showroom.jpg';
import kitchenImage from '../assets/kitchen.jpg';

// Icon mapping for manufacturing features
const iconMap: Record<string, any> = {
	factory: Factory,
	certificate: Award,
	globe: Globe,
	trending: TrendingUp,
	wind: Wind,
	leaf: Leaf,
	'shield-check': ShieldCheck,
	award: Award
};

// Icon mapping for trade advantages
const advantageIconMap: Record<string, any> = {
	'dollar-sign': DollarSign,
	'clock': Clock,
	'palette': Palette,
	'shield-check': ShieldCheck
};

// Transform trade advantages with icon components
const tradeAdvantages = tradePageContent.tradeAdvantages.advantages.map(advantage => ({
	title: advantage.title,
	description: advantage.description,
	icon: advantageIconMap[advantage.icon]
}));
---

<BaseLayout
	title={seoMetadata.trade.title}
	description={seoMetadata.trade.description}
	keywords={seoMetadata.trade.keywords}
	ogImage={seoMetadata.trade.ogImage}
>
	<!-- Hero Section -->
	<TradeHero
		title={tradePageContent.hero.title}
		subtitle={tradePageContent.hero.subtitle}
		stats={tradePageContent.hero.stats}
		ctaButtons={tradePageContent.hero.ctaButtons}
		backgroundImage={showroomImage}
	/>

	<!-- Manufacturing Credibility Section -->
	<SectionWrapper theme="light" id="manufacturing">
		<SectionHeader
			tag={tradePageContent.manufacturing.tag}
			title={tradePageContent.manufacturing.title}
			description={tradePageContent.manufacturing.description}
			layout="center"
			theme="light"
		/>
		<ContentGrid
			items={tradePageContent.manufacturing.features.map(feature => ({
				title: feature.title,
				description: feature.points.join(' • '),
				iconComponent: iconMap[feature.icon]
			}))}
			variant="features"
			theme="light"
		/>
	</SectionWrapper>

	<!-- Environmental Features Section -->
	<SectionWrapper theme="dark" id="environmental">
		<SectionHeader
			tag={tradePageContent.environmental.tag}
			title={tradePageContent.environmental.title}
			description={tradePageContent.environmental.description}
			layout="center"
			theme="dark"
		/>
		<ContentGrid
			items={tradePageContent.environmental.features.map(feature => ({
				title: feature.title,
				description: feature.description,
				iconComponent: iconMap[feature.icon]
			}))}
			variant="features"
			theme="dark"
		/>

		<!-- Simple, focused CTA -->
		<div class="text-center mt-12">
			<Button
				variant="primary"
				size="lg"
				href={tradePageContent.environmental.ctaHref}
			>
				{tradePageContent.environmental.ctaText}
			</Button>
		</div>
	</SectionWrapper>

	<!-- Trade Advantages Section -->
	<TradeAdvantages
		tag={tradePageContent.tradeAdvantages.tag}
		title={tradePageContent.tradeAdvantages.title}
		description={tradePageContent.tradeAdvantages.description}
		advantages={tradeAdvantages}
	/>

	<!-- Trade Account Benefits Section -->
	<SectionWrapper theme="dark" id="trade-account">
		<TradeAccountBenefits
			tag={tradePageContent.accountBenefits.tag}
			title={tradePageContent.accountBenefits.title}
			benefits={tradePageContent.accountBenefits.benefits}
			ctaCard={tradePageContent.accountBenefits.ctaCard}
			theme="dark"
		/>
	</SectionWrapper>

	<!-- Product Collections Showcase -->
	<SectionWrapper theme="light" id="collections">
		<SectionHeader
			tag={tradePageContent.productShowcase.tag}
			title={tradePageContent.productShowcase.title}
			description={tradePageContent.productShowcase.description}
			layout="center"
			theme="light"
		/>
		<ProductShowcase collections={tradePageContent.productShowcase.collections} theme="light" />
	</SectionWrapper>

	<!-- Materials & Finishes Section -->
	<SectionWrapper theme="dark" id="materials">
		<SectionHeader
			tag={tradePageContent.materials.tag}
			title={tradePageContent.materials.title}
			description={tradePageContent.materials.description}
			layout="center"
			theme="dark"
		/>

		<div class="mx-auto max-w-5xl">
			<div class="grid grid-cols-1 gap-12 md:grid-cols-2">
				<!-- Base Materials -->
				<div class="gradient-card-dark rounded-2xl border border-brand-primary/30 p-8 backdrop-blur-sm">
					<h3 class="mb-6 text-xl font-semibold text-white">
						{tradePageContent.materials.baseMaterials.title}
					</h3>
					<ul class="space-y-3">
						{tradePageContent.materials.baseMaterials.options.map((material) => (
							<li class="flex items-start gap-3">
								<div class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-brand-accent/20">
									<Check class="h-3.5 w-3.5 text-brand-accent" />
								</div>
								<span class="text-white/90">{material}</span>
							</li>
						))}
					</ul>
				</div>

				<!-- Finishing Materials -->
				<div class="gradient-card-dark rounded-2xl border border-brand-primary/30 p-8 backdrop-blur-sm">
					<h3 class="mb-6 text-xl font-semibold text-white">
						{tradePageContent.materials.finishingMaterials.title}
					</h3>
					<ul class="space-y-3">
						{tradePageContent.materials.finishingMaterials.options.map((finish) => (
							<li class="flex items-start gap-3">
								<div class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-brand-accent/20">
									<Check class="h-3.5 w-3.5 text-brand-accent" />
								</div>
								<span class="text-white/90">{finish}</span>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</SectionWrapper>

	<!-- Service Area Section with Progressive Disclosure -->
	<SectionWrapper theme="light" id="service-area">
		<ServiceAreaSection
			theme="light"
			tag={tradePageContent.serviceArea.tag}
			title={tradePageContent.serviceArea.title}
			description={tradePageContent.serviceArea.description}
			cities={tradePageContent.serviceArea.cities}
			showCTA={true}
			highlights={tradePageContent.serviceArea.serviceHighlights}
			expandableContent={tradePageContent.serviceArea.expandedContent}
			expandableContentId="trade-service-area"
			expandablePreviewText="Learn more about our comprehensive trade coverage across the GTA..."
		/>
	</SectionWrapper>

	<!-- Process Section -->
	<ProcessSection
		theme="dark"
		tag={tradePageContent.process.tag}
		title={tradePageContent.process.title}
		description={tradePageContent.process.description}
		steps={tradePageContent.process.steps}
	/>

	<!-- FAQ Section -->
	<FAQSection
		theme="light"
		tag={tradePageContent.faqs.tag}
		title={tradePageContent.faqs.title}
		description={tradePageContent.faqs.description}
		items={tradePageContent.faqs.questions}
	/>

	<!-- Final CTA Section -->
	<SectionWrapper theme="dark" id="final-cta">
		<div class="mx-auto max-w-5xl text-center">
			<h2 class="mb-6 text-3xl font-semibold text-white md:text-4xl">
				{tradePageContent.finalCta.title}
			</h2>
			<p class="mb-12 text-lg text-white/80">
				{tradePageContent.finalCta.description}
			</p>

			<div class="grid grid-cols-1 gap-8 md:grid-cols-2">
				<!-- Primary CTA Card -->
				<div class="rounded-2xl border border-brand-primary/30 gradient-card-dark backdrop-blur-sm p-8">
					<h3 class="mb-4 text-xl font-semibold text-white">
						{tradePageContent.finalCta.primaryAction.title}
					</h3>
					<ul class="mb-6 space-y-3 text-left">
						{tradePageContent.finalCta.primaryAction.points.map((point) => (
							<li class="flex items-start gap-3">
								<span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-accent"></span>
								<span class="text-white/80">{point}</span>
							</li>
						))}
					</ul>
					<Button
						variant="primary"
						size="lg"
						href={tradePageContent.finalCta.primaryAction.button.href}
						class="w-full"
					>
						{tradePageContent.finalCta.primaryAction.button.text}
					</Button>
				</div>

				<!-- Secondary CTA Card -->
				<div class="rounded-2xl border border-brand-primary/30 gradient-card-dark backdrop-blur-sm p-8">
					<h3 class="mb-4 text-xl font-semibold text-white">
						{tradePageContent.finalCta.secondaryAction.title}
					</h3>
					<ul class="mb-6 space-y-3 text-left">
						{tradePageContent.finalCta.secondaryAction.points.map((point) => (
							<li class="flex items-start gap-3">
								<span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-accent"></span>
								<span class="text-white/80">{point}</span>
							</li>
						))}
					</ul>
					<Button
						variant="outline"
						size="lg"
						href={tradePageContent.finalCta.secondaryAction.button.href}
						class="w-full"
					>
						{tradePageContent.finalCta.secondaryAction.button.text}
					</Button>
				</div>
			</div>
		</div>
	</SectionWrapper>

	<!-- Contact Section -->
	<ContactUs />
</BaseLayout>
