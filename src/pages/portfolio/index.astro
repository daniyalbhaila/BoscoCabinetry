---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionWrapper from '../../components/SectionWrapper.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ContactUs from '../../components/ContactUs.astro';
import { seoMetadata } from '../../content/seo-metadata';

// Import portfolio featured images directly for production reliability
import bathroomGrandHighland from '../../assets/Portfolio/Bathroom_GrandHighland/IMG_0089.JPG';
import fullhomeRobina from '../../assets/Portfolio/FullHome_Robina/1(a).jpg';
import kitchenBurningOak from '../../assets/Portfolio/Kitchen_BurningOak/IMG_6736.jpg';
import kitchenDanLeckie from '../../assets/Portfolio/Kitchen_DanLekcie/IMG_9931.JPG';
import mediawallThorold from '../../assets/Portfolio/MediaWall_Thorold/IMG_0149.jpg';

// Get all portfolio projects
const allProjects = await getCollection('portfolio');

// Sort projects: featured first, then by title alphabetically
const sortedProjects = allProjects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return a.data.title.localeCompare(b.data.title);
});

// Map project slugs to imported images
const imageMap: Record<string, any> = {
  'bathroom-grand-highland': bathroomGrandHighland,
  'fullhome-robina': fullhomeRobina,
  'kitchen-burning-oak': kitchenBurningOak,
  'kitchen-dan-leckie': kitchenDanLeckie,
  'mediawall-thorold': mediawallThorold,
};

// Add images to projects
const projectsWithImages = sortedProjects.map((project) => ({
  ...project,
  image: imageMap[project.slug],
})).filter(p => p.image); // Only include projects with valid images

---

<BaseLayout
  title={seoMetadata.portfolio.title}
  description={seoMetadata.portfolio.description}
  keywords={seoMetadata.portfolio.keywords}
  ogImage={seoMetadata.portfolio.ogImage}
>

  <SectionWrapper theme="dark" id="portfolio-projects">
    <SectionHeader
      tag="Our Work"
      title="Portfolio"
      description="Explore our collection of custom cabinetry projects across the Greater Toronto Area."
      layout="center"
      theme="dark"
    />

    <!-- Portfolio Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projectsWithImages.map((project) => (
        <ProjectCard
          title={project.data.title}
          slug={project.slug}
          category={project.data.category}
          featuredImage={project.image}
          location={project.data.location}
        />
      ))}
    </div>

    {/* Show message if no projects found */}
    {projectsWithImages.length === 0 && (
      <div class="text-center py-12">
        <p class="text-gray-600 text-lg">
          More projects coming soon! Check back later to see our latest work.
        </p>
      </div>
    )}
  </SectionWrapper>

  <ContactUs />

</BaseLayout>
