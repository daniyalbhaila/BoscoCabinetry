---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionWrapper from '../../components/SectionWrapper.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ContactUs from '../../components/ContactUs.astro';
import PortfolioFilterWrapper from '../../components/PortfolioFilterWrapper';
import { seoMetadata } from '../../content/seo-metadata';
import { featuredImages } from '../../lib/portfolioImages';

// Get all portfolio projects
const allProjects = await getCollection('portfolio');

// Sort projects: by custom order if specified, then featured, then alphabetically
const sortedProjects = allProjects.sort((a, b) => {
  // First, sort by order if both have order values
  if (a.data.order !== undefined && b.data.order !== undefined) {
    return a.data.order - b.data.order;
  }
  // If only one has order, prioritize it
  if (a.data.order !== undefined) return -1;
  if (b.data.order !== undefined) return 1;

  // Fall back to featured status
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;

  // Finally, sort alphabetically
  return a.data.title.localeCompare(b.data.title);
});

// Add images to projects using centralized mapping
const projectsWithImages = sortedProjects.map((project) => ({
  ...project,
  image: featuredImages[project.slug],
})).filter(p => p.image); // Only include projects with valid images

// Define filter categories
const filterCategories = [
  { id: 'all', label: 'All Projects' },
  { id: 'full-home', label: 'Custom Home' },
  { id: 'kitchen', label: 'Kitchen' },
  { id: 'bathroom', label: 'Bathroom' },
  { id: 'closet', label: 'Closet' },
  { id: 'built-in', label: 'Built-In' },
  { id: 'media-wall', label: 'Media Wall' },
  { id: 'basement', label: 'Basement' },
];

---

<BaseLayout
  title={seoMetadata.portfolio.title}
  description={seoMetadata.portfolio.description}
  keywords={seoMetadata.portfolio.keywords}
  ogImage={seoMetadata.portfolio.ogImage}
>

  <SectionWrapper theme="dark" id="portfolio-projects" animate={false}>
    <SectionHeader
      tag="Our Work"
      title="Portfolio"
      description="Explore our collection of custom cabinetry projects across the Greater Toronto Area."
      layout="center"
      theme="dark"
      animate={false}
    />

    <!-- Portfolio Filter -->
    <PortfolioFilterWrapper categories={filterCategories} client:load />

    <!-- Portfolio Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projectsWithImages.map((project) => (
        <div data-project-category={project.data.category}>
          <ProjectCard
            title={project.data.title}
            slug={project.slug}
            category={project.data.category}
            featuredImage={project.image}
            location={project.data.location}
          />
        </div>
      ))}
    </div>

    {/* Show message if no projects found */}
    {projectsWithImages.length === 0 && (
      <div class="text-center py-12">
        <p class="text-gray-600 text-lg">
          More projects coming soon! Check back later to see our latest work.
        </p>
      </div>
    )}
  </SectionWrapper>

  <ContactUs />

</BaseLayout>
