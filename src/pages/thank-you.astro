---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
import Check from '../components/icons/Check.astro';
import Phone from '../components/icons/Phone.astro';
import { companyInfo } from '../content/shared.ts';
import { seoMetadata } from '../content/seo-metadata.ts';
---

<BaseLayout
  title={seoMetadata.thankYou.title}
  description={seoMetadata.thankYou.description}
  keywords={seoMetadata.thankYou.keywords}
  ogImage={seoMetadata.thankYou.ogImage}
>
  <SectionWrapper theme="dark" id="thank-you">
    <div class="max-w-3xl mx-auto text-center py-16">
      <!-- Success Icon -->
      <div class="w-20 h-20 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-8">
        <Check class="w-10 h-10 text-green-400" />
      </div>

      <!-- Main Message -->
      <SectionHeader
        tag="Success"
        title="Thank You for Your Message!"
        description="We've received your inquiry and will get back to you within 24 hours. Our team is excited to help bring your cabinetry vision to life."
        layout="center"
        theme="dark"
      />

      <!-- What Happens Next -->
      <div class="gradient-card-dark-strong backdrop-blur-sm border border-brand-primary/20 rounded-2xl p-8 mb-8">
        <h3 class="text-xl font-semibold text-brand-primary mb-6">What Happens Next?</h3>
        <div class="grid md:grid-cols-3 gap-6 text-left">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-brand-primary/20 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
              <span class="text-brand-primary font-semibold text-sm">1</span>
            </div>
            <div>
              <h4 class="font-semibold text-brand-primary mb-1">Review</h4>
              <p class="text-sm text-white/70">Our team reviews your project details and requirements</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-brand-primary/20 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
              <span class="text-brand-primary font-semibold text-sm">2</span>
            </div>
            <div>
              <h4 class="font-semibold text-brand-primary mb-1">Contact</h4>
              <p class="text-sm text-white/70">We'll call or email you within {companyInfo.timelines.emailResponse}</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-brand-primary/20 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
              <span class="text-brand-primary font-semibold text-sm">3</span>
            </div>
            <div>
              <h4 class="font-semibold text-brand-primary mb-1">Consultation</h4>
              <p class="text-sm text-white/70">Schedule your free in-home consultation</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Call to Action -->
      <div class="space-y-4">
        <p class="text-white/70 mb-6">
          Need immediate assistance? Don't hesitate to call us directly.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button
            href={companyInfo.contact.phone.href}
            variant="primary"
            size="lg"
            class="flex items-center gap-2"
          >
            <Phone class="w-5 h-5" />
            Call {companyInfo.contact.phone.display}
          </Button>

          <Button
            href="/"
            variant="ghost"
            size="lg"
          >
            Return to Home
          </Button>
        </div>
      </div>

      <!-- Additional Information -->
      <div class="mt-12 p-6 gradient-card-dark border border-brand-primary/20 rounded-xl">
        <h4 class="font-semibold text-brand-primary mb-3">While You Wait</h4>
        <div class="grid md:grid-cols-2 gap-4 text-sm text-white/70">
          <div>
            <p class="mb-2">📱 <strong class="text-white">Follow our progress:</strong> Check out recent projects on our social media</p>
            <p>📍 <strong class="text-white">Visit our showroom:</strong> {companyInfo.location.address.display}</p>
          </div>
          <div>
            <p class="mb-2">⏰ <strong class="text-white">Business hours:</strong> {companyInfo.hours.display.weekdays}</p>
            <p>📧 <strong class="text-white">Email:</strong> {companyInfo.contact.email.address}</p>
          </div>
        </div>
      </div>
    </div>
  </SectionWrapper>
</BaseLayout>