---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustHeader from '../../components/TrustHeader.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import { blogArticles } from '../../content/blog/blogConfig';
import { seoMetadata } from '../../content/seo-metadata';
import { generateBreadcrumbs } from '../../content/structured-data';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Resources' }
];

// Generate breadcrumb schema
const breadcrumbSchema = generateBreadcrumbs([
  { name: 'Home', url: '/' },
  { name: 'Resources' }
]);
---

<BaseLayout
  title={seoMetadata.resourcesHub.title}
  description={seoMetadata.resourcesHub.description}
  keywords={seoMetadata.resourcesHub.keywords}
  ogImage={seoMetadata.resourcesHub.ogImage}
  canonicalURL="https://boscocabinetry.com/resources"
>
  <!-- Discrete Resources Page - SEO-focused, minimal consumer visibility -->

  <!-- Trust Header (DRY - reused from About page pattern) -->
  <TrustHeader
    title="Resources & Trade Guides"
    subtitle="Expert insights for trade professionals and contractors"
    breadcrumbs={breadcrumbs}
  />

  <!-- Articles Section -->
  <section class="relative isolate bg-white py-20">
    <div class="mx-auto max-w-7xl px-6">
      <!-- Section Header -->
      <div class="max-w-3xl mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Trade & Professional Resources
        </h2>
        <p class="text-lg text-gray-600">
          Educational content designed for contractors, designers, and trade professionals
          looking to understand the custom cabinetry industry and sourcing options.
        </p>
      </div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {blogArticles.map(article => (
          <BlogCard
            title={article.title}
            description={article.description}
            category={article.category}
            publishDate={article.publishDate}
            slug={article.slug}
            featured={article.featured}
          />
        ))}
      </div>

      <!-- Empty State (if needed in future) -->
      {blogArticles.length === 0 && (
        <div class="text-center py-12">
          <p class="text-gray-600">No articles available yet. Check back soon!</p>
        </div>
      )}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="relative isolate bg-brand-charcoal py-20">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h2 class="text-3xl font-bold text-white mb-6">
        Ready to Work With a Local Expert?
      </h2>
      <p class="text-lg text-white/80 mb-8">
        Skip the complexity of direct import. Partner with Bosco Cabinetry for
        quality, reliability, and local support.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://tidycal.com/boscocabinetry/30-minute-meeting"
          class="inline-flex items-center justify-center px-8 py-4 bg-brand-accent text-brand-primary font-bold rounded-lg hover:bg-brand-accent/90 transition-colors"
        >
          Schedule Consultation
        </a>
        <a
          href="/trade"
          class="inline-flex items-center justify-center px-8 py-4 bg-transparent border-2 border-white text-white font-bold rounded-lg hover:bg-white/10 transition-colors"
        >
          Explore Trade Program
        </a>
      </div>
    </div>
  </section>

  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- CollectionPage Schema for Resources Index -->
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Resources & Trade Guides",
      "description": "Expert guides and resources for trade professionals on custom cabinetry sourcing and industry best practices.",
      "url": "https://boscocabinetry.com/resources",
      "publisher": {
        "@type": "Organization",
        "name": "Bosco Cabinetry"
      },
      "hasPart": {blogArticles.map(article => ({
        "@type": "Article",
        "headline": article.title,
        "description": article.description,
        "url": `https://boscocabinetry.com/resources/${article.slug}`,
        "datePublished": article.publishDate,
        "author": {
          "@type": "Organization",
          "name": article.author
        }
      }))}
    }
  </script>
</BaseLayout>
