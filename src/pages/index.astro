---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import WhyBosco from '../components/WhyBosco.astro';
import Reviews from '../components/Reviews.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import ShowroomHighlight from '../components/ShowroomHighlight.astro';
import ServiceAreaCallout from '../components/ServiceAreaCallout.astro';
import ProcessSection from '../components/ProcessSection.astro';
import FAQSection from '../components/FAQSection.astro';
import DesignInspiration from '../components/DesignInspiration.astro';
import ContactUs from '../components/ContactUs.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Custom Cabinetry Toronto | Kitchen, Closets & Built-ins | Bosco Cabinetry"
  description="Transform your Toronto home with custom kitchens, closets, built-ins & decorative paneling. 20+ years experience, 100+ finishes, luxury quality at affordable prices. Free consultation & 3D design in our 5,500 sq ft North York showroom."
  ogImage="/media/og-image-homepage.jpg"
>
	<!-- Hero (dark) -->
	<Hero />
	<!-- Services Snapshot (light) -->
	<Services />
	<!-- Single Review with Project (dark) -->
	<ProjectShowcase />
	<!-- Why Choose Bosco (light) -->
	<WhyBosco />
	<!-- Featured Project (dark) -->
	<FeaturedProject />
	<!-- Gallery Teaser (light) -->
	<ProjectGallery />
	<!-- Virtual Showroom Tour (dark) -->
	<ShowroomHighlight />
	<!-- Service Area Callout (light) -->
	<ServiceAreaCallout />
	<!-- Process Section (dark) -->
	<ProcessSection />
	<!-- FAQ Section (light) -->
	<FAQSection />
	<!-- Multiple Reviews (dark) -->
	<Reviews />
	<!-- Lead Magnet (light) -->
	<DesignInspiration />
	<!-- Conversion Contact (dark) -->
	<ContactUs />
	<!-- Footer (dark) -->
	<Footer />
</BaseLayout>