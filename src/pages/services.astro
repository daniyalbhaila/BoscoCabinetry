---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { companyInfo } from '../content/shared';
import { seoMetadata } from '../content/seo-metadata';

// Service descriptions for each type
const serviceDescriptions: Record<string, string> = {
  'kitchen-cabinets': 'Custom kitchen cabinets designed and installed in Toronto. 100+ premium finishes, professional installation, flexible timelines.',
  'custom-closets': 'Walk-in closets, reach-in systems, and mudroom organization. Transform your storage with custom closet solutions.',
  'built-ins': 'Entertainment centers, bookshelves, home offices, and custom storage. Built-in cabinetry for every room.',
  'full-home-cabinetry': 'Complete home cabinetry solutions with coordinated design throughout your entire property.'
};
---

<BaseLayout
  title={seoMetadata.servicesHub.title}
  description={seoMetadata.servicesHub.description}
  keywords={seoMetadata.servicesHub.keywords}
  ogImage={seoMetadata.servicesHub.ogImage}
>
  <!-- Services Directory -->
  <SectionWrapper theme="dark" id="services-directory">
    <SectionHeader
      tag="Our Services"
      title="Custom Cabinetry Solutions"
      description="Explore our specialized cabinetry services. Each service includes professional design, premium materials, and expert installation."
      layout="center"
      theme="dark"
    />

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 mt-12">
      {companyInfo.projectTypes
        .filter(service => service.value !== 'other' && service.value !== 'multiple-projects')
        .map((service) => (
        <a
          href={`/services/${service.value}`}
          class="group block rounded-2xl border border-white/20 bg-white/5 backdrop-blur-sm p-8 transition-all duration-300 hover:border-brand-accent hover:bg-white/10"
        >
          <h3 class="mb-4 text-2xl font-semibold text-white group-hover:text-brand-accent transition-colors">
            {service.label}
          </h3>
          <p class="mb-6 text-white/75 leading-relaxed">
            {serviceDescriptions[service.value]}
          </p>
          <span class="inline-flex items-center gap-2 text-brand-accent font-medium group-hover:gap-3 transition-all">
            Learn More
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </SectionWrapper>

  <!-- Quick Contact CTA -->
  <SectionWrapper theme="light" id="contact-cta">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-3xl font-semibold text-brand-charcoal mb-4 md:text-4xl">
        Ready to Get Started?
      </h2>
      <p class="text-brand-darkGray mb-8 text-lg">
        Book a free consultation to discuss your project. We'll visit your space, understand your needs, and create a custom solution that fits your vision and budget.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href={companyInfo.urls.bookConsultation}
          class="inline-flex items-center justify-center rounded-full bg-brand-primary px-8 py-3 text-white font-medium transition-all hover:bg-brand-primary/90 hover:scale-105"
        >
          Book Free Consultation
        </a>
        <a
          href={`tel:${companyInfo.contact.phone.number}`}
          class="inline-flex items-center justify-center rounded-full border-2 border-brand-primary px-8 py-3 text-brand-primary font-medium transition-all hover:bg-brand-primary hover:text-white"
        >
          {companyInfo.contact.phone.display}
        </a>
      </div>
    </div>
  </SectionWrapper>
</BaseLayout>
