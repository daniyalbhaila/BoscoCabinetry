---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContentGrid from '../components/ContentGrid.astro';
import ProcessSection from '../components/ProcessSection.astro';
import ContactUs from '../components/ContactUs.astro';
import { companyInfo, companyDescriptions } from '../content/shared';

const servicesData = companyInfo.projectTypes.map(service => ({
  title: service.label,
  description: getServiceDescription(service.value),
  href: `/services/${service.value.replace('_', '-')}`,
  icon: getServiceIcon(service.value)
}));

function getServiceDescription(serviceType: string): string {
  const descriptions: Record<string, string> = {
    kitchen: 'Custom kitchen cabinets designed to maximize storage and style. From modern minimalist to traditional warmth.',
    closet: 'Organized closet systems that transform your storage. Custom shelving, drawers, and hanging solutions.',
    bathroom: 'Beautiful bathroom vanities that combine function and elegance. Custom sizing for any space.',
    builtin: 'Built-in storage solutions for any room. Entertainment centers, bookcases, and office units.',
    other: 'Custom millwork and specialty projects. Let us bring your unique vision to life.'
  };
  return descriptions[serviceType] || 'Custom cabinetry solutions tailored to your needs.';
}

function getServiceIcon(serviceType: string): string {
  const icons: Record<string, string> = {
    kitchen: 'kitchen-icon',
    closet: 'closet-icon',
    bathroom: 'bathroom-icon',
    builtin: 'builtin-icon',
    other: 'custom-icon'
  };
  return icons[serviceType] || 'service-icon';
}
---

<BaseLayout title="Services - Bosco Cabinetry" description="Custom kitchen cabinets, closet systems, bathroom vanities, and built-in units. Expert craftsmanship with 20+ years experience in Toronto area.">

  <Hero
    title="Custom Cabinetry Services"
    subtitle="From kitchen cabinets to complete home storage solutions. Explore our full range of custom cabinetry services designed to transform your space."
    backgroundImage="/images/services-hero.jpg"
    theme="dark"
    size="large"
    showCTA={true}
    ctaText="Get Free Consultation"
    ctaHref="/contact"
  />

  <SectionWrapper theme="light" id="our-services">
    <SectionHeader
      tag="Our Services"
      title="Complete Custom Cabinetry Solutions"
      description="Whether you're renovating your kitchen, organizing your closets, or adding built-in storage, we have the expertise to bring your vision to life."
      layout="center"
      theme="light"
    />

    <ContentGrid
      items={servicesData}
      variant="services"
      columns={2}
      gap="large"
    />
  </SectionWrapper>

  <SectionWrapper theme="dark" id="why-choose-us">
    <SectionHeader
      tag="Why Choose Bosco"
      title="20+ Years of Excellence"
      description="Experience the difference that comes with expert craftsmanship, premium materials, and personalized service."
      layout="center"
      theme="dark"
    />

    <ContentGrid
      items={[
        {
          title: "Expert Craftsmanship",
          description: "Over 20 years of experience creating beautiful, functional cabinetry."
        },
        {
          title: "Premium Materials",
          description: "We use only the finest materials and hardware for lasting quality."
        },
        {
          title: "Custom Solutions",
          description: "Every project is tailored to your specific needs and space requirements."
        },
        {
          title: "Full Service",
          description: "From design consultation to installation, we handle every step."
        }
      ]}
      variant="features"
      columns={2}
    />
  </SectionWrapper>

  <ProcessSection />

  <SectionWrapper theme="light" id="service-areas">
    <SectionHeader
      tag="Service Areas"
      title="Serving Greater Toronto Area"
      description="We provide custom cabinetry services throughout the GTA and surrounding regions."
      layout="center"
      theme="light"
    />

    <ContentGrid
      items={companyInfo.serviceAreas.map(area => ({
        title: area.city,
        description: `Custom cabinetry services in ${area.city}, ${area.region}`,
        href: `/locations/${area.city.toLowerCase().replace(/\s+/g, '-')}`
      }))}
      variant="locations"
      columns={4}
    />
  </SectionWrapper>

  <ContactUs />

</BaseLayout>