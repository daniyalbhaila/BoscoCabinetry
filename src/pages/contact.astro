---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContactUs from '../components/ContactUs.astro';
import KitchenImage from '../assets/kitchen.jpg';
import { companyInfo } from '../content/shared';
import { seoMetadata } from '../content/seo-metadata';

const contactMethods = [
  {
    title: "Phone Consultation",
    description: "Speak directly with our team to discuss your project needs and schedule an appointment.",
    action: "Call Now",
    href: companyInfo.contact.phone.href,
    icon: "phone"
  },
  {
    title: "Email Inquiry",
    description: "Send us details about your project and we'll respond within 24 hours.",
    action: "Send Email",
    href: companyInfo.contact.email.href,
    icon: "email"
  },
  {
    title: "Showroom Visit",
    description: "See our craftsmanship in person at our 5,500 sq ft North York showroom.",
    action: "Schedule Visit",
    href: "/showroom-visit",
    icon: "showroom"
  },
  {
    title: "Free Quote",
    description: "Get a detailed quote for your custom cabinetry project with no obligation.",
    action: "Get Quote",
    href: "/quote",
    icon: "quote"
  }
];

const faqs = [
  {
    question: "How long does a typical project take?",
    answer: "Most projects take 2-4 weeks to 10-12 weeks from approval to installation, depending on project complexity and customization requirements."
  },
  {
    question: "Do you provide free consultations?",
    answer: "Yes! We offer free in-home consultations where we'll assess your space, discuss your needs, and provide initial design concepts and pricing."
  },
  {
    question: "What areas do you serve?",
    answer: "We serve the Greater Toronto Area including Toronto, North York, Scarborough, Etobicoke, Vaughan, Richmond Hill, Markham, and Mississauga."
  },
  {
    question: "Can I see examples of your work?",
    answer: "Absolutely! Visit our 5,500 sq ft showroom in North York to see full displays of kitchens, closets, and bathroom vanities, or browse our online portfolio."
  }
];
---

<BaseLayout
  title={seoMetadata.contact.title}
  description={seoMetadata.contact.description}
  keywords={seoMetadata.contact.keywords}
  ogImage={seoMetadata.contact.ogImage}
>

  <Hero
    title="Get Your Free Consultation"
    subtitle="Ready to transform your space with custom cabinetry? Contact our team today to discuss your project and schedule your free consultation."
    backgroundImage={KitchenImage}
    theme="dark"
    size="medium"
    showCTA={false}
  />

  <SectionWrapper theme="light" id="contact-methods">
    <SectionHeader
      tag="Get In Touch"
      title="Multiple Ways to Connect"
      description="Choose the contact method that works best for you. We're here to help bring your vision to life."
      layout="center"
      theme="light"
    />

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {contactMethods.map((method) => (
        <div class="text-center p-6 border border-brand-accent/30 rounded-xl hover:border-brand-primary/50 transition-all duration-300 hover:shadow-lg">
          <div class="w-12 h-12 bg-brand-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <div class="w-6 h-6 bg-brand-primary rounded-full"></div>
          </div>
          <h3 class="text-lg font-semibold text-brand-primary mb-2">{method.title}</h3>
          <p class="text-gray-600 mb-4 text-sm">{method.description}</p>
          <a
            href={method.href}
            class="inline-block bg-brand-primary text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-brand-primary/90 transition-colors"
          >
            {method.action}
          </a>
        </div>
      ))}
    </div>
  </SectionWrapper>

  <ContactUs />

  <SectionWrapper theme="light" id="business-info">
    <div class="max-w-4xl mx-auto">
      <SectionHeader
        tag="Visit Our Showroom"
        title="See Our Craftsmanship in Person"
        description="Experience the quality of our work at our expansive North York showroom."
        layout="center"
        theme="light"
      />

      <div class="grid md:grid-cols-2 gap-8">
        <div class="space-y-6">
          <div>
            <h3 class="text-lg font-semibold text-brand-primary mb-2">Location</h3>
            <p class="text-gray-700" set:html={companyInfo.location.address.display}></p>
          </div>

          <div>
            <h3 class="text-lg font-semibold text-brand-primary mb-2">Business Hours</h3>
            <div class="space-y-1">
              <p class="text-gray-700">{companyInfo.hours.display.weekdays}</p>
              <p class="text-gray-700">{companyInfo.hours.display.saturday}</p>
              <p class="text-gray-700">{companyInfo.hours.display.sunday}</p>
            </div>
          </div>

          <div>
            <h3 class="text-lg font-semibold text-brand-primary mb-2">Contact Information</h3>
            <div class="space-y-2">
              <p class="text-gray-700">
                <strong>Phone:</strong>
                <a href={companyInfo.contact.phone.href} class="text-brand-primary hover:underline ml-1">
                  {companyInfo.contact.phone.display}
                </a>
              </p>
              <p class="text-gray-700">
                <strong>Email:</strong>
                <a href={companyInfo.contact.email.href} class="text-brand-primary hover:underline ml-1">
                  {companyInfo.contact.email.address}
                </a>
              </p>
            </div>
          </div>
        </div>

        <div class="bg-brand-accent/20 p-6 rounded-2xl">
          <h3 class="text-xl font-semibold text-brand-primary mb-4">What to Expect</h3>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-start">
              <div class="w-5 h-5 bg-brand-primary/20 rounded-full mt-0.5 mr-3 flex-shrink-0"></div>
              <span>Tour our 5,500 sq ft showroom with full displays</span>
            </li>
            <li class="flex items-start">
              <div class="w-5 h-5 bg-brand-primary/20 rounded-full mt-0.5 mr-3 flex-shrink-0"></div>
              <span>See and touch over 100 different finishes</span>
            </li>
            <li class="flex items-start">
              <div class="w-5 h-5 bg-brand-primary/20 rounded-full mt-0.5 mr-3 flex-shrink-0"></div>
              <span>Meet with our experienced design team</span>
            </li>
            <li class="flex items-start">
              <div class="w-5 h-5 bg-brand-primary/20 rounded-full mt-0.5 mr-3 flex-shrink-0"></div>
              <span>Discuss your project and get initial pricing</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </SectionWrapper>

  <SectionWrapper theme="light" id="service-areas-contact">
    <SectionHeader
      tag="Service Areas"
      title="Serving Greater Toronto Area"
      description="We provide custom cabinetry services throughout these areas and surrounding regions."
      layout="center"
      theme="light"
    />

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
      {companyInfo.serviceAreas.map((area) => (
        <div class="text-center p-3 border border-brand-accent/20 rounded-lg">
          <h3 class="font-medium text-brand-primary">{area.city}</h3>
          <p class="text-sm text-gray-600">{area.region}</p>
        </div>
      ))}
    </div>
  </SectionWrapper>

  <SectionWrapper theme="dark" id="contact-faq">
    <SectionHeader
      tag="Frequently Asked"
      title="Common Questions"
      description="Get quick answers to the most common questions about our services and process."
      layout="center"
      theme="dark"
    />

    <div class="max-w-3xl mx-auto space-y-6">
      {faqs.map((faq) => (
        <div class="bg-white/5 border border-white/10 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-white mb-3">{faq.question}</h3>
          <p class="text-gray-300">{faq.answer}</p>
        </div>
      ))}
    </div>

    <div class="text-center mt-8">
      <p class="text-gray-300 mb-4">Have more questions?</p>
      <a
        href={companyInfo.contact.phone.href}
        class="inline-block bg-brand-primary text-white px-8 py-3 rounded-lg font-semibold hover:bg-brand-primary/90 transition-colors"
      >
        Call {companyInfo.contact.phone.display}
      </a>
    </div>
  </SectionWrapper>

</BaseLayout>
