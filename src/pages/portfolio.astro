---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ContactUs from '../components/ContactUs.astro';
import { companyInfo } from '../content/shared';

const portfolioCategories = [
  {
    title: "Kitchen Cabinets",
    description: "Custom kitchen cabinetry projects showcasing various styles and finishes",
    image: "/images/portfolio/kitchen-category.jpg",
    href: "/portfolio/kitchens"
  },
  {
    title: "Closet Systems",
    description: "Organized closet solutions maximizing storage and functionality",
    image: "/images/portfolio/closet-category.jpg",
    href: "/portfolio/closets"
  },
  {
    title: "Bathroom Vanities",
    description: "Elegant bathroom storage solutions combining style and utility",
    image: "/images/portfolio/bathroom-category.jpg",
    href: "/portfolio/bathrooms"
  },
  {
    title: "Built-in Units",
    description: "Custom built-in storage for entertainment, office, and living spaces",
    image: "/images/portfolio/builtin-category.jpg",
    href: "/portfolio/built-ins"
  }
];
---

<BaseLayout title="Portfolio - Bosco Cabinetry" description="View our portfolio of custom kitchen cabinets, closet systems, bathroom vanities, and built-in units. See examples of our craftsmanship throughout the GTA.">

  <Hero
    title="Our Portfolio"
    subtitle="Explore our collection of custom cabinetry projects. From modern kitchens to organized closets, see how we transform spaces with quality craftsmanship and thoughtful design."
    backgroundImage="/images/portfolio-hero.jpg"
    theme="dark"
    size="large"
    showCTA={true}
    ctaText="Start Your Project"
    ctaHref="/contact"
  />

  <SectionWrapper theme="light" id="portfolio-categories">
    <SectionHeader
      tag="Browse By Category"
      title="Custom Cabinetry Projects"
      description="Browse our portfolio by project type to see examples of our work and get inspiration for your own space."
      layout="center"
      theme="light"
    />

    <div class="grid md:grid-cols-2 gap-8">
      {portfolioCategories.map((category) => (
        <div class="group cursor-pointer">
          <a href={category.href} class="block">
            <div class="relative overflow-hidden rounded-2xl mb-4">
              <img
                src={category.image}
                alt={category.title}
                class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-black/30 group-hover:bg-black/20 transition-colors duration-300"></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <h3 class="text-white text-2xl font-bold text-center">{category.title}</h3>
              </div>
            </div>
            <p class="text-gray-600 text-center">{category.description}</p>
          </a>
        </div>
      ))}
    </div>
  </SectionWrapper>

  <FeaturedProject />

  <SectionWrapper theme="light" id="recent-projects">
    <SectionHeader
      tag="Recent Work"
      title="Latest Projects"
      description="Take a look at some of our most recent custom cabinetry installations across the Greater Toronto Area."
      layout="center"
      theme="light"
    />

    <ProjectGallery />
  </SectionWrapper>

  <SectionWrapper theme="dark" id="project-process">
    <SectionHeader
      tag="Our Process"
      title="From Concept to Completion"
      description="See how we bring your vision to life with our proven project process."
      layout="center"
      theme="dark"
    />

    <div class="grid md:grid-cols-3 gap-8">
      <div class="text-center">
        <div class="w-16 h-16 bg-brand-accent rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="text-2xl font-bold text-brand-primary">1</span>
        </div>
        <h3 class="text-xl font-semibold text-white mb-2">Design Consultation</h3>
        <p class="text-gray-300">Meet with our design team to discuss your vision, needs, and budget.</p>
      </div>

      <div class="text-center">
        <div class="w-16 h-16 bg-brand-accent rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="text-2xl font-bold text-brand-primary">2</span>
        </div>
        <h3 class="text-xl font-semibold text-white mb-2">3D Design & Approval</h3>
        <p class="text-gray-300">Review detailed 3D renderings and make adjustments before production begins.</p>
      </div>

      <div class="text-center">
        <div class="w-16 h-16 bg-brand-accent rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="text-2xl font-bold text-brand-primary">3</span>
        </div>
        <h3 class="text-xl font-semibold text-white mb-2">Manufacturing & Install</h3>
        <p class="text-gray-300">Expert craftsmanship in our shop, followed by professional installation.</p>
      </div>
    </div>

    <div class="text-center mt-8">
      <a
        href="/process"
        class="inline-block bg-brand-primary text-white px-8 py-3 rounded-lg font-semibold hover:bg-brand-primary/90 transition-colors"
      >
        Learn About Our Process
      </a>
    </div>
  </SectionWrapper>

  <SectionWrapper theme="light" id="service-areas-portfolio">
    <SectionHeader
      tag="Service Areas"
      title="Projects Across the GTA"
      description="We've completed custom cabinetry projects throughout the Greater Toronto Area and surrounding regions."
      layout="center"
      theme="light"
    />

    <div class="grid md:grid-cols-4 gap-6">
      {companyInfo.serviceAreas.map((area) => (
        <div class="text-center p-4 border border-brand-accent/30 rounded-lg hover:border-brand-primary/50 transition-colors">
          <h3 class="font-semibold text-brand-primary mb-1">{area.city}</h3>
          <p class="text-sm text-gray-600">{area.region}</p>
          <a
            href={`/locations/${area.city.toLowerCase().replace(/\s+/g, '-')}`}
            class="text-brand-primary text-sm hover:underline mt-2 inline-block"
          >
            View Projects
          </a>
        </div>
      ))}
    </div>
  </SectionWrapper>

  <ContactUs />

</BaseLayout>