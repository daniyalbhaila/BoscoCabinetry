---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import logoPreload from '../assets/Logo-Light.svg?url';
import heroPoster from '../assets/hero-poster.png';
const {
  title = 'Custom Cabinetry Toronto | Kitchen, Closets & Built-ins | Bosco Cabinetry',
  description = 'Transform your Toronto home with custom kitchens, closets, built-ins & decorative paneling. 100+ completed projects, 100+ finishes, luxury quality at affordable prices. Free consultation & professional design.',
  ogImage = '/media/og-image.jpg',
  canonicalURL = Astro.url.href,
  keywords = 'custom cabinetry Toronto, kitchen cabinets Toronto, closet systems North York, built-in units GTA, decorative paneling, luxury kitchen design, affordable custom cabinetry'
} = Astro.props;

// Resolve OG image against the current request origin (falls back to Astro.site)
const ogImageBase = Astro.url ?? Astro.site ?? null;
const absoluteOgImage = ogImageBase ? new URL(ogImage, ogImageBase).href : ogImage;
const heroPosterUrl = typeof heroPoster === 'string' ? heroPoster : heroPoster.src;
---
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Bosco Cabinetry" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts - Poppins (normal + italic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=optional" rel="stylesheet" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="3840" />
    <meta property="og:image:height" content="2560" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Bosco Cabinetry Showroom - Custom Kitchen Cabinets Toronto" />
    <meta property="og:site_name" content="Bosco Cabinetry" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={absoluteOgImage} />
    <meta property="twitter:image:alt" content="Bosco Cabinetry Showroom - Custom Kitchen Cabinets Toronto" />

    <!-- Critical resource preloads -->
    <link rel="preload" href={logoPreload} as="image" type="image/svg+xml" />
    <link rel="preload" href={heroPosterUrl} as="image" />

    <!-- Performance optimization -->
    <meta name="theme-color" content="#60533C" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GQTH54CJ0C"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-GQTH54CJ0C');
    </script>

    <!-- Structured Data (JSON-LD) for SEO -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Bosco Cabinetry",
        "description": "Custom kitchen cabinets, closets, and built-ins serving Toronto and the Greater Toronto Area",
        "url": "https://boscocabinetry.ca",
        "telephone": "(416) 123-4567",
        "email": "info@boscocabinetry.ca",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "123 Industrial Road",
          "addressLocality": "North York",
          "addressRegion": "ON",
          "postalCode": "M3J 2K9",
          "addressCountry": "CA"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 43.7615,
          "longitude": -79.4166
        },
        "openingHours": [
          "Mo-Fr 08:00-18:00",
          "Sa 09:00-16:00"
        ],
        "priceRange": "$$",
        "servesCuisine": "Kitchen Design",
        "serviceArea": {
          "@type": "GeoCircle",
          "geoMidpoint": {
            "@type": "GeoCoordinates",
            "latitude": 43.7615,
            "longitude": -79.4166
          },
          "geoRadius": "50000"
        },
        "areaServed": [
          "Toronto",
          "North York",
          "Mississauga",
          "Markham",
          "Richmond Hill",
          "Vaughan",
          "Oakville",
          "Burlington",
          "Brampton",
          "Etobicoke",
          "Scarborough",
          "Pickering"
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Custom Cabinetry Services",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Custom Kitchen Cabinets",
                "description": "Luxury custom kitchen cabinets with European hardware and premium finishes"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Closet Organization Systems",
                "description": "Walk-in and reach-in closet systems with smart storage solutions"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Built-in Units",
                "description": "Custom built-in entertainment centers, bookcases, and storage solutions"
              }
            }
          ]
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.9",
          "reviewCount": "200",
          "bestRating": "5"
        },
        "founder": {
          "@type": "Person",
          "name": "Bosco Cabinetry Team"
        },
        "foundingDate": "2003",
        "sameAs": [
          "https://www.google.com/search?q=bosco+cabinetry+reviews"
        ]
      }
    </script>

  </head>
  <body class="min-h-full bg-brand-charcoal text-white antialiased font-sans overflow-x-hidden">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        if (!root.classList.contains('js-enabled')) {
          root.classList.add('js-enabled');
        }

        const SELECTOR = '[data-animate-on-scroll]';
        let observer;
        let observedElements = new WeakSet();
        let itemMap = new WeakMap();
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        const ensureItems = (element) => {
          let items = itemMap.get(element);
          if (items) {
            return items;
          }

          if (!element.hasAttribute('data-animate-stagger')) {
            items = [];
            itemMap.set(element, items);
            return items;
          }

          const targetSelector = element.getAttribute('data-animate-target');
          const rawStep = element.getAttribute('data-animate-stagger');
          const parsed = rawStep && rawStep.trim() !== '' ? parseInt(rawStep, 10) : Number.NaN;
          const delayStep = Number.isNaN(parsed) ? 80 : Math.max(0, parsed);
          const candidates = targetSelector
            ? Array.from(element.querySelectorAll(targetSelector))
            : Array.from(element.children);

          candidates.forEach((item, index) => {
            item.setAttribute('data-animate-item', '');
            item.style.setProperty('--scroll-animate-delay', String(index * delayStep));
          });

          itemMap.set(element, candidates);
          return candidates;
        };

        const handleEntries = (entries) => {
          entries.forEach((entry) => {
            const element = entry.target;
            const items = itemMap.get(element) ?? ensureItems(element);
            const repeat = element.getAttribute('data-animate-repeat') === 'true';

            if (entry.isIntersecting) {
              element.classList.add('is-visible');
              items.forEach((item) => item.classList.add('is-visible'));
              if (!repeat && observer) {
                observer.unobserve(element);
              }
            } else if (repeat) {
              element.classList.remove('is-visible');
              items.forEach((item) => item.classList.remove('is-visible'));
            }
          });
        };

        const ensureObserver = () => {
          if (!observer) {
            observer = new IntersectionObserver(handleEntries, {
              threshold: 0.12,
              rootMargin: '0px 0px -10% 0px'
            });
          }
          return observer;
        };

        const initElement = (element) => {
          if (observedElements.has(element)) {
            return;
          }

          observedElements.add(element);
          const items = ensureItems(element);

          if (prefersReducedMotion.matches) {
            element.classList.add('is-visible');
            items.forEach((item) => item.classList.add('is-visible'));
            return;
          }

          ensureObserver().observe(element);
        };

        const init = (scope = document) => {
          const elements = scope.querySelectorAll(SELECTOR);
          if (!elements.length) {
            return;
          }
          elements.forEach((element) => initElement(element));
        };

        const scheduleInit = (scope) => {
          const target = scope ?? document;
          requestAnimationFrame(() => init(target));
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => scheduleInit(), { once: true });
        } else {
          scheduleInit();
        }

        document.addEventListener('astro:page-load', (event) => {
          const scope = event.target && typeof event.target.querySelectorAll === 'function' ? event.target : document;
          scheduleInit(scope);
        });

        document.addEventListener('astro:after-swap', (event) => {
          const scope = event.target && typeof event.target.querySelectorAll === 'function' ? event.target : document;
          scheduleInit(scope);
        });

        prefersReducedMotion.addEventListener('change', () => {
          if (observer) {
            observer.disconnect();
          }
          observer = undefined;
          observedElements = new WeakSet();
          itemMap = new WeakMap();
          scheduleInit();
        });
      })();
    </script>
  </body>
</html>
