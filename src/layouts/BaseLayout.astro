---
import '../styles/global.css';
import Header from '../components/Header.astro';
const { title = 'Bosco Cabinetry' } = Astro.props;
---
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />

    <!-- Critical resource preloads for hero section -->
    <link rel="preload" href="/media/hero-poster.png" as="image" fetchpriority="high" />
    <link rel="preload" href="/media/hero.mp4" as="video" type="video/mp4" />

    <!-- Performance optimization -->
    <meta name="theme-color" content="#60533C" />

    <!-- Font optimization -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- replace preload+noscript with a single stylesheet link -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&display=optional"
      rel="stylesheet"
    />
  </head>
  <body class="h-full bg-brand-charcoal text-white antialiased font-sans">
    <Header />
    <main>
      <slot />
    </main>
  </body>
</html>
