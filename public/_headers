/*
  # Security Headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

  # Content Security Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.youtube.com https://static.kuula.io https://kuula.co https://www.googletagmanager.com https://static.doubleclick.net https://*.hs-scripts.com https://*.hs-analytics.net https://*.hs-banner.com https://*.hscollectedforms.net https://*.hsadspixel.net https://connect.facebook.net https://*.facebook.com https://*.facebook.net https://*.msgsndr.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' https:; frame-src 'self' https://www.youtube.com https://kuula.co https://*.leadconnectorhq.com; object-src 'none'; base-uri 'self';

  # Permissions Policy (fixes Kuula console errors)
  Permissions-Policy: accelerometer=(self "https://kuula.co"), xr-spatial-tracking=(self "https://kuula.co"), gyroscope=(self "https://kuula.co"), magnetometer=(self "https://kuula.co")

  # Cache Control
  Cache-Control: public, max-age=31536000, immutable

# Static Assets - Long Cache
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.mp4
  Cache-Control: public, max-age=2592000

# HTML - Short Cache
/*.html
  Cache-Control: public, max-age=3600
